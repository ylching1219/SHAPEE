@section Scripts {
    <script>
        // Simple demo: toggle reveal / hide attendance code
        (function () {
            const input = document.getElementById('attendanceCodeInput');
            const revealBtn = document.getElementById('revealBtn');
            const generateBtn = document.getElementById('generateBtn');

            let realCode = 'A 7 X 9';
            let isRevealed = true;

            function maskCode(code) {
                // basic masking: replace characters with *
                return code.replace(/[A-Za-z0-9]/g, '*');
            }

            function updateDisplay() {
                input.value = isRevealed ? realCode : maskCode(realCode);
                revealBtn.innerHTML = isRevealed
                    ? '<i class="fas fa-eye-slash"></i><span class="d-none d-md-inline"> Hide</span>'
                    : '<i class="fas fa-eye"></i><span class="d-none d-md-inline"> Reveal</span>';
            }

            revealBtn.addEventListener('click', function () {
                isRevealed = !isRevealed;
                updateDisplay();
            });

            generateBtn.addEventListener('click', function () {
                // Simple random demo generator – replace with server-side token generation later
                const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
                realCode = '';
                for (let i = 0; i < 5; i++) {
                    if (i > 0) realCode += ' ';
                    realCode += chars[Math.floor(Math.random() * chars.length)];
                }
                isRevealed = true;
                updateDisplay();
            });

            // Initialize display once
            updateDisplay();
        })();
    </script>
}