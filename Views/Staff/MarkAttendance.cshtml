@using SHAPEE.Models
@model ClassSection

@{
    ViewData["Title"] = "Live Attendance Session";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800">
            Live Attendance: @Model.Course?.Name (@Model.SectionId)
        </h1>
        <p class="text-muted small mt-2">
            @Model.Day, @Model.StartTime.ToString("HH:mm") – @Model.EndTime.ToString("HH:mm") · Room @Model.Room?.Id
        </p>
    </div>
    <div>
        <a href="#" class="btn btn-sm btn-danger shadow-sm" id="stopSessionBtn">
            <i class="fas fa-stop-circle fa-sm text-white-50"></i> End Session
        </a>
    </div>
</div>

<!-- hidden section id for JS -->
<input type="hidden" id="sectionId" value="@Model.SectionId" />

<div class="row g-4 align-items-stretch">
    <!-- LEFT COLUMN: QR SCAN -->
    <div class="col-xl-5 col-lg-5 d-flex">
        <div class="card shadow w-100 h-100 d-flex flex-column">
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <div>
                    <h6 class="m-0 font-weight-bold text-primary">Scan QR Code</h6>
                    <small class="text-muted">Dynamic refresh every 120 seconds.</small>
                </div>
                <div>
                    <button type="button" class="btn btn-sm btn-outline-light text-primary border-0"
                            id="qrFsOpenBtn">
                        <i class="fas fa-expand"></i>
                    </button>
                    <span class="badge badge-success">Live</span>
                </div>
            </div>

            <!-- QR card body -->
            <div class="card-body d-flex flex-column text-center"
                 style="height: calc(100vh - 560px);">
                <div class="qr-container mb-3 d-flex align-items-center justify-content-center bg-light border rounded"
                     style="height:420px;">
                    <img id="qrImage"
                         src="https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=INIT"
                         alt="QR Code"
                         class="img-fluid"
                         style="max-height:220px; width:auto;" />
                </div>

                <div class="mb-1 small font-weight-bold">
                    Token refreshes in:
                    <span class="text-primary" id="timerCount">120</span>s
                </div>

                <div class="progress mb-3" style="height: 6px;">
                    <div class="progress-bar bg-info" id="qrProgressBar" role="progressbar" style="width: 100%"></div>
                </div>

                <div class="alert alert-warning small text-left mb-0">
                    <i class="fas fa-exclamation-triangle"></i>
                    <strong>Suspicious Detection:</strong> System checks for duplicate IPs and reused devices.
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT COLUMN: MANUAL CODE + LIVE SCANS -->
    <div class="col-xl-7 col-lg-7 d-flex flex-column">
        <!-- MANUAL CODE CARD -->
        <div class="card shadow mb-3 border-left-info">
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary">Attendance Code</h6>
                <div>
                    <button type="button" class="btn btn-sm btn-outline-light text-primary border-0"
                            id="codeFsOpenBtn">
                        <i class="fas fa-expand"></i>
                    </button>
                    <span class="badge badge-light text-muted small">For students who cannot scan QR</span>
                </div>
            </div>
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-7 mb-3 mb-md-0">
                        <label class="small font-weight-bold d-block">Current Attendance Code</label>

                        <div class="d-flex align-items-center">
                            <span class="h4 font-weight-bold mr-3" id="manualCode">•••••</span>

                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary mr-2"
                                    id="revealBtn">
                                Reveal
                            </button>

                            <button type="button"
                                    class="btn btn-sm btn-outline-primary"
                                    id="regenCodeBtn">
                                Regenerate
                            </button>
                        </div>
                        <div class="small text-gray-600">
                            <i class="fas fa-info-circle"></i>
                            Code expires when the session ends or after a set time.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- LIVE SCANS TABLE (your existing card) -->
        <div class="card shadow flex-grow-1 d-flex flex-column">
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary">Live Scans</h6>
                <span class="badge badge-secondary" id="joinedCount">2 Joined</span>
            </div>
            <!-- Live Scans card body -->
            <div class="card-body d-flex flex-column"
                 style="height: calc(100vh - 560px);">
                <div class="table-responsive flex-grow-1 overflow-auto">
                    <table class="table table-bordered table-sm mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th style="width: 20%;">Time</th>
                                <th style="width: 40%;">Name</th>
                                <th style="width: 20%;">Method</th>
                                <th style="width: 20%;">Status</th>
                            </tr>
                        </thead>
                        <tbody id="liveScanBody">
                            <tr class="text-muted">
                                <td colspan="4" class="text-center">Waiting for scans...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <small class="text-muted d-block mt-2">
                    New scans will appear here in real time during the session.
                </small>
            </div>
        </div>
    </div>
</div>

<!-- FULLSCREEN QR OVERLAY -->
<div id="qrFullscreen"
     style="position:fixed; inset:0; background:rgba(0,0,0,0.9); z-index:1050; display:none;">
    <div style="width:100%; height:100%; display:flex; flex-direction:column; justify-content:center; align-items:center;">
        <button type="button" class="btn btn-light btn-sm position-absolute"
                style="top:15px; right:15px;"
                id="qrFsCloseBtn">
            <i class="fas fa-times"></i> Close
        </button>
        <img id="qrFullscreenImg" class="img-fluid" style="max-width:80%; max-height:80%;" alt="QR Code" />
        <div class="text-light mt-3 small">
            Token refreshes in: <span id="fsTimerCount">120</span>s
        </div>
    </div>
</div>

<!-- FULLSCREEN CODE OVERLAY -->
<div id="codeFullscreen"
     style="position:fixed; inset:0; background:rgba(0,0,0,0.9); z-index:1050; display:none;">
    <div style="width:100%; height:100%; display:flex; flex-direction:column; justify-content:center; align-items:center;">
        <button type="button" class="btn btn-light btn-sm position-absolute"
                style="top:15px; right:15px;"
                id="codeFsCloseBtn">
            <i class="fas fa-times"></i> Close
        </button>

        <div class="d-flex align-items-center mb-3">
            <div class="display-1 font-weight-bold text-white mr-3" id="codeFullscreenText">•••••</div>
            <button type="button" class="btn btn-sm btn-outline-light" id="fsRevealBtn">
                Reveal
            </button>
        </div>

        <div class="text-muted mt-2 small">
            Manual attendance code
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        var baseAttendanceUrl = '@Url.Action("ViewAttendance", "Student")';
        var sectionId = $('#sectionId').val();
        var visible = false;
        var realCode = '';
        var timer = null;
        var html5QrScanner = null;
        var totalSeconds = 120;
        var remaining = totalSeconds;

        //build QR URLs
        function buildSmallQrUrl(token) {
            var url = baseAttendanceUrl +
                    '?sectionId=' + encodeURIComponent(sectionId) +
                    '&token=' + encodeURIComponent(token);
            return "https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=" + encodeURIComponent(url);
        }

        function buildLargeQrUrl(token) {
            var url = baseAttendanceUrl +
                    '?sectionId=' + encodeURIComponent(sectionId) +
                    '&token=' + encodeURIComponent(token);
            return "https://api.qrserver.com/v1/create-qr-code/?size=500x500&data=" + encodeURIComponent(url);
        }


        //AJAX func
        //update countdown timer
        function updateCountdown() {
            $('#timerCount').text(remaining);
            $('#fsTimerCount').text(remaining);

            // update progress bar (from 100% down to 0%)
            var pct = (remaining / totalSeconds) * 100;
            $('#qrProgressBar').css('width', pct + '%');
        }

        //start countdown timer
        function startTimer() {
            if (timer) clearInterval(timer);
            remaining = totalSeconds;
            updateCountdown();
            timer = setInterval(function () {
                remaining--;
                if (remaining < 0) {
                    clearInterval(timer);
                    refreshQr();
                    return;
                }
                updateCountdown();
            }, 1000);
        }
        
        //start attendance session
        function startSession() {
            $.post('@Url.Action("StartAttendanceSession","Staff")',
                { sectionId: sectionId },
                function (data) {
                    if (!data.success) return;
                    var smallUrl = buildSmallQrUrl(data.token);
                    var largeUrl = buildLargeQrUrl(data.token);

                    $('#qrImage').attr('src', smallUrl);          // normal small QR
                    $('#qrFullscreenImg').attr('src', largeUrl);  // fullscreen big QR

                    realCode = data.manualCode;
                    if (visible) {
                        $('#manualCode').text(realCode);
                        $('#codeFullscreenText').text(realCode);
                    }
                    startTimer();
                });
        }

        //refresh QR token
        function refreshQr() {
            $.post('@Url.Action("RefreshQrToken","Staff")',
                { sectionId: sectionId },
                function (data) {
                    if (!data.success) return;
                    var smallUrl = buildSmallQrUrl(data.token);
                    var largeUrl = buildLargeQrUrl(data.token);

                    $('#qrImage').attr('src', smallUrl);
                    $('#qrFullscreenImg').attr('src', largeUrl);
                    startTimer();
                });
        }

        //regenerate attendacne code
        function regenCode() {
            $.post('@Url.Action("RegenerateManualCode","Staff")',
                { sectionId: sectionId },
                function (data) {
                    if (!data.success) return;
                    realCode = data.manualCode;
                    if (visible) {
                        $('#manualCode').text(realCode);
                        $('#codeFullscreenText').text(realCode);
                    }
                });
        }

        //render live scans section
        function renderLiveScans(items) {
            var $tbody = $('#liveScanBody');
            if (!items || items.length === 0) {
                $tbody.html('<tr class="text-muted"><td colspan="4" class="text-center">No attendance yet.</td></tr>');
                $('#joinedCount').text('0 Joined');   // reset
                return;
            }

            // build table rows
            var rows = items.map(function (x) {
                var sourceBadge = x.source === 'QR Scan'
                    ? '<span class="badge badge-primary">QR Scan</span>'
                    : '<span class="badge badge-info">Manual Code</span>';

                var statusBadge = x.status === 'Present'
                    ? '<span class="badge badge-success">Present</span>'
                    : '<span class="badge badge-secondary">' + x.status + '</span>';

                return (
                    '<tr>' +
                        '<td>' + x.time + '</td>' +
                        '<td>' + x.studentName + '</td>' +
                        '<td>' + sourceBadge + '</td>' +
                        '<td>' + statusBadge + '</td>' +
                    '</tr>'
                );
            });

            $tbody.html(rows.join(''));

            //update joinedCount to unique student count
            var uniqueIds = {};
            items.forEach(function (x) {
                if (x.studentId) {
                    uniqueIds[x.studentId] = true;
                }
            });
            var count = Object.keys(uniqueIds).length;
            $('#joinedCount').text(count + ' Joined');
        }
    
        //poll live scans
        function pollLiveScans() {
            $.get('@Url.Action("LiveAttendanceRecord", "Staff")', { sectionId: sectionId })
                .done(function (res) {
                    if (res && res.success) {
                        renderLiveScans(res.items);
                    }
                })
                .fail(function () {
                    // fail silently; will retry on next tick
                });
        }

        // start live sscan every 5 seconds
        pollLiveScans();
        setInterval(pollLiveScans, 5000);

        //toggle reveal button
        function toggleReveal() {
            visible = !visible;
            var text = visible ? realCode : '•••••';
            $('#manualCode').text(text);
            $('#codeFullscreenText').text(text);
            $('#revealBtn').text(visible ? 'Hide' : 'Reveal');
            $('#fsRevealBtn').text(visible ? 'Hide' : 'Reveal');
        }

        $('#revealBtn').on('click', toggleReveal);
        $('#fsRevealBtn').on('click', toggleReveal);
        $('#regenCodeBtn').on('click', regenCode);

        function openQrFullscreen() { $('#qrFullscreen').show(); }
        function closeQrFullscreen() { $('#qrFullscreen').hide(); }
        function openCodeFullscreen() { $('#codeFullscreen').show(); }
        function closeCodeFullscreen() { $('#codeFullscreen').hide(); }

        
        $(function () {
            startSession();

            $('#qrFsOpenBtn').on('click', openQrFullscreen);
            $('#qrFsCloseBtn').on('click', closeQrFullscreen);

            $('#codeFsOpenBtn').on('click', openCodeFullscreen);
            $('#codeFsCloseBtn').on('click', closeCodeFullscreen);

            $('#qrFullscreen').on('click', function (e) {
                if (e.target === this) closeQrFullscreen();
            });
            $('#codeFullscreen').on('click', function (e) {
                if (e.target === this) closeCodeFullscreen();
            });

            $(document).on('keydown', function (e) {
                if (e.key === 'Escape') {
                    closeQrFullscreen();
                    closeCodeFullscreen();
                }
            });

            //end session (using sweetalrt)
            $('#stopSessionBtn').on('click', function (e) {
                e.preventDefault();
                Swal.fire({
                    title: 'End attendance session?',
                    text: 'This will stop QR generation and show the session summary.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, end it',
                    cancelButtonText: 'Cancel',
                    reverseButtons: true
                }).then((result) => {
                    if (!result.isConfirmed) return;

                    //stop the timer if running
                    if (timer) {
                        clearInterval(timer);
                        timer = null;
                    }

                    //stop QR scanner if running
                    if (typeof html5QrScanner !== 'undefined' && html5QrScanner) {
                        html5QrScanner.stop().catch(() => { });
                        html5QrScanner = null;
                    }

                    //AJAX request
                    //stop attendance session
                    $.post('@Url.Action("StopAttendanceSession", "Staff")',
                        { sectionId: sectionId },
                        function (response) {
                            if (response.success) {
                                //show success alert
                                Swal.fire({
                                    title: 'Session ended',
                                    text: 'Redirecting to summary...',
                                    icon: 'success',
                                    showConfirmButton: false,
                                    timer: 1200
                                });
                                setTimeout(function () {
                                    window.location.href = response.redirectUrl;
                                }, 1200);
                            } else {
                                //show error alert
                                Swal.fire({
                                    title: 'Failed to stop session',
                                    text: response.message || 'Unknown error',
                                    icon: 'error'
                                });
                            }
                        }).fail(function () {
                            Swal.fire({
                                title: 'Failed to stop session',
                                text: 'Please try again.',
                                icon: 'error'
                            });
                        });
                });
            });
        });
    </script>
}