@using SHAPEE.Models
@model AttendanceManagementVM

@{
    ViewData["Title"] = "Attendance Management";
}

@Html.AntiForgeryToken()

<!-- Header -->
<div class="bg-white border-bottom px-4 py-3 mb-4">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Attendance Details</h1>
            @if (Model?.Section != null)
            {
                <p class="text-muted small mt-2 mb-0">
                    <strong>@Model.Section.Course?.Id - @Model.Section.Course?.Name</strong>
                    (@Model.Section.SectionId) · @Model.Section.Day
                    @Model.Section.StartTime.ToString("HH:mm")–@Model.Section.EndTime.ToString("HH:mm")
                    · Room @Model.Section.Room?.Id · Semester @Model.Section.SemesterId
                </p>
            }
        </div>
        <div class="mt-3 mt-md-0">
            <a class="btn btn-sm btn-outline-secondary mr-2"
               href="@Url.Action("ClassSelection", "Staff", new { mode = "view" })">
                <i class="fas fa-arrow-left fa-sm"></i> Back to Class Selection
            </a>
            <button class="btn btn-sm btn-primary">
                <i class="fas fa-download fa-sm"></i> Export CSV
            </button>
        </div>
    </div>
</div>

@if (Model?.Section == null)
{
    <div class="alert alert-info">
        No class selected. Please go back to the class selection page and choose a class.
    </div>
}
else
{
    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Total Students</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="statTotalStudents">@Model.TotalStudents</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-user-graduate fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Overall Attendance</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="statOverallAttendance">@Model.AveragePresent.ToString("F1")%</div>
                            <div class="small text-muted">All sessions</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-user-check fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-danger shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                                Absences</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="statTotalAbsences">@Model.TotalAbsences</div>
                            <div class="small text-muted">This semester</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-user-times fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Flagged Scans</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="statFlaggedCount">@Model.FlaggedCount</div>
                            <div class="small text-muted">Suspicious IP / device</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-user-secret fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Attendance Table Card -->
    <div class="card shadow-sm">
        <!-- Card Header -->
        <div class="card-header bg-white border-bottom py-3">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between">
                <h5 class="mb-3 mb-md-0 font-weight-semibold text-gray-800">
                    Attendance Records (<span id="attendanceCount">@Model.Attendances.Count()</span>)
                </h5>
                <div class="d-flex gap-2 align-items-center" id="bulkUpdateContainer" style="display: none;">
                    <select class="form-control form-control-sm" id="bulkStatusSelect" style="min-width: 150px; height: 31px;">
                        <option value="">Select Status</option>
                        <option value="Present">Present</option>
                        <option value="Late">Late</option>
                        <option value="Absent">Absent</option>
                        <option value="Excused">Excused</option>
                    </select>
                    <button class="btn btn-sm btn-success" id="bulkUpdateBtn" style="height: 31px; padding: 0.25rem 0.75rem; white-space: nowrap;">
                        <i class="fas fa-save mr-1"></i> Update Selected (<span id="selectedCount">0</span>)
                    </button>
                </div>
            </div>
        </div>

        <!-- Filters Section -->
        <div class="card-body bg-light border-bottom">
            <form id="filterForm"
                  data-ajax="true"
                  data-ajax-method="GET"
                  data-ajax-url="/Staff/AttendanceManagement"
                  data-ajax-update="#attendanceData">
                <input type="hidden" name="sectionId" value="@Model.Section.SectionId" />
                <div class="row g-3">
                    <div class="col-12 col-md-3">
                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="fas fa-search text-muted"></i>
                            </span>
                            <input type="text" class="form-control" name="search" id="searchInput" placeholder="Search students...">
                        </div>
                    </div>
                    <div class="col-12 col-md-2">
                        <input type="date" class="form-control" name="date" id="dateFilter" />
                    </div>
                    <div class="col-12 col-md-2">
                        <select class="form-control" name="status" id="statusFilter">
                            <option value="">All Statuses</option>
                            <option value="Present">Present</option>
                            <option value="Late">Late</option>
                            <option value="Absent">Absent</option>
                            <option value="Excused">Excused</option>
                            <option value="Flagged">Flagged</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-2">
                        <select class="form-control" name="sort" id="attendanceSort">
                            <option value="">Sort By</option>
                            <option value="1">Date (Ascending)</option>
                            <option value="2">Date (Descending)</option>
                            <option value="3">Student ID (Ascending)</option>
                            <option value="4">Student ID (Descending)</option>
                            <option value="5">Time (Early to Late)</option>
                            <option value="6">Time (Late to Early)</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-1">
                        <button type="reset" class="btn btn-secondary w-100" title="Reset filters">
                            <i class="fas fa-undo"></i>
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Attendance Table -->
        <div class="card-body p-0">
            <div class="table-responsive">
                <div id="attendanceData">
                    <partial name="_Attendance" />
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            //initialize handlers
            initializeHandlers();

            //update attendance list with filters
            function refreshAttendanceList() {
                const searchTerm = $('#searchInput').val();
                const selectedDate = $('#dateFilter').val();
                const selectedStatus = $('#statusFilter').val();
                const sortOption = $('#attendanceSort').val();
                const sectionId = '@Model?.Section?.SectionId';

                const queryParams = new URLSearchParams();
                queryParams.append('sectionId', sectionId);
                if (searchTerm) queryParams.append('search', searchTerm);
                if (selectedDate) queryParams.append('date', selectedDate);
                if (selectedStatus) queryParams.append('status', selectedStatus);
                if (sortOption) queryParams.append('sort', sortOption);

                $.ajax({
                    url: '/Staff/AttendanceManagement',
                    type: 'GET',
                    data: queryParams.toString(),
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    success: function(response) {
                        $('#attendanceData').html(response);
                        const totalCount = $('#attendanceTableBody tr[data-attendance-id]').length;
                        $('#attendanceCount').text(totalCount);
                        initializeHandlers();
                        updateSelectedCount();
                    },
                    error: function() {
                        alert('Error loading attendance records');
                    }
                });
            }

            //update selected count and show/hide bulk update button
            function updateSelectedCount() {
                const selectedCount = $('.attendance-checkbox:checked').length;
                $('#selectedCount').text(selectedCount);
                
                if (selectedCount > 0) {
                    $('#bulkUpdateContainer').show();
                    //disable status dropdowns for selected rows
                    $('.attendance-checkbox:checked').each(function() {
                        const $row = $(this).closest('tr');
                        $row.find('.attendance-status-select').prop('disabled', true);
                    });
                    //enable status dropdowns for unselected rows
                    $('.attendance-checkbox:not(:checked)').each(function() {
                        const $row = $(this).closest('tr');
                        $row.find('.attendance-status-select').prop('disabled', false);
                    });
                } else {
                    $('#bulkUpdateContainer').hide();
                    $('#bulkStatusSelect').val('');
                    //enable all status dropdowns
                    $('.attendance-status-select').prop('disabled', false);
                }
            }

            //initialize all event handlers
            function initializeHandlers() {
                //select all checkbox
                $(document).off('change', '#selectAllCheckbox').on('change', '#selectAllCheckbox', function() {
                    const isChecked = $(this).prop('checked');
                    $('.attendance-checkbox').prop('checked', isChecked);
                    updateSelectedCount();
                });

                //individual checkbox change
                $(document).off('change', '.attendance-checkbox').on('change', '.attendance-checkbox', function() {
                    updateSelectedCount();
                    //uncheck select all if individual checkbox unchecked
                    const totalCheckboxes = $('.attendance-checkbox').length;
                    const checkedCheckboxes = $('.attendance-checkbox:checked').length;
                    $('#selectAllCheckbox').prop('checked', totalCheckboxes === checkedCheckboxes);
                });

                //status select change -- show save/cancel buttons (only if not disabled)
                $(document).off('change', '.attendance-status-select').on('change', '.attendance-status-select', function() {
                    //ignore if disabled (selected for bulk update)
                    if ($(this).prop('disabled')) {
                        return;
                    }
                    
                    const $row = $(this).closest('tr');
                    const attendanceId = $(this).data('attendance-id');
                    const newStatus = $(this).val();
                    const originalStatus = $(this).data('original-status');
                    
                    if (newStatus !== originalStatus) {
                        //show save and cancel buttons
                        $row.find('.saveAttendanceBtn').show();
                        $row.find('.cancelAttendanceBtn').show();
                        $row.addClass('table-warning');
                    } else {
                        //hide buttons if status reverted
                        $row.find('.saveAttendanceBtn').hide();
                        $row.find('.cancelAttendanceBtn').hide();
                        $row.removeClass('table-warning');
                    }
                });

                //single attendance status save
                $(document).off('click', '.saveAttendanceBtn').on('click', '.saveAttendanceBtn', function() {
                    const attendanceId = $(this).data('attendance-id');
                    const $row = $(this).closest('tr');
                    const statusSelect = $row.find('.attendance-status-select');
                    const newStatus = statusSelect.val();
                    const originalStatus = statusSelect.data('original-status');
                    
                    if (newStatus === originalStatus) {
                        SweetAlert.info('No Changes', 'Status has not been changed.');
                        return;
                    }
                    
                    updateAttendanceStatus([attendanceId], newStatus, function() {
                        //update original status after successful save
                        statusSelect.data('original-status', newStatus);
                        $row.find('.saveAttendanceBtn').hide();
                        $row.find('.cancelAttendanceBtn').hide();
                        $row.removeClass('table-warning');
                    });
                });

                //cancel changes for single record
                $(document).off('click', '.cancelAttendanceBtn').on('click', '.cancelAttendanceBtn', function() {
                    const attendanceId = $(this).data('attendance-id');
                    const $row = $(this).closest('tr');
                    const statusSelect = $row.find('.attendance-status-select');
                    const originalStatus = statusSelect.data('original-status');
                    
                    SweetAlert.confirm(
                        'Cancel Changes?',
                        'Are you sure you want to discard the changes?',
                        {
                            confirmButtonText: 'Yes, Discard',
                            cancelButtonText: 'No, Keep Changes',
                            onConfirm: function() {
                                statusSelect.val(originalStatus);
                                $row.find('.saveAttendanceBtn').hide();
                                $row.find('.cancelAttendanceBtn').hide();
                                $row.removeClass('table-warning');
                                SweetAlert.success('Changes Discarded', 'The status has been reverted to the original value.');
                            }
                        }
                    );
                });
            }

            //listen for filter changes
            $('#searchInput, #dateFilter, #statusFilter, #attendanceSort').on('change keyup', function() {
                const inputId = $(this).attr('id');
                //delay search input to prevent high request
                if (inputId === 'searchInput') {
                    clearTimeout(window.searchDelayTimer);
                    window.searchDelayTimer = setTimeout(refreshAttendanceList, 500);
                } else {
                    refreshAttendanceList();
                }
            });

            //reset button click
            $('button[type="reset"]').on('click', function() {
                $('#searchInput').val('');
                $('#dateFilter').val('');
                $('#statusFilter').val('');
                $('#attendanceSort').val('');

                setTimeout(function() {
                    window.location.href = '/Staff/AttendanceManagement?sectionId=@Model?.Section?.SectionId';
                }, 100);
            });

            //bulk attendance status update
            $(document).on('click', '#bulkUpdateBtn', function() {
                const selectedIds = $('.attendance-checkbox:checked').map(function() {
                    return $(this).val();
                }).get();
                
                if (selectedIds.length === 0) {
                    SweetAlert.warning('No Selection', 'Please select at least one record to update.');
                    return;
                }
                
                const newStatus = $('#bulkStatusSelect').val();
                if (!newStatus) {
                    SweetAlert.warning('Status Required', 'Please select a status from the dropdown.');
                    return;
                }
                
                SweetAlert.confirm(
                    'Bulk Update Status',
                    `Are you sure you want to update ${selectedIds.length} record(s) to "${newStatus}"?`,
                    {
                        confirmButtonText: 'Yes, Update',
                        cancelButtonText: 'Cancel',
                        onConfirm: function() {
                            updateAttendanceStatus(selectedIds, newStatus, function() {
                                //uncheck all checkboxes after successful update
                                $('.attendance-checkbox').prop('checked', false);
                                $('#selectAllCheckbox').prop('checked', false);
                                updateSelectedCount();
                            });
                        },
                        onCancel: function() {
                            SweetAlert.info('Cancelled', 'Bulk update has been cancelled.');
                        }
                    }
                );
            });

            //refresh statistics cards
            function refreshStatistics() {
                const sectionId = '@Model?.Section?.SectionId';
                
                $.ajax({
                    url: '/Staff/GetAttendanceStatistics',
                    type: 'GET',
                    data: { sectionId: sectionId },
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    success: function(response) {
                        if (response.success) {
                            $('#statTotalStudents').text(response.totalStudents);
                            $('#statOverallAttendance').text(response.overallAttendance.toFixed(1) + '%');
                            $('#statTotalAbsences').text(response.totalAbsences);
                            $('#statFlaggedCount').text(response.flaggedCount);
                        }
                    },
                    error: function() {
                        console.error('Error refreshing statistics');
                    }
                });
            }

            //update attendance status function
            function updateAttendanceStatus(attendanceIds, newStatus, onSuccess) {
                $.ajax({
                    url: '/Staff/UpdateAttendanceStatus',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        attendanceIds: attendanceIds,
                        status: newStatus
                    }),
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            //refresh statistics first
                            refreshStatistics();
                            
                            SweetAlert.success(
                                'Success!',
                                response.message || `Successfully updated ${attendanceIds.length} record(s) to ${newStatus}.`,
                                {
                                    timer: 2000,
                                    onConfirm: function() {
                                        if (onSuccess) onSuccess();
                                        refreshAttendanceList();
                                    }
                                }
                            );
                        } else {
                            SweetAlert.error('Error', response.message || 'Failed to update attendance status.');
                        }
                    },
                    error: function() {
                        SweetAlert.error('Error', 'An error occurred while updating attendance status.');
                    }
                });
            }
        });
    </script>
}