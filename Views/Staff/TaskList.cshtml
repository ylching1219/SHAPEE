@model IEnumerable<SHAPEE.Models.CourseTask>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Assignment Management</h2>
        <a href="/Staff/TaskCreate" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Create New Task
        </a>
    </div>

    <div class="table-responsive shadow-sm">
        <table class="table table-hover bg-white border">
            <thead class="table-dark">
                <tr>
                    <th>Task Title</th>
                    <th>Class Section</th>
                    <th>Due Date</th>
                    <th>Materials</th>
                    <th>Submissions</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in Model)
                {
                    <tr>
                        <td><strong>@task.Title</strong></td>
                        <td>@task.ClassSectionId</td>
                        <td>
                            <span class="@(task.DueDate < DateTime.Now ? "text-danger" : "text-dark")">
                                @task.DueDate.ToString("dd MMM yyyy, hh:mm tt")
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-info text-dark">
                                @task.Materials.Count() Files
                            </span>
                        </td>
                        <td>
                            <a href="/Staff/ViewSubmissions/@task.Id" class="btn btn-sm btn-outline-success">
                                View (@task.Submissions.Count())
                            </a>
                        </td>
                        <td>
                            <a href="/Staff/TaskEdit/@task.Id" class="btn btn-sm btn-light border">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>