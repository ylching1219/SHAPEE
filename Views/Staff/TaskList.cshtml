@model IEnumerable<SHAPEE.Models.CourseTask>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">Assignment Management</h2>
            <p class="text-muted small">Manage student assignments and grading</p>
        </div>
        <div class="d-flex gap-2">
            <select id="sortFilter" class="form-select form-select-sm" style="width: auto;">
                <option value="newest" selected="@(ViewBag.CurrentSort == "newest")">Newest Due Date</option>
                <option value="oldest" selected="@(ViewBag.CurrentSort == "oldest")">Oldest Due Date</option>
                <option value="title" selected="@(ViewBag.CurrentSort == "title")">Task Title (A-Z)</option>
                <option value="id_asc" selected="@(ViewBag.CurrentSort == "id_asc")">Task ID (Ascending)</option>
                <option value="id_desc" selected="@(ViewBag.CurrentSort == "id_desc")">Task ID (Descending)</option>
            </select>

            <a href="/Staff/TaskCreate" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Create New Task
            </a>
        </div>
    </div>

    <div class="table-responsive shadow-sm">
        <table class="table align-middle bg-white border">
            <thead class="table-dark">
                <tr>
                    <th>Task Title</th>
                    <th>Class Section</th>
                    <th>Due Date</th>
                    <th>Submissions</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody class="table-hover">
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted italic">No tasks found. Create one to get started!</td>
                    </tr>
                }
                @foreach (var task in Model)
                {
                    <tr>
                        <td>
                            <strong>@task.Title</strong><br />
                            <small class="text-muted">ID: @task.Id</small>
                        </td>
                        <td><span class="badge bg-light text-dark border">@task.ClassSectionId</span></td>
                        <td>
                            <span class="@(task.DueDate < DateTime.Now ? "text-danger fw-bold" : "text-dark")">
                                <i class="bi bi-calendar-event"></i> @task.DueDate.ToString("dd MMM yyyy, hh:mm tt")
                            </span>
                        </td>
                        <td>
                            @{
                                var totalInClass = task.ClassSection?.TutorialGroup?.Students?.Count ?? 0;
                                var subCount = task.Submissions?.Count ?? 0;
                                bool allSubmitted = subCount >= totalInClass && totalInClass > 0;
                            }
                            <span class="badge @(allSubmitted ? "bg-success" : "bg-warning") text-white">
                                @subCount / @totalInClass Submitted
                            </span>
                        </td>
                        <td>
                            <div class="btn-group">
                                <a href="@Url.Action("TaskDetails", "Staff", new { id = task.Id })" class="btn btn-sm btn-info text-white">
                                    <i class="bi bi-eye"></i> View & Grade
                                </a>
                                <a href="@Url.Action("TaskEdit", "Staff", new { id = task.Id })" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        // When the sort dropdown changes, reload the page with the sort parameter
        $('#sortFilter').change(function () {
            var sortVal = $(this).val();
            window.location.href = '@Url.Action("TaskList", "Staff")?sort=' + sortVal;
        });
    });
</script>