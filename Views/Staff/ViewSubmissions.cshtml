@model SHAPEE.Models.CourseTask

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Staff/TaskList">Tasks</a></li>
            <li class="breadcrumb-item active">Submissions for @Model.Title</li>
        </ol>
    </nav>

    <h3>Submissions for: @Model.Title</h3>
    <hr />

    <div class="row">
        @foreach (var sub in Model.Submissions)
        {
            <div class="col-md-6 mb-3">
                <div class="card border-start border-4 @(sub.Grade != null ? "border-success" : "border-warning")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <h5 class="card-title">@sub.Student?.FullName</h5>
                            <small class="text-muted">@sub.SubmittedAt.ToString("g")</small>
                        </div>

                        <p class="mb-2">
                            <a href="@sub.FileUrl" target="_blank" class="btn btn-sm btn-link p-0">
                                <i class="bi bi-file-earmark-arrow-down"></i> Download Student File
                            </a>
                        </p>

                        <form asp-action="GradeSubmission" method="post" class="mt-3 bg-light p-2 rounded">
                            <input type="hidden" name="SubmissionId" value="@sub.Id" />
                            <div class="row g-2">
                                <div class="col-4">
                                    <input type="number" name="Grade" class="form-control" placeholder="Grade" value="@sub.Grade" step="0.01" max="100" />
                                </div>
                                <div class="col-8">
                                    <input type="text" name="Feedback" class="form-control" placeholder="Short feedback..." value="@sub.Feedback" />
                                </div>
                            </div>
                            <button type="submit" class="btn btn-sm btn-primary mt-2 w-100">Update Grade</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>