@using SHAPEE.Models
@model IEnumerable<ClassSection>

@{
    var mode = (ViewData["Mode"] as string ?? "take").ToLower();
    var isView = mode == "view";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800">
            @(isView ? "Select Class to View Attendance" : "Select Class to Take Attendance")
        </h1>
        <p class="text-muted small mt-2">
            Choose one of your classes to take attendance.
        </p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        You currently have no classes assigned. Please contact the administrator if this is unexpected.
    </div>
}
else
{
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Your Classes</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                    <thead class="thead-light">
                        <tr>
                            <th>Section ID</th>
                            <th>Course</th>
                            <th>Day / Time</th>
                            <th>Room</th>
                            <th>Semester</th>
                            <th style="width: 140px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>@s.SectionId</td>
                                <td>@s.Course?.Id - @s.Course?.Name</td>
                                <td>
                                    @s.Day,
                                    @s.StartTime.ToString("HH:mm") – @s.EndTime.ToString("HH:mm")
                                </td>
                                <td>@s.Room?.Id</td>
                                <td>@s.SemesterId</td>
                                <td>
                                    <a class="btn btn-sm btn-primary"
                                       href="@Url.Action(
                                                isView ? "AttendanceManagement" : "MarkAttendance",
                                                "Staff",
                                                new { sectionId = s.SectionId })">
                                        <i class="fas @(isView ? "fa-eye" : "fa-play-circle")"></i>
                                        @(isView ? "View Attendance" : "Start Session")
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}