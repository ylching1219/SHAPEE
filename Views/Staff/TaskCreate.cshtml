@model SHAPEE.Models.CourseTask

@{
    ViewData["Title"] = "Create Assignment";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">Create New Course Task</h2>
        </div>
        <div class="card-body">
            <form method="post" enctype="multipart/form-data">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Class Section</label>
                        <select asp-for="ClassSectionId" class="form-select" required>
                            <option value="">-- Select Section --</option>
                            @foreach (var s in ViewBag.Sections)
                            {
                                <option value="@s.SectionId">@s.Course.Name (@s.SectionId)</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Due Date</label>
                        <input type="datetime-local" asp-for="DueDate" class="form-control" required
                               onkeydown="return false;" onpaste="return false;" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Assignment Title</label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Midterm Project" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Description / Instructions</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter task details..." required></textarea>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold text-primary">Attach Course Materials</label>
                    <p class="text-muted small">Select the materials students need for this task:</p>
                    <div class="border rounded p-3" style="max-height: 200px; overflow-y: auto;">
                        @if (ViewBag.Materials != null)
                        {
                            @foreach (var m in (IEnumerable<SHAPEE.Models.Material>)ViewBag.Materials)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="SelectedMaterialIds" value="@m.Id" id="mat_@m.Id">
                                    <label class="form-check-label" for="mat_@m.Id">
                                        <span class="badge bg-secondary">@m.MaterialType</span> @m.Title
                                    </label>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-danger italic">No materials found for this course.</p>
                        }
                    </div>
                </div>

                <div class="mt-4">
                    <button class="btn btn-success px-4" type="submit">
                        <i class="bi bi-plus-circle"></i> Create Task
                    </button>
                    <a class="btn btn-outline-secondary px-4" href="/Staff/TaskList">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>