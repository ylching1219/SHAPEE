@using SHAPEE.Models
@model SessionSummaryVM
@Html.AntiForgeryToken()

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800">Session Summary</h1>
        <p class="text-muted small mt-2">
            @Model.Section.Course?.Name (@Model.Section.SectionId) · @Model.Today.ToString("dddd, MMMM dd, yyyy")
        </p>
    </div>
    <div>
        <a href="@Url.Action("ClassSelection", "Staff", new { mode = "take" })" class="btn btn-sm btn-primary shadow-sm">
            <i class="fas fa-arrow-left fa-sm text-white-50"></i> Back to Classes
        </a>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Enrolled</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalEnrolled Students</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-users fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Present</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.PresentCount Students</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-check-circle fa-2x text-success"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-danger shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Absent</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.AbsentCount Students</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-times-circle fa-2x text-danger"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Attendance Rate</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.AttendancePercentage%</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-chart-pie fa-2x text-info"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Attendance Progress Bar -->
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Overall Attendance</h6>
    </div>
    <div class="card-body">
        <div class="progress" style="height: 30px;">
            <div class="progress-bar bg-success" role="progressbar" 
                 style="width: @Model.AttendancePercentage%" 
                 aria-valuenow="@Model.AttendancePercentage" 
                 aria-valuemin="0" 
                 aria-valuemax="100">
                <strong>@Model.AttendancePercentage%</strong>
            </div>
        </div>
        <small class="text-muted mt-2 d-block">
            @Model.PresentCount out of @Model.TotalEnrolled students marked present
        </small>
    </div>
</div>

<div class="row">
    <!-- Present Students -->
    <div class="col-lg-6 mb-4">
        <div class="card shadow">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-success">
                    <i class="fas fa-check-circle"></i> Present Students (@Model.PresentCount)
                </h6>
            </div>
            <div class="card-body">
                @if (Model.PresentStudents.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    <th>Student ID</th>
                                    <th>Name</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var student in Model.PresentStudents)
                                {
                                    var attendance = Model.FlaggedAttendances.FirstOrDefault(a => a.StudentId == student.Id);
                                    <tr>
                                        <td>@student.Id</td>
                                        <td>@student.FullName</td>
                                        <td>
                                            @if (attendance != null && attendance.IsFlaged)
                                            {
                                                <span class="badge badge-warning" title="@attendance.FlagReason">
                                                    <i class="fas fa-flag"></i> Flagged
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-success">Verified</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center mb-0">No students marked present.</p>
                }
            </div>
        </div>
    </div>

    <!-- Absent Students -->
    <div class="col-lg-6 mb-4">
        <div class="card shadow">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-danger">
                    <i class="fas fa-times-circle"></i> Absent Students (@Model.AbsentCount)
                </h6>
                @if (Model.AbsentStudents.Any())
                {
                    <button type="button" class="btn btn-sm btn-danger" id="markAllAbsentBtn" 
                            data-section-id="@Model.Section.SectionId">
                        <i class="fas fa-user-times"></i> Mark All as Absent
                    </button>
                }
            </div>
            <div class="card-body">
                @if (Model.AbsentStudents.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    <th>Student ID</th>
                                    <th>Name</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var student in Model.AbsentStudents)
                                {
                                    <tr>
                                        <td>@student.Id</td>
                                        <td>@student.FullName</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-success text-center mb-0">
                        <i class="fas fa-check-circle"></i> All students are present!
                    </p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Flagged Attendances -->
@if (Model.FlaggedAttendances.Any())
{
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-warning">
                <i class="fas fa-exclamation-triangle"></i> Flagged Attendances (@Model.FlaggedCount)
            </h6>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <i class="fas fa-info-circle"></i> These attendance records have been flagged for review due to suspicious activity.
            </div>
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Student ID</th>
                            <th>Student Name</th>
                            <th>Registered At</th>
                            <th>Flag Reason</th>
                            <th>IP Address</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var attendance in Model.FlaggedAttendances)
                        {
                            <tr>
                                <td>@attendance.StudentId</td>
                                <td>@(attendance.Student?.FullName ?? "N/A")</td>
                                <td>@attendance.RegisteredAt.ToString("HH:mm:ss")</td>
                                <td>
                                    <span class="badge badge-warning">@attendance.FlagReason</span>
                                </td>
                                <td><small class="text-muted">@attendance.IpAddress</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<div class="card shadow">
    <div class="card-body text-center">
        <a href="@Url.Action("ClassSelection", "Staff", new { mode = "take" })" class="btn btn-primary mr-2">
            <i class="fas fa-arrow-left"></i> Back to Classes
        </a>
        <a href="@Url.Action("AttendanceManagement", "Staff", new { sectionId = Model.Section.SectionId })" class="btn btn-secondary">
            <i class="fas fa-chart-bar"></i> View Full Attendance History
        </a>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            function getAntiForgeryToken() {
                const tokenInput = $('input[name="__RequestVerificationToken"]').val();
                if (tokenInput) return tokenInput;
                
                //get from cookie 
                const cookies = document.cookie.split(';');
                for (let cookie of cookies) {
                    const [name, value] = cookie.trim().split('=');
                    if (name === '.AspNetCore.Antiforgery.xxxxx' || name.includes('Antiforgery')) {
                        return '';
                    }
                }
                return '';
            }

            $('#markAllAbsentBtn').on('click', function() {
                const sectionId = $(this).data('section-id');
                const btn = $(this);
                const originalHtml = btn.html();
                const token = getAntiForgeryToken();
                
                SweetAlert.confirm(
                    'Mark All as Absent?',
                    'Are you sure you want to mark all absent students as "Absent" with reason "Not Registered"? This action cannot be undone.',
                    {
                        confirmButtonText: 'Yes, Mark All',
                        confirmButtonColor: '#e74a3b',
                        cancelButtonText: 'Cancel',
                        onConfirm: function() {
                            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Processing...');
                            
                            $.ajax({
                                url: '@Url.Action("MarkAllAbsent", "Staff")',
                                type: 'POST',
                                headers: {
                                    'X-Requested-With': 'XMLHttpRequest',
                                    'RequestVerificationToken': token
                                },
                                data: {
                                    sectionId: sectionId,
                                    __RequestVerificationToken: token
                                },
                                dataType: 'json',
                                success: function(response) {
                                    if (response && response.success) {
                                        SweetAlert.success(
                                            'Success!',
                                            response.message,
                                            {
                                                timer: 2000,
                                                onConfirm: function() {
                                                    window.location.reload();
                                                }
                                            }
                                        );
                                    } else {
                                        SweetAlert.error(
                                            'Error',
                                            (response && response.message) || 'Failed to mark students as absent.'
                                        );
                                        btn.prop('disabled', false).html(originalHtml);
                                    }
                                },
                                error: function(xhr, status, error) {
                                    let errorMsg = 'Error marking students as absent. Please try again.';
                                    
                                    //parse JSON error response
                                    if (xhr.responseJSON && xhr.responseJSON.message) {
                                        errorMsg = xhr.responseJSON.message;
                                    } else if (xhr.responseText) {
                                        try {
                                            const response = JSON.parse(xhr.responseText);
                                            if (response.message) {
                                                errorMsg = response.message;
                                            }
                                        } catch (e) {
                                            //if not JSON, try to extract error from HTML
                                            if (xhr.status === 400 || xhr.status === 500) {
                                                errorMsg = 'Server error occurred. Please check the console for details.';
                                            }
                                        }
                                    }
                                    
                                    console.error('Error details:', {
                                        status: xhr.status,
                                        statusText: xhr.statusText,
                                        responseText: xhr.responseText,
                                        error: error
                                    });
                                    
                                    SweetAlert.error('Error', errorMsg);
                                    btn.prop('disabled', false).html(originalHtml);
                                }
                            });
                        }
                    }
                );
            });
        });
    </script>
}
