@model IEnumerable<SHAPEE.Models.SupportTicket>

@{
    ViewData["Title"] = "Staff Ticket List";
}

<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f7f9fc;
        margin: 0;
        padding: 0;
    }

    h2 {
        text-align: center;
        margin: 30px 0;
        font-weight: 700;
    }

    .alert-success {
        width: 90%;
        max-width: 900px;
        margin: 20px auto;
        padding: 12px 20px;
        background-color: #d4edda;
        border-radius: 8px;
        color: #155724;
        text-align: center;
        font-weight: 500;
    }

    .btn-primary, .btn-info {
        display: inline-block;
        padding: 10px 16px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
    }

    .btn-primary {
        background-color: #007bff;
        color: #fff !important;
    }

        .btn-primary:hover {
            background-color: #0056c7;
        }

    .btn-info {
        background-color: #17a2b8;
        color: #fff !important;
        font-size: 0.9rem;
        padding: 6px 12px;
    }

        .btn-info:hover {
            background-color: #138496;
        }

    table {
        width: 90%;
        max-width: 1000px;
        margin: 0 auto 50px;
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        border-collapse: collapse;
    }

    thead {
        background: #007bff;
        color: white;
    }

    th, td {
        padding: 12px 15px;
        text-align: left;
        word-wrap: break-word;
    }

    tbody tr:nth-child(even) {
        background: #f8f9fa;
    }

    .filter-container {
        width: 90%;
        max-width: 1000px;
        margin: 20px auto;
        display: flex;
        gap: 15px;
        justify-content: flex-start;
    }

        .filter-container input, .filter-container select {
            padding: 8px 12px;
            border-radius: 6px;
            border: 1px solid #ccc;
            font-size: 1rem;
        }
</style>

<h2>Staff Ticket List</h2>

@if (TempData["Message"] != null)
{
    <div class="alert-success">@TempData["Message"]</div>
}

<div class="filter-container">
    <input type="text" id="searchText" placeholder="Search by Ticket ID or Subject..." />
    <select id="statusFilter">
        <option value="">All Status</option>
        <option value="Open">Open</option>
        <option value="Closed">Closed</option>
    </select>
</div>

<div id="ticketTableContainer">
    <table id="ticketTable">
        <thead>
            <tr>
                <th>Ticket ID</th>
                <th>Subject</th>
                <th>Status</th>
                <th>Priority</th>
                <th>Created At</th>
                <th>Resolved At</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.Id</td>
                    <td>@t.Subject</td>
                    <td>@t.Status</td>
                    <td>@t.Priority</td>
                    <td>@t.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@(t.ResolvedAt.HasValue? t.ResolvedAt.Value.ToString("dd/MM/yyyy HH:mm") : "—")</td>
                    <td>
                        <a class="btn-info" href="@Url.Action("StaffTicketDetails", "Staff", new { id = t.Id })">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    const searchInput = document.getElementById("searchText");
    const statusSelect = document.getElementById("statusFilter");

    const loadTickets = () => {
        const search = searchInput.value;
        const status = statusSelect.value;

        fetch(`@Url.Action("GetStaffTickets", "Staff")?search=${encodeURIComponent(search)}&status=${encodeURIComponent(status)}`)
            .then(res => res.text())
            .then(html => {
                document.getElementById("ticketTableContainer").innerHTML = html;
            });
    };

    searchInput.addEventListener("keyup", loadTickets);
    statusSelect.addEventListener("change", loadTickets);

    // Auto-refresh every 5 minutes
    setInterval(loadTickets, 5 * 60 * 1000);
</script>
