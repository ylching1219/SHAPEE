@model SHAPEE.Models.CourseTask

<h2>@Model.Title</h2>

<h4>Submissions</h4>

<table class="table table-bordered">
    <tr>
        <th>Student</th>
        <th>File</th>
        <th>Submitted</th>
        <th>Grade</th>
        <th></th>
    </tr>

    @foreach (var s in Model.Submissions)
    {
        <tr>
            <td>@s.StudentId</td>
            <td><a href="@s.FileUrl" target="_blank">Download</a></td>
            <td>@s.SubmittedAt</td>
            <td>@s.Grade</td>

            <td>
                <form method="post" action="/AssignmentStaff/Grade">

                    <input type="hidden" name="id" value="@s.Id" />

                    <input type="number"
                           name="grade"
                           class="form-control"
                           step="0.01" />

                    <textarea name="feedback"
                          class="form-control"></textarea>

                    <button class="btn btn-success">Save</button>
                </form>
            </td>
        </tr>
    }
</table>
