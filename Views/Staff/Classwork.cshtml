@model List<SHAPEE.Models.Material>

@{
    ViewData["Title"] = "Classwork Page";
    var courseId = ViewBag.CourseId as string;
}

<style>
    body {
        font-family: Arial, sans-serif;
        background-color: #f5f5f5;
        margin: 0;
        padding: 0;
    }

    .class-header {
        background: white;
        height: 80px;
        border-radius: 12px;
        margin: 20px auto;
        width: 90%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        font-weight: bold;
        box-shadow: 0 3px 8px rgba(0,0,0,0.1);
    }

    .upload-header {
        width: 90%;
        margin: 25px auto 10px auto;
        font-size: 1.2rem;
        font-weight: bold;
    }

    #titleInput {
        width: 90%;
        height: 40px;
        margin: 10px auto;
        display: block;
        padding: 10px;
        border-radius: 8px;
        border: 1px solid #ccc;
    }

    .upload-area {
        width: 90%;
        margin: 0 auto;
        background: white;
        padding: 25px;
        border-radius: 12px;
        text-align: center;
        border: 2px dashed #007bff;
        cursor: pointer;
    }

        .upload-area.dragover {
            background: #e8f1ff;
        }

    #pendingFiles {
        width: 90%;
        margin: 10px auto;
    }

    .file-item {
        background: #e8f1ff;
        padding: 6px 10px;
        border-radius: 6px;
        display: flex;
        justify-content: space-between;
        margin-bottom: 5px;
    }

        .file-item button {
            background: #dc3545;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.8rem;
        }

    #uploadBtn {
        margin: 20px auto;
        padding: 10px 25px;
        border-radius: 6px;
        background: #007bff;
        color: white;
        border: none;
        display: block;
        cursor: pointer;
    }

    .material-box {
        width: 90%;
        background: white;
        margin: 15px auto;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }

    .material-title {
        font-size: 1.1rem;
        font-weight: bold;
        margin-bottom: 10px;
        color: black;
    }

    .file-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #f1f6ff;
        padding: 8px 12px;
        border-radius: 6px;
        margin-bottom: 6px;
    }

    .file-link {
        text-decoration: none;
        color: #007bff;
        font-weight: bold;
    }

    .delete-btn {
        background: #dc3545;
        color: white;
        border: none;
        padding: 5px 10px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 0.85rem;
    }

        .delete-btn:hover {
            background: #c82333;
        }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin: 15px 0 10px 5%;
        padding: 8px 14px;
        background: #e9eef5;
        color: #333;
        text-decoration: none;
        border-radius: 6px;
        font-weight: bold;
        font-size: 0.9rem;
    }

        .back-btn:hover {
            background: #dce4f2;
        }

    #materialSearch, #fileTypeFilter {
        padding: 10px 12px;
        border-radius: 6px;
        border: 1px solid #ccc;
        font-size: 1rem;
    }
</style>

<a href="/Classroom/ClassroomUI" class="back-btn">← Back</a>



<div class="class-header">@courseId</div>

<!-- Add New Material Section -->
<div class="upload-header">Add New Material</div>

<input type="text" id="titleInput" placeholder="Enter material title" />

<div id="uploadArea" class="upload-area">
    <p>Drag & Drop your files here</p>
    <p>or click to browse</p>
    <input type="file" id="fileInput" multiple hidden />
</div>

<div id="pendingFiles"></div>
<button id="uploadBtn">Upload Files</button>

<!-- Search + Filter Section -->
<div style="width:90%; max-width:600px; margin: 20px auto; display:flex; gap:10px;">
    <input type="text" id="materialSearch" placeholder="Search materials..." style="flex:1;" />
    <select id="fileTypeFilter">
        <option value="">All Types</option>
        <option value="PDF">PDF</option>
        <option value="PPT">PPT</option>
        <option value="DOCX">DOCX</option>
        <option value="IMAGE">IMAGE</option>
        <option value="VIDEO">VIDEO</option>
    </select>
</div>

<!-- Existing Materials -->
<div class="upload-header">Existing Materials</div>

@if (Model != null && Model.Any())
{
    @foreach (var group in Model.GroupBy(m => m.Title))
    {
        <div class="material-box">
            <div class="material-title">@group.Key</div>

            @foreach (var doc in group)
            {
                <div class="file-row">
                    <a href="@doc.FileUrl" target="_blank" class="file-link">
                        @doc.Id (@doc.MaterialType?.ToUpper())
                    </a>

                    <button class="delete-btn" onclick="deleteMaterial('@doc.Id')">Delete</button>
                </div>
            }
        </div>
    }
}
else
{
    <p style="text-align:center;color:#666;">No materials uploaded yet.</p>
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    // Upload logic
    let filesToUpload = [];
    const uploadArea = document.getElementById("uploadArea");
    const fileInput = document.getElementById("fileInput");
    const courseId = '@courseId';

    uploadArea.addEventListener("click", () => fileInput.click());
    uploadArea.addEventListener("dragover", e => { e.preventDefault(); uploadArea.classList.add("dragover"); });
    uploadArea.addEventListener("dragleave", () => uploadArea.classList.remove("dragover"));
    uploadArea.addEventListener("drop", e => { e.preventDefault(); uploadArea.classList.remove("dragover"); handleFiles(e.dataTransfer.files); });
    fileInput.addEventListener("change", () => handleFiles(fileInput.files));

    function handleFiles(files) {
        for (let f of files) filesToUpload.push(f);
        renderPendingFiles();
    }

    function renderPendingFiles() {
        const box = $('#pendingFiles');
        box.empty();
        filesToUpload.forEach((f, i) => {
            box.append(`<div class="file-item"><span>${f.name}</span><button onclick="removeFile(${i})">Remove</button></div>`);
        });
    }

    function removeFile(i) {
        filesToUpload.splice(i, 1);
        renderPendingFiles();
    }

    $('#uploadBtn').click(function () {
        const title = $('#titleInput').val().trim();
        if (!title || filesToUpload.length === 0) { alert("Title and files required"); return; }

        const fd = new FormData();
        filesToUpload.forEach(f => fd.append("files", f));
        fd.append("courseId", courseId);
        fd.append("title", title);

        $.ajax({
            url: '@Url.Action("UploadDoc", "Classroom")',
            type: 'POST',
            data: fd,
            processData: false,
            contentType: false,
            success: function () { alert("Upload successful"); location.reload(); }
        });
    });

    // Delete material
    function deleteMaterial(id) {
        if (!confirm("Are you sure you want to delete this material?")) return;
        if (!confirm("This action CANNOT be undone. Delete permanently?")) return;

        $.ajax({
            url: '@Url.Action("DeleteMaterial", "Classroom")',
            type: 'POST',
            data: { id: id },
            success: function () { alert("Material deleted"); location.reload(); },
            error: function () { alert("Delete failed"); }
        });
    }

    // Search + File Type Filter logic
    const searchInput = document.getElementById("materialSearch");
    const typeFilter = document.getElementById("fileTypeFilter");

    function filterMaterials() {
        const query = searchInput.value.toLowerCase();
        const type = typeFilter.value.toLowerCase();

        document.querySelectorAll(".material-box").forEach(box => {
            let title = box.querySelector(".material-title").textContent.toLowerCase();
            let match = false;

            box.querySelectorAll(".file-row").forEach(row => {
                const fileType = row.querySelector(".file-link")?.textContent.match(/\(([^)]+)\)/)?.[1].toLowerCase() || "";
                const fileName = row.querySelector(".file-link")?.textContent.toLowerCase() || "";

                const matchesSearch = fileName.includes(query) || title.includes(query);
                const matchesType = !type || fileType === type;

                row.style.display = (matchesSearch && matchesType) ? "flex" : "none";
                if (matchesSearch && matchesType) match = true;
            });

            box.style.display = match ? "block" : "none";
        });
    }

    searchInput.addEventListener("input", filterMaterials);
    typeFilter.addEventListener("change", filterMaterials);
</script>
