@model List<SHAPEE.Models.Material>

@{
    ViewData["Title"] = "Classwork Page";
    var courseId = ViewBag.CourseId as string;
}

<style>
    /* body {
        font-family: 'Segoe UI', Arial, sans-serif;
        background-color: #f8f9fa;
        margin: 0;
        padding: 0;
    } */

    .class-header {
        background: white;
        height: 80px;
        border-radius: 12px;
        margin: 20px auto;
        width: 90%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        font-weight: bold;
        box-shadow: 0 3px 8px rgba(0,0,0,0.1);
    }

    .upload-header {
        width: 90%;
        margin: 25px auto 10px auto;
        font-size: 1.2rem;
        font-weight: bold;
    }

    #titleInput {
        width: 90%;
        height: 45px;
        margin: 10px auto;
        display: block;
        padding: 10px;
        border-radius: 8px;
        border: 1px solid #ced4da;
        font-size: 1rem;
        transition: background 0.3s;
    }
        /* fixed title when edit */
        #titleInput:read-only {
            background-color: #e9ecef;
            cursor: not-allowed;
            border-color: #28a745;
        }

    .upload-area {
        width: 90%;
        margin: 0 auto;
        background: white;
        padding: 30px;
        border-radius: 12px;
        text-align: center;
        border: 2px dashed #007bff;
        cursor: pointer;
        transition: background 0.3s;
    }

        .upload-area.dragover {
            background: #e8f1ff;
            border-color: #0056b3;
        }

    #pendingFiles {
        width: 90%;
        margin: 10px auto;
    }

    .file-item {
        background: #e8f1ff;
        padding: 8px 12px;
        border-radius: 6px;
        display: flex;
        justify-content: space-between;
        margin-bottom: 5px;
        align-items: center;
    }

        .file-item button {
            background: #dc3545;
            color: white;
            border: none;
            border-radius: 4px;
            padding: 4px 8px;
            cursor: pointer;
        }

    #uploadBtn {
        margin: 20px auto;
        padding: 12px 30px;
        border-radius: 6px;
        background: #007bff;
        color: white;
        border: none;
        display: block;
        cursor: pointer;
        font-weight: bold;
    }

    .material-box {
        width: 90%;
        background: white;
        margin: 15px auto;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
    }

    .material-title {
        font-size: 1.15rem;
        font-weight: bold;
        margin-bottom: 12px;
        color: #333;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .file-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #f1f6ff;
        padding: 10px 15px;
        border-radius: 8px;
        margin-bottom: 8px;
    }

    .file-link {
        text-decoration: none;
        color: #007bff;
        font-weight: 600;
    }

    .delete-btn {
        background: #dc3545;
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 5px;
        cursor: pointer;
    }

    .add-more-btn {
        background: #28a745;
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 0.85rem;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        margin: 15px 0 10px 5%;
        padding: 8px 16px;
        background: #6c757d;
        color: white;
        text-decoration: none;
        border-radius: 6px;
        font-weight: bold;
    }
        .back-btn:hover {
            background: #495057; 
            color: white; 
            transform: translateX(-5px); 
            transition: all 0.3s ease; 
            box-shadow: 0 4px 8px rgba(0,0,0,0.2); 
        }
    #cancelEdit {
        display: none;
        color: #dc3545;
        font-size: 0.8rem;
        cursor: pointer;
        margin-left: 5%;
        text-decoration: underline;
    }
</style>

<a href="@Url.Action("StaffClassroomUI", "Staff")" class="back-btn">← Back to Courses</a>

<div class="class-header" id="pageTop">@courseId</div>

<div class="upload-header">Upload Section</div>
<span id="cancelEdit" onclick="resetForm()">Cancel Edit Mode</span>
<input type="text" id="titleInput" placeholder="Material Title" />

<div id="uploadArea" class="upload-area">
    <p style="margin:0; font-size: 1.1rem; color: #007bff;"><b>Click to Browse</b> or Drag & Drop Files</p>
    <input type="file" id="fileInput" multiple hidden />
</div>

<div id="pendingFiles"></div>
<button id="uploadBtn">Start Upload</button>

<div class="upload-header">Existing Materials</div>

@if (Model != null && Model.Any())
{
    @foreach (var group in Model.GroupBy(m => m.Title))
    {
        <div class="material-box">
            <div class="material-title">
                <span>@group.Key</span>
                <button class="add-more-btn" onclick="prepareAddMore('@group.Key')">+ Add More Files</button>
            </div>

            @foreach (var doc in group)
            {
                <div class="file-row">
                    <a href="@doc.FileUrl" target="_blank" class="file-link">
                        @doc.Id (@doc.MaterialType?.ToUpper())
                    </a>
                    <button class="delete-btn" onclick="deleteMaterial('@doc.Id')">Delete</button>
                </div>
            }
        </div>
    }
}
else
{
    <p style="text-align:center; color:#888; margin-top: 30px;">No materials found for this course.</p>
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    let filesToUpload = [];
    const courseId = '@courseId';

    const uploadArea = document.getElementById("uploadArea");
    const fileInput = document.getElementById("fileInput");

    uploadArea.addEventListener("click", () => fileInput.click());
    uploadArea.addEventListener("dragover", e => { e.preventDefault(); uploadArea.classList.add("dragover"); });
    uploadArea.addEventListener("dragleave", () => uploadArea.classList.remove("dragover"));
    uploadArea.addEventListener("drop", e => {
        e.preventDefault();
        uploadArea.classList.remove("dragover");
        handleFiles(e.dataTransfer.files);
    });
    fileInput.addEventListener("change", () => handleFiles(fileInput.files));

    function handleFiles(files) {
        for (let f of files) {
            if (!filesToUpload.some(ex => ex.name === f.name)) {
                filesToUpload.push(f);
            }
        }
        renderPendingFiles();
    }

    function renderPendingFiles() {
        const box = $('#pendingFiles');
        box.empty();
        filesToUpload.forEach((f, i) => {
            box.append(`<div class="file-item"><span>${f.name}</span><button onclick="removeFile(${i})">X</button></div>`);
        });
    }

    function removeFile(i) {
        filesToUpload.splice(i, 1);
        renderPendingFiles();
    }

    // read only title
    function prepareAddMore(title) {
        // fixed title
        $('#titleInput').val(title).prop('readonly', true);
        $('#cancelEdit').show();

       window.scrollTo({
        top: 0,
        left: 0,
        behavior: 'smooth' // slide back to top
    });


    $('#titleInput').focus(); // Put the cursor in the box automatically
    $('#titleInput').css('background-color', '#d4edda');
    }
    //unlock the title and back to normal
    function resetForm() {
        $('#titleInput').val('').prop('readonly', false).css('box-shadow', 'none');
        $('#cancelEdit').hide();
        filesToUpload = [];
        renderPendingFiles();
    }

    $('#uploadBtn').click(function () {
        const title = $('#titleInput').val().trim();
        if (!title || filesToUpload.length === 0) { alert("Please provide a title and select files."); return; }

        const fd = new FormData();
        filesToUpload.forEach(f => fd.append("files", f));
        fd.append("courseId", courseId);
        fd.append("title", title);

        $.ajax({
            url: '@Url.Action("UploadDoc", "Staff")',
            type: 'POST',
            data: fd,
            processData: false,
            contentType: false,
            success: function () {
                alert("Successfully uploaded.");
                location.reload();
            },
            error: function () { alert("Upload failed."); }
        });
    });

    function deleteMaterial(id) {
        if (!confirm("Are you sure?")) return;
        $.ajax({
            url: '@Url.Action("DeleteMaterial", "Staff")',
            type: 'POST',
            data: { id: id },
            success: function () { location.reload(); },
            error: function () { alert("Delete failed."); }
        });
    }
</script>