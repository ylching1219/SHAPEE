@model List<SHAPEE.Models.ChatMessage>
@{
    ViewData["Title"] = "Class Chat";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between">
        <h2>Chat: @ViewBag.ClassId (Test Mode: STF0002)</h2>
        <a href="@Url.Action("Dashboard")" class="btn btn-outline-secondary">Back</a>
    </div>
    <hr />

    <div id="chatWindow" style="height: 450px; overflow-y: auto; border: 1px solid #ddd; padding: 20px; background: #f8f9fa; border-radius: 8px;">
        @foreach (var m in Model)
        {
            bool isMe = m.SenderId == ViewBag.UserId;
            <div style="display: flex; justify-content: @(isMe ? "flex-end" : "flex-start"); margin-bottom: 15px;">
                <div style="padding: 10px 15px; border-radius: 15px; background: @(isMe ? "#007bff" : "#fff"); color: @(isMe ? "white" : "black"); border: 1px solid #ddd;">
                    <small><b>@m.SenderId</b></small>
                    <p style="margin:0;">@m.Content</p>
                    <small style="font-size:0.7rem; opacity:0.8;">@m.SentAt.ToString("HH:mm")</small>
                </div>
            </div>
        }
    </div>

    <form asp-action="Send" method="post" class="mt-3">
        <input type="hidden" name="classId" value="@ViewBag.ClassId" />
        <div class="input-group">
            <input type="text" name="content" id="msgContent" class="form-control" placeholder="Type a message..." required autocomplete="off" />
            <button type="submit" class="btn btn-primary">Send</button>
        </div>
    </form>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function refreshChat() {
        $.ajax({
            url: '@Url.Action("GetMessages", "Staff")',
            type: 'GET',
            success: function (data) {
                var chatWindow = $('#chatWindow');
                var html = '';

                data.forEach(function (m) {
                    var align = m.isMe ? 'flex-end' : 'flex-start';
                    var bg = m.isMe ? '#007bff' : '#fff';
                    var text = m.isMe ? 'white' : 'black';
                    var border = m.isMe ? 'none' : '1px solid #ddd';

                    html += `<div style="display: flex; justify-content: ${align}; margin-bottom: 15px;">
                                <div style="padding: 10px 15px; border-radius: 15px; background: ${bg}; color: ${text}; border: ${border};">
                                    <small><b>${m.sender}</b></small>
                                    <p style="margin:0;">${m.content}</p>
                                    <small style="font-size:0.7rem; opacity:0.8; display:block; text-align:right;">${m.time}</small>
                                </div>
                            </div>`;
                });

                chatWindow.html(html);
                chatWindow.scrollTop(chatWindow[0].scrollHeight);
            }
        });
    }

    // Auto-refresh every 3 seconds
    setInterval(refreshChat, 3000);

    // Initial scroll to bottom
    $(document).ready(function() {
        var chatWindow = $('#chatWindow');
        chatWindow.scrollTop(chatWindow[0].scrollHeight);
    });
</script>