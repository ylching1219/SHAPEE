@model List<SHAPEE.Models.Student>
@{
    ViewData["Title"] = "Class Chat";
}

<div class="container mt-4">
    @Html.AntiForgeryToken()
    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-users"></i> Students (@ViewBag.ClassId)</h5>
                </div>
                <div class="list-group list-group-flush" style="max-height: 550px; overflow-y: auto;">
                    @foreach (var student in Model)
                    {
                        var unreadCount = (ViewBag.UnreadCounts as Dictionary<string, int>)?.ContainsKey(student.Id) == true
                        ? (ViewBag.UnreadCounts as Dictionary<string, int>)[student.Id] : 0;

                        <a href="javascript:void(0)" onclick="loadStudentChat('@student.Id')"
                           class="list-group-item list-group-item-action" id="list-@student.Id">
                            <div class="d-flex w-100 justify-content-between align-items-center">
                                <h6 class="mb-1">@student.FirstName @student.LastName</h6>
                                @if (unreadCount > 0)
                                {
                                    <span class="badge bg-danger rounded-pill unread-badge">@unreadCount</span>
                                }
                            </div>
                            <small class="text-muted">@student.Id</small>
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom d-flex justify-content-between">
                    <h5 id="chatHeader">Select a student to start chatting</h5>
                    <a href="@Url.Action("StaffClassroomUI")" class="btn btn-sm btn-outline-secondary">Back</a>
                </div>

                <div class="card-body bg-light">
                    <div id="chatWindow" style="height: 400px; overflow-y: auto; padding: 15px; background: #fff; border-radius: 8px; border: 1px solid #eee;">
                    </div>

                    <div id="typingIndicator" style="height: 20px; font-size: 0.8rem; color: #6c757d;" class="mt-2"></div>

                    <div class="input-group mt-3">
                        <input type="text" id="msgContent" class="form-control" placeholder="Type a message..." disabled />
                        <button type="button" onclick="submitMessage()" id="sendBtn" class="btn btn-primary" disabled>Send</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var currentUserId = "@ViewBag.UserId";
    var selectedStudentId = "";
    var classId = "@ViewBag.ClassId";

     function loadStudentChat(studentId) {
        selectedStudentId = studentId;
        $('.list-group-item').removeClass('active');
        $('#list-' + studentId).addClass('active');
        $('#chatHeader').text("Chatting with " + studentId);
        $('#msgContent, #sendBtn').prop('disabled', false);

        // Mark messages as read when clicking the student
        markMessagesAsRead(studentId);

        refreshChat();
    }

    function markMessagesAsRead(studentId) {
        $.post('@Url.Action("MarkAsRead", "Staff")', { targetUserId: studentId });
    }

    function refreshChat() {
        if (!selectedStudentId) return;
        $.get('@Url.Action("GetMessages", "Staff")', { targetUserId: selectedStudentId }, function (data) {
            var html = '';
            data.forEach(function (m) {
                var isMe = (m.sender === currentUserId);
                var align = isMe ? 'flex-end' : 'flex-start';
                var bg = isMe ? '#007bff' : '#f1f0f0';
                var text = isMe ? 'white' : 'black';
                html += `<div style="display: flex; justify-content: ${align}; margin-bottom: 10px;">
                            <div style="padding: 8px 12px; border-radius: 12px; background: ${bg}; color: ${text}; max-width: 80%;">
                                <p style="margin:0;">${m.content}</p>
                                <small style="font-size:0.6rem; opacity:0.7; display:block; text-align:right;">${m.time}</small>
                            </div>
                         </div>`;
            });
            $('#chatWindow').html(html);
            $('#chatWindow').scrollTop($('#chatWindow')[0].scrollHeight);
        });
    }

         function submitMessage() {
        var content = $('#msgContent').val();

        //ensure user selected
        if (!content.trim() || !selectedStudentId) {
            alert("Please select a student first.");
            return;
        }

        $.ajax({
            url: '@Url.Action("Send", "Staff")', //ensure is staff
            type: 'POST',
            data: {
                receiverId: selectedStudentId,
                content: content,
                // handle security
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (response) {
                if (response.success) {
                    $('#msgContent').val('');
                    refreshChat();
                }
            },
            error: function(xhr) {
                console.error(xhr.responseText);
                alert("Error connecting to server.");
            }
        });
    }
    $(document).ready(function() {
        // Refresh every 3 seconds ONLY if a student conversation is open
        setInterval(function() {
            if (selectedStudentId !== "") {
                refreshChat();
            }
        }, 3000);
    });
</script>