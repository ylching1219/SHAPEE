@model SHAPEE.Models.AnnouncementManageVM
<form id="addEditForm" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" id="announcementId" name="id" value="@Model.EditAnnouncement?.Id" />
    <div class="modal-body">
        <div id="formErrorMessage" style="display:none;"></div>
        @if (Model.EditAnnouncement != null)
        {
            <div class="form-group" id="authorDisplayGroup">
                <label class="font-weight-medium">Author</label>
                <input type="text" class="form-control bg-light" id="displayAuthor"
                       value="@Model.EditAnnouncement.Author" disabled />
                <small class="form-text text-muted">Author cannot be changed for existing announcements.</small>
            </div>
        }
        <div class="form-group">
            <label for="title">Title <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="title" name="title"
                   maxlength="100" required placeholder="Enter announcement title"
                   value="@Model.EditAnnouncement?.Title">
            <small class="form-text text-muted">Cannot exceed 100 characters</small>
        </div>
        <div class="form-group">
            <label for="content">Content <span class="text-danger">*</span></label>
            <textarea class="form-control" id="content" name="content" rows="5"
                      maxlength="500" required placeholder="Enter announcement content"
                      style="resize: none; overflow-wrap: break-word; word-wrap: break-word; word-break: break-word;">@Model.EditAnnouncement?.Content</textarea>
            <small class="form-text text-muted">Cannot exceed 500 characters</small>
        </div>
        <div id="authorOptionsSection">
            @if (User.IsInRole("Staff"))
            {
                <div class="form-group">
                    <label>Post as:</label>
                    <div class="custom-control custom-checkbox">
                        <input type="checkbox" class="custom-control-input" id="useFacultyName"
                               name="useFacultyName" value="true">
                        <label class="custom-control-label" for="useFacultyName">
                            Use Faculty Name (@Model.Staff?.Faculty.Name)
                        </label>
                    </div>
                    <small class="form-text text-muted">
                        If unchecked, will post as: @Model.Staff?.FullName.Trim()
                    </small>
                </div>
            }
        </div>
    </div>
    <div class="modal-footer bg-light">
        <button class="btn btn-secondary" type="button" data-dismiss="modal">
            <i class="fas fa-times mr-1"></i> Cancel
        </button>
        <button class="btn btn-primary" type="submit" id="saveBtn">
            <i class="fas fa-save mr-1"></i> @(Model.EditAnnouncement != null ? "Update Announcement" : "Create Announcement")
        </button>
    </div>
</form>