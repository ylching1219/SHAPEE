@{
    ViewData["Title"] = "Welcome";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - TARUMT</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
    <link href="~/css/landing.css" rel="stylesheet">
</head>
<body>
    <div class="landing-container">
        <!-- Left Side -->
        <div class="left-side">
            <div class="logo-container">
                <div class="logo-icon">
                    <i class="fas fa-graduation-cap"></i>
                </div>
                <h1 class="university-name">TARUMT</h1>
                <p class="university-subtitle">University Management System</p>
                <a href="@Url.Action("Login", "Account")" class="login-button">
                    <i class="fas fa-sign-in-alt"></i> Login
                </a>
            </div>
        </div>

        <!-- Right Side -->
        <div class="right-side">
            <div class="content-slider">
                <!-- Slide 1: Welcome -->
                <div class="content-slide active">
                    <div class="slide-icon">
                        <i class="fas fa-hand-sparkles"></i>
                    </div>
                    <h2 class="slide-title">Welcome to TARUMT</h2>
                    <p class="slide-description">
                        Your comprehensive university management system designed to streamline academic operations, 
                        enhance student engagement, and simplify administrative tasks.
                    </p>
                </div>

                <!-- Slide 2: Features -->
                <div class="content-slide">
                    <div class="slide-icon">
                        <i class="fas fa-star"></i>
                    </div>
                    <h2 class="slide-title">Key Features</h2>
                    <ul class="slide-list">
                        <li>Real-time attendance tracking</li>
                        <li>Class management and scheduling</li>
                        <li>Comprehensive dashboard analytics</li>
                        <li>Secure user authentication</li>
                        <li>Multi-role access control</li>
                    </ul>
                </div>

                <!-- Slide 3: For Students -->
                <div class="content-slide">
                    <div class="slide-icon">
                        <i class="fas fa-user-graduate"></i>
                    </div>
                    <h2 class="slide-title">For Students</h2>
                    <ul class="slide-list">
                        <li>Join and manage your classes</li>
                        <li>View your attendance records</li>
                        <li>Track attendance history</li>
                        <li>Access course materials</li>
                        <li>Monitor your academic progress</li>
                    </ul>
                </div>

                <!-- Slide 4: For Teachers -->
                <div class="content-slide">
                    <div class="slide-icon">
                        <i class="fas fa-chalkboard-teacher"></i>
                    </div>
                    <h2 class="slide-title">For Teachers</h2>
                    <ul class="slide-list">
                        <li>Manage multiple classes efficiently</li>
                        <li>Take and record student attendance</li>
                        <li>Generate attendance reports</li>
                        <li>View class analytics and insights</li>
                        <li>Communicate with students</li>
                    </ul>
                </div>

                <!-- Slide 5: Benefits -->
                <div class="content-slide">
                    <div class="slide-icon">
                        <i class="fas fa-rocket"></i>
                    </div>
                    <h2 class="slide-title">Why Choose Us?</h2>
                    <ul class="slide-list">
                        <li>User-friendly interface</li>
                        <li>Mobile-responsive design</li>
                        <li>Secure and reliable platform</li>
                        <li>24/7 system availability</li>
                        <li>Continuous updates and improvements</li>
                    </ul>
                </div>

                <!-- Slide Indicators -->
                <div class="slide-indicators">
                    <span class="indicator active" data-slide="0"></span>
                    <span class="indicator" data-slide="1"></span>
                    <span class="indicator" data-slide="2"></span>
                    <span class="indicator" data-slide="3"></span>
                    <span class="indicator" data-slide="4"></span>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/slider.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.3/dist/sweetalert2.all.min.js"></script>
    <script src="~/js/app.js"></script>

   <script>
        //check url parameter for logout success
        if (new URLSearchParams(window.location.search).get('logout') === 'success') {
            SweetAlert.success(
                'Logout Successful!',
                'You have been successfully logged out.'
            );
            //clear the url paramter
            window.history.replaceState({}, '', window.location.pathname);
        }
    </script>
</body>
</html>
