@model List<Notification>
@{
    ViewData["Title"] = "Notifications";
    var filter = ViewBag.Filter as string ?? "all";
    var type = ViewBag.Type as string ?? "";
    var search = ViewBag.Search as string ?? "";
    var sort = ViewBag.Sort as string ?? "newest";
    var unreadCount = ViewBag.UnreadCount as int? ?? 0;
    var totalCount = ViewBag.TotalCount as int? ?? 0;

    string GetNotificationIcon(string title, string type)
    {
                var titleIcons = new Dictionary<string, string>
        {
            { "Password Reset Successful", "fas fa-lock" },
            { "Password Changed", "fas fa-lock" },
            { "New Invoice Generated", "fas fa-receipt" },
            { "Account Unlocked", "fas fa-unlock" },
            { "Payment Successful", "fas fa-wallet" },
            { "Payment Reminder", "fas fa-exclamation-triangle" },
            { "Account Locked - Payment Overdue", "fas fa-lock" },
            { "New Message from Student", "fas fa-comments" },
            { "New Message from Teacher", "fas fa-comments" },
            { "New Classwork Posted", "fas fa-file-alt" },
            { "New Announcement", "fas fa-bullhorn" },
            { "Leave Application Approved", "fas fa-check-circle" },
            { "Leave Application Rejected", "fas fa-times-circle" }
        };
        if (titleIcons.ContainsKey(title))
        {
            return titleIcons[title];
        }

        return type switch
        {
            "info" => "fas fa-info-circle",
            "success" => "fas fa-check-circle",
            "warning" => "fas fa-exclamation-triangle",
            "error" => "fas fa-times-circle",
            _ => "fas fa-bell"
        };
    }
}
<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800">Notifications</h1>
        <p class="text-muted small mt-2">View and manage your notifications</p>
    </div>
</div>

<!-- Filter Section -->
<div class="card shadow mb-4">
    <div class="card-body bg-light border-bottom">
        <form id="filterForm">
            <div class="row g-3">
                <!-- Status Filter -->
                <div class="col-12 col-md-2">
                    <select id="statusFilter" name="filter" class="form-control">
                        <option value="all" selected="@(filter == "all" ? "selected" : null)">All</option>
                        <option value="unread" selected="@(filter == "unread" ? "selected" : null)">Unread</option>
                        <option value="read" selected="@(filter == "read" ? "selected" : null)">Read</option>
                    </select>
                </div>

                <!-- Type Filter -->
                <div class="col-12 col-md-2">
                    <select id="typeFilter" name="type" class="form-control">
                        <option value="">All Types</option>
                        <option value="info" selected="@(type == "info" ? "selected" : null)">Info</option>
                        <option value="success" selected="@(type == "success" ? "selected" : null)">Success</option>
                        <option value="warning" selected="@(type == "warning" ? "selected" : null)">Warning</option>
                        <option value="error" selected="@(type == "error" ? "selected" : null)">Error</option>
                    </select>
                </div>

                <!-- Sort Filter -->
                <div class="col-12 col-md-2">
                    <select id="sortFilter" name="sort" class="form-control">
                        <option value="newest" selected="@(sort == "newest" ? "selected" : null)">Newest First</option>
                        <option value="oldest" selected="@(sort == "oldest" ? "selected" : null)">Oldest First</option>
                    </select>
                </div>

                <!-- Search Box -->
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-white">
                                <i class="fas fa-search text-muted"></i>
                            </span>
                        </div>
                        <input type="text"
                               id="notificationSearch"
                               name="search"
                               class="form-control"
                               placeholder="Search notifications..."
                               value="@search" />
                    </div>
                </div>

                <!-- Reset Button -->
                <div class="col-12 col-md-1">
                    <button type="button" id="resetFiltersBtn" class="btn btn-secondary w-100" title="Reset filters">
                        <i class="fas fa-undo"></i>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Action Bar -->
<div class="card shadow mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <span class="text-muted small" id="notificationCount">
                    @totalCount notification@(totalCount != 1 ? "s" : "")
                    @if (filter == "unread" && unreadCount > 0)
                    {
                        <span class="text-primary">(@unreadCount unread)</span>
                    }
                </span>
            </div>
            <button type="button" class="btn btn-sm btn-primary" id="markAllReadBtn">
                <i class="fas fa-check-double"></i> Mark All as Read
            </button>
        </div>
    </div>
</div>

<!-- Notification List -->
<div class="card shadow mb-4">
    <div class="card-body p-0">
        <div id="notificationListContainer" class="notification-list">
            @if (Model != null && Model.Any())
            {
                @foreach (var notification in Model)
                {
                    var itemClass = notification.IsRead ? "notification-item read" : "notification-item unread";
                    var iconClass = GetNotificationIcon(notification.Title, notification.Type); // Changed this line
                    var iconBgClass = $"icon {notification.Type}";
                    var timeAgo = GetRelativeTime(notification.CreatedAt);
                    var clickUrl = !string.IsNullOrEmpty(notification.ActionUrl) 
                        ? notification.ActionUrl 
                        : "#";

                    <a href="@clickUrl" class="@itemClass" 
                       data-notification-id="@notification.NotificationId"
                       onclick="markNotificationAsRead(@notification.NotificationId, event)">
                        <div class="@iconBgClass">
                            <i class="@iconClass"></i>
                        </div>
                        <div class="content">
                            <div class="title-row">
                                <span class="title">@notification.Title</span>
                                <span class="time">@timeAgo</span>
                            </div>
                            <div class="message">@notification.Message</div>
                        </div>
                        @if (!notification.IsRead)
                        {
                            <span class="unread-dot"></span>
                        }
                    </a>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-bell-slash fa-3x text-muted mb-3"></i>
                    <p class="text-muted mb-0">No notifications found</p>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    private string GetRelativeTime(DateTime dateTime)
    {
        var now = DateTime.Now;
        var diff = now - dateTime;
        var diffSec = (int)diff.TotalSeconds;
        var diffMin = (int)diff.TotalMinutes;
        var diffHour = (int)diff.TotalHours;
        var diffDay = (int)diff.TotalDays;

        if (diffSec < 60) return "just now";
        if (diffMin < 60) return $"{diffMin}m ago";
        if (diffHour < 24) return $"{diffHour}h ago";
        if (diffDay < 7) return $"{diffDay}d ago";
        return dateTime.ToString("MMM dd, yyyy");
    }
}

@section Scripts {
    <script>
        $(document).ready(function() {
            let isLoading = false;

            //function to load filtered notifications via AJAX
            function loadFilteredNotifications() {
                if (isLoading) return;
                isLoading = true;

                const filter = $('#statusFilter').val() || 'all';
                const type = $('#typeFilter').val() || '';
                const search = $('#notificationSearch').val() || '';
                const sort = $('#sortFilter').val() || 'newest';

                $.ajax({
                    url: '@Url.Action("GetFilteredNotifications", "Home")',
                    type: 'GET',
                    data: {
                        filter: filter,
                        type: type,
                        search: search,
                        sort: sort
                    },
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    success: function(response) {
                        if (response.success) {
                            renderNotifications(response.notifications);
                            updateNotificationCount(response.totalCount, response.unreadCount, filter);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Error loading notifications:', error);
                    },
                    complete: function() {
                        isLoading = false;
                    }
                });
            }

            //function to render notifications
            //function to render notifications
            function renderNotifications(notifications) {
                const container = $('#notificationListContainer');
                
                if (!notifications || notifications.length === 0) {
                    container.html(`
                        <div class="text-center py-5">
                            <i class="fas fa-bell-slash fa-3x text-muted mb-3"></i>
                            <p class="text-muted mb-0">No notifications found</p>
                        </div>
                    `);
                    return;
                }

                let html = '';
                notifications.forEach(function(n) {
                    const itemClass = n.isRead ? 'notification-item read' : 'notification-item unread';
                    const iconClass = getIconClass(n); // Pass the whole notification object
                    const iconBgClass = `icon ${n.type}`;
                    const unreadDot = n.isRead ? '' : '<span class="unread-dot"></span>';

                    html += `
                        <a href="${n.actionUrl}" class="${itemClass}" 
                           data-notification-id="${n.notificationId}"
                           onclick="markNotificationAsRead(${n.notificationId}, event)">
                            <div class="${iconBgClass}">
                                <i class="${iconClass}"></i>
                            </div>
                            <div class="content">
                                <div class="title-row">
                                    <span class="title">${escapeHtml(n.title)}</span>
                                    <span class="time">${n.timeAgo}</span>
                                </div>
                                <div class="message">${escapeHtml(n.message)}</div>
                            </div>
                            ${unreadDot}
                        </a>
                    `;
                });

                container.html(html);
            }

            //helper function to get icon class
            function getIconClass(notification) {
                //icon mapping for specific notification titles
                const titleIcons = {
                    'Password Reset Successful': 'fas fa-lock',
                    'Password Changed': 'fas fa-lock',
                    'New Invoice Generated': 'fas fa-receipt',
                    'Account Unlocked': 'fas fa-unlock',
                    'Payment Successful': 'fas fa-wallet',
                    'Payment Reminder': 'fas fa-exclamation-triangle', // Warning icon for reminders
                    'Account Locked - Payment Overdue': 'fas fa-lock',
                    'New Message from Student': 'fas fa-comments',
                    'New Message from Teacher': 'fas fa-comments',
                    'New Classwork Posted': 'fas fa-file-alt',
                    'New Announcement': 'fas fa-bullhorn',
                    'Leave Application Approved': 'fas fa-check-circle',
                    'Leave Application Rejected': 'fas fa-times-circle'
                };

                // Check if we have a specific icon for this title
                if (notification.title && titleIcons[notification.title]) {
                    return titleIcons[notification.title];
                }

                // Fallback to type-based icons
                const type = notification.type || 'info';
                const typeIcons = {
                    'info': 'fas fa-info-circle',
                    'success': 'fas fa-check-circle',
                    'warning': 'fas fa-exclamation-triangle',
                    'error': 'fas fa-times-circle'
                };
                return typeIcons[type] || 'fas fa-bell';
            }

            //helper function to escape HTML
            function escapeHtml(text) {
                const map = {
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#039;'
                };
                return text.replace(/[&<>"']/g, m => map[m]);
            }

            //function to update notification count
            function updateNotificationCount(totalCount, unreadCount, filter) {
                let countText = `${totalCount} notification${totalCount !== 1 ? 's' : ''}`;
                if (filter === 'unread' && unreadCount > 0) {
                    countText += ` <span class="text-primary">(${unreadCount} unread)</span>`;
                }
                $('#notificationCount').html(countText);
            }

            //event handlers for filters
            $('#statusFilter, #typeFilter, #sortFilter').on('change', function() {
                loadFilteredNotifications();
            });

            //search with debounce
            let searchTimer;
            $('#notificationSearch').on('keyup', function() {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(function() {
                    loadFilteredNotifications();
                }, 500);
            });

            //reset filters
            $('#resetFiltersBtn').on('click', function() {
                $('#statusFilter').val('all');
                $('#typeFilter').val('');
                $('#sortFilter').val('newest');
                $('#notificationSearch').val('');
                loadFilteredNotifications();
            });

                        //mark all as read
            $('#markAllReadBtn').on('click', function() {
                Swal.fire({
                    title: 'Mark All as Read?',
                    text: 'Are you sure you want to mark all notifications as read?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes, mark all as read',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("MarkAllAsRead", "Home")',
                            type: 'POST',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                            },
                            success: function() {
                                Swal.fire({
                                    title: 'Success!',
                                    text: 'All notifications have been marked as read.',
                                    icon: 'success',
                                    timer: 2000,
                                    showConfirmButton: false
                                });
                                loadFilteredNotifications();
                            },
                            error: function() {
                                Swal.fire({
                                    title: 'Error!',
                                    text: 'Failed to mark notifications as read. Please try again.',
                                    icon: 'error',
                                    confirmButtonText: 'OK'
                                });
                            }
                        });
                    }
                });
            });

            //mark single notification as read
            window.markNotificationAsRead = function(notificationId, event) {
                const $item = $(event.currentTarget);
                if ($item.hasClass('read')) {
                    return; 
                }

                $.ajax({
                    url: '@Url.Action("MarkAsRead", "Home")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ notificationId: notificationId }),
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function() {
                        $item.removeClass('unread').addClass('read');
                        $item.find('.unread-dot').remove();
                        // Reload to update counts
                        loadFilteredNotifications();
                    },
                    error: function() {
                        console.error('Error marking notification as read');
                    }
                });
            };
        });
    </script>
}