

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>@ViewData["Title"] - TARUMT</title>

    <link rel="icon" type="image/png" href="~/img/applogotarumt.png">

    <!--font-->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">

    <!--style-->
    <link href="~/css/sb-admin-2.min.css" rel="stylesheet">
    <link href="~/css/custom.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet">

    <!--Icon-->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    @RenderSection("Styles", required: false)
</head>

<body id="page-top">

    <div id="wrapper">
        @{
            var roles =
            User.Identity!.IsAuthenticated && User.IsInRole("Admin") ? "Admin" :
            User.Identity!.IsAuthenticated && User.IsInRole("Staff") ? "Staff" :
            User.Identity!.IsAuthenticated && User.IsInRole("Student") ? "Student" :
            null;
        }
        <!-- sidebar -->
        <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">
            <!-- Sidebar - Brand -->
            <a class="sidebar-brand d-flex align-items-center justify-content-center" href="@Url.Action("Dashboard", roles)">
                <div class="sidebar-brand-icon">
                    <img src="~/img/applogotarumt.png" alt="TARUMT Logo" class="sidebar-logo" />
                </div>
                <div class="sidebar-brand-text mx-3">TARUMT</div>
            </a>

            <!-- Divider -->
            <hr class="sidebar-divider my-0">

            <!-- Nav Item - Dashboard -->
            <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == roles ? "active" : "")">
                <a class="nav-link" href="@Url.Action("Dashboard", roles)">
                    <i class="fas fa-fw fa-tachometer-alt"></i>
                    <span>Dashboard</span>
                </a>
            </li>

            <!-- Divider -->
            <hr class="sidebar-divider">

            @if (User.Identity!.IsAuthenticated)
            {
                @if (User.IsInRole("Admin"))
                {
                    <!-- Admin Sidebar Content -->
                    <!-- Heading -->
                    <div class="sidebar-heading">
                        Administration
                    </div>

                    <!-- Nav Item - User Management -->
                    <li class="nav-item">
                        <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseUsers" aria-expanded="true" aria-controls="collapseUsers">
                            <i class="fas fa-fw fa-users"></i>
                            <span>User Management</span>
                        </a>
                        <div id="collapseUsers" class="collapse" aria-labelledby="headingUsers" data-parent="#accordionSidebar">
                            <div class="bg-white py-2 collapse-inner rounded">
                                <h6 class="collapse-header">Users</h6>
                                <a class="collapse-item" href="@Url.Action("StudentManagement", "Admin")">Manage Students</a>
                                <a class="collapse-item" href="@Url.Action("StaffManagement", "Admin")">Manage Staffs</a>
                                <a class="collapse-item" href="@Url.Action("AdminManagement", "Admin")">Manage Admins</a>
                            </div>
                        </div>
                    </li>

                    <!-- Nav Item - Class Management -->
                    <li class="nav-item">
                        <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseClasses" aria-expanded="true" aria-controls="collapseClasses">
                            <i class="fas fa-fw fa-book"></i>
                            <span>Class Management</span>
                        </a>
                        <div id="collapseClasses" class="collapse" aria-labelledby="headingClasses" data-parent="#accordionSidebar">
                            <div class="bg-white py-2 collapse-inner rounded">
                                <h6 class="collapse-header">Classes</h6>
                                <a class="collapse-item" href="/Admin/ClassSection">Create Class</a>
                                <a class="collapse-item" href="#">View All Classes</a>
                                <a class="collapse-item" href="#">Assign Teachers</a>
                                <a class="collapse-item" href="#">Class Schedule</a>
                            </div>
                        </div>
                    </li>

                    <!-- Nav Item - Faculty Management -->
                    <li class="nav-item">
                        <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseFaculty" aria-expanded="true" aria-controls="collapseFaculty">
                            <i class="fas fa-fw fa-book"></i>
                            <span>Academic Management</span>
                        </a>
                        <div id="collapseFaculty" class="collapse" aria-labelledby="headingFaculty" data-parent="#accordionSidebar">
                            <div class="bg-white py-2 collapse-inner rounded">
                                <h6 class="collapse-header">Faculty</h6>
                                <a class="collapse-item" href="/Admin/FacultyManagement">Manage Faculty</a>
                                <a class="collapse-item" href="/Admin/ProgramManagement">Manage Program</a>
                                <a class="collapse-item" href="/Admin/CourseManagement">Manage Course</a>
                                <a class="collapse-item" href="/Admin/ProgramCourse">Program Course</a>
                                <div class="dropdown-divider"></div>
                                <h6 class="collapse-header">Calendar</h6>
                                <a class="collapse-item" href="/Admin/EventManagement">Academic Calendar</a>
                            </div>
                        </div>
                    </li>

                    <!-- Nav Item - Group Management -->
                    <li class="nav-item">
                        <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseGroup" aria-expanded="true" aria-controls="collapseGroup">
                            <i class="fas fa-fw fa-book"></i>
                            <span>Group Management</span>
                        </a>
                        <div id="collapseGroup" class="collapse" aria-labelledby="groupFaculty" data-parent="#accordionSidebar">
                            <div class="bg-white py-2 collapse-inner rounded">
                                <h6 class="collapse-header">Group</h6>
                                <a class="collapse-item" href="/Admin/GroupManagement">Manage Group</a>
                                <a class="collapse-item" href="/Admin/AssignGroup">Assign Group</a>  
                            </div>
                        </div>
                    </li>

                    <!-- Nav Item - Room Management (NEW) -->
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("RoomManagement", "Admin")">
                            <i class="fas fa-fw fa-door-open"></i>
                            <span>Room Management</span>
                        </a>
                    </li>

                    <!-- Nav Item - Leave Management -->
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("LeaveManagement", "Admin")">
                            <i class="fas fa-fw fa-calendar-times"></i>
                            <span>Leave Applications</span>
                        </a>
                    </li>

                    <!-- Nav Item - Payment Management -->
                    <li class="nav-item">
                        <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapsePayments" aria-expanded="true" aria-controls="collapsePayments">
                            <i class="fas fa-fw fa-money-bill-wave"></i>
                            <span>Payment Management</span>
                        </a>
                        <div id="collapsePayments" class="collapse" aria-labelledby="headingPayments" data-parent="#accordionSidebar">
                            <div class="bg-white py-2 collapse-inner rounded">
                                <h6 class="collapse-header">Payments</h6>
                                <a class="collapse-item" href="@Url.Action("PaymentTransactions", "Admin")">Payment Transactions</a>
                                <a class="collapse-item" href="@Url.Action("PaymentMonitoring", "Admin")">Payment Monitoring</a>
                            </div>
                        </div>
                    </li>

                    <!-- Nav Item - Reports -->
                    <li class="nav-item">
                        <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseReports" aria-expanded="true" aria-controls="collapseReports">
                            <i class="fas fa-fw fa-chart-bar"></i>
                            <span>Reports & Analytics</span>
                        </a>
                        <div id="collapseReports" class="collapse" aria-labelledby="headingReports" data-parent="#accordionSidebar">
                            <div class="bg-white py-2 collapse-inner rounded">
                                <h6 class="collapse-header">Reports</h6>
                                <a class="collapse-item" href="#">Student Reports</a>
                                <a class="collapse-item" href="#">System Reports</a>
                            </div>
                        </div>
                    </li>

                    <!-- Divider -->
                    <hr class="sidebar-divider">

                    <!-- Heading -->
                    <div class="sidebar-heading">
                        System
                    </div>

                    <!-- Nav Item - System Settings -->
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="fas fa-fw fa-cog"></i>
                            <span>System Settings</span>
                        </a>
                    </li>

                    <!-- Nav Item - Activity Log -->
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="fas fa-fw fa-list"></i>
                            <span>Activity Log</span>
                        </a>
                    </li>
                }
                else if (User.IsInRole("Staff"))
                {
                    <!-- Staff Sidebar Content -->
                    <!-- Heading -->
                    <div class="sidebar-heading">
                        Teaching
                    </div>

                    <!-- Nav Item - My Classes -->
                    <li class="nav-item">
                        <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseMyClasses" aria-expanded="true" aria-controls="collapseMyClasses">
                            <i class="fas fa-fw fa-book"></i>
                            <span>My Classes</span>
                        </a>
                        <div id="collapseMyClasses" class="collapse" aria-labelledby="headingMyClasses" data-parent="#accordionSidebar">
                            <div class="bg-white py-2 collapse-inner rounded">
                                <h6 class="collapse-header">Classes</h6>
                                <a class="collapse-item" href="#">View My Classes</a>
                                <a class="collapse-item" href="#">Class Schedule</a>
                            </div>
                        </div>
                    </li>

                    <!-- Nav Item - Attendance -->
                    <li class="nav-item">
                        <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseAttendance" aria-expanded="true" aria-controls="collapseAttendance">
                            <i class="fas fa-fw fa-clipboard-check"></i>
                            <span>Attendance</span>
                        </a>
                        <div id="collapseAttendance" class="collapse" aria-labelledby="headingAttendance" data-parent="#accordionSidebar">
                            <div class="bg-white py-2 collapse-inner rounded">
                                <h6 class="collapse-header">Attendance</h6>
                                <a class="collapse-item" href="@Url.Action("ClassSelection", "Staff", new { mode = "take" })">
                                    Take Attendance
                                </a>
                                <a class="collapse-item" href="@Url.Action("ClassSelection", "Staff", new { mode = "view" })">
                                    View Attendance
                                </a>
                            </div>
                        </div>
                    </li>

                    <!-- Nav Item - Attendance Leave (Staff) -->
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("LeaveApplication", "Home")">
                            <i class="fas fa-fw fa-calendar-times"></i>
                            <span>Attendance Leave</span>
                        </a>
                    </li>

                    <!-- Nav Item - Students -->
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="fas fa-fw fa-user-graduate"></i>
                            <span>My Students</span>
                        </a>
                    </li>

                    <!-- Divider -->
                    <hr class="sidebar-divider">

                    <!-- Heading -->
                    <div class="sidebar-heading">
                        Resources
                    </div>

                    <!-- Nav Item - Materials -->
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("StaffClassroomUI", "Staff")">
                            <i class="fas fa-fw fa-file-alt"></i>
                            <span>Course Materials</span>
                        </a>
                    </li>
                    <!-- Nav Item - Ticket -->
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("StaffTicketList", "Staff")">
                            <i class="fas fa-fw fa-headset"></i>
                            <span>Support Tickets</span>
                        </a>
                    </li>
                    <!-- Nav Item - Grades -->
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("TaskList", "Staff")">
                            <i class="fas fa-fw fa-graduation-cap"></i>
                            <span>Assignments & Grading</span>
                        </a>
                    </li>

                    <!-- Nav Item - Academic Calendar -->
                    <li class="nav-item">
                        <a class="nav-link" href="/Staff/ViewCalendar">
                            <i class="fas fa-calendar"></i>
                            <span>Academic Calendar</span>
                        </a>
                    </li>
                }
                else if (User.IsInRole("Student"))
                {
                    <!-- Student Sidebar Content -->
                    <!-- Heading -->
                    <div class="sidebar-heading">
                        Academic
                    </div>

                    <!-- Nav Item - My Classes -->
                    <li class="nav-item">
                        <a class="nav-link collapsed" href="#" data-toggle="collapse" data-target="#collapseStudentClasses" aria-expanded="true" aria-controls="collapseStudentClasses">
                            <i class="fas fa-fw fa-book"></i>
                            <span>My Classes</span>
                        </a>
                        <div id="collapseStudentClasses" class="collapse" aria-labelledby="headingStudentClasses" data-parent="#accordionSidebar">
                            <div class="bg-white py-2 collapse-inner rounded">
                                <h6 class="collapse-header">Classes</h6>
                                <a class="collapse-item" href="#">Join Class</a>
                                <a class="collapse-item" href="#">View My Classes</a>
                                <a class="collapse-item" href="#">Class Schedule</a>
                            </div>
                        </div>
                    </li>

                    <!-- Nav Item - Attendance (DIRECT LINK - NO DROPDOWN) -->
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("ViewAttendance", roles)">
                            <i class="fas fa-fw fa-clipboard-check"></i>
                            <span>Attendance</span>
                        </a>
                    </li>

                    <!-- Nav Item - Attendance Leave -->
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("LeaveApplication", "Home")">
                            <i class="fas fa-fw fa-calendar-times"></i>
                            <span>Attendance Leave</span>
                        </a>
                    </li>

                    <!-- Nav Item - Grades -->
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="fas fa-fw fa-graduation-cap"></i>
                            <span>My Grades</span>
                        </a>
                    </li>

                    <!-- Divider -->
                    <hr class="sidebar-divider">

                    <!-- Heading -->
                    <div class="sidebar-heading">
                        Billing
                    </div>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("CurrentBilling", "Student")">
                            <i class="fas fa-fw fa-file-invoice-dollar"></i>
                            <span>Current Billing</span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("PaymentHistory", "Student")">
                            <i class="fas fa-fw fa-receipt"></i>
                            <span>Payment History</span>
                        </a>
                    </li>

                    <!-- Divider -->
                    <hr class="sidebar-divider">

                    <!-- Heading -->
                    <div class="sidebar-heading">
                        Resources
                    </div>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("ViewProgramCourse", "Student")">
                            <i class="fas fa-fw fa-file-alt"></i>
                            <span>View Program Course</span>
                        </a>
                    </li>

                    <!-- Nav Item - Classroom -->
                    <li class="nav-item">
                         <a class="nav-link" href="@Url.Action("ClassroomUI", "Student")">
                            <i class="fas fa-fw fa-file-alt"></i>
                            <span>Classroom</span>
                        </a>
                    </li>

                    <!-- Nav Item - Assignments -->
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <i class="fas fa-fw fa-tasks"></i>
                            <span>Assignments</span>
                        </a>
                    </li>

                    <!-- Nav Item - Academic Calendar -->
                    <li class="nav-item">
                        <a class="nav-link" href="/Student/ViewCalendar">
                            <i class="fas fa-calendar"></i>
                            <span>Academic Calendar</span>
                        </a>
                    </li>
                }
            }

            <!-- Divider -->
            <hr class="sidebar-divider d-none d-md-block">

        </ul>

        <!--content-->
        <div id="content-wrapper" class="d-flex flex-column">
            <!--main content-->
            <div id="content">
                <!--topbar-->
                <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">
                    <!-- Sidebar Toggle (Topbar) -->
                    <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                        <i class="fa fa-bars"></i>
                    </button>

                    <!-- Topbar Search -->
                    <form class="d-none d-sm-inline-block form-inline mr-auto ml-md-3 my-2 my-md-0 mw-100 navbar-search" style="position:relative;">
                        <div class="input-group">
                            <input type="text"
                                id="globalSearchInput"
                                class="form-control bg-light border-0 small"
                                placeholder="Search for..."
                                aria-label="Search">
                            <div class="input-group-append">
                                <button class="btn btn-primary" type="button" id="globalSearchBtn">
                                    <i class="fas fa-search fa-sm"></i>
                                </button>
                            </div>
                        </div>
                        <div id="globalSearchPanel" class="qs-panel d-none"></div>
                    </form>

                    <!-- Topbar Navbar -->
                    <ul class="navbar-nav ml-auto">
                        <!-- Nav Item - Search Dropdown (Visible Only XS) -->
                        <li class="nav-item dropdown no-arrow d-sm-none">
                            <a class="nav-link dropdown-toggle" href="#" id="searchDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="fas fa-search fa-fw"></i>
                            </a>
                            <!-- Dropdown - Messages -->
                            <div class="dropdown-menu dropdown-menu-right p-3 shadow animated--grow-in" aria-labelledby="searchDropdown">
                                <form class="form-inline mr-auto w-100 navbar-search">
                                    <div class="input-group">
                                        <input type="text" class="form-control bg-light border-0 small" placeholder="Search for..." aria-label="Search" aria-describedby="basic-addon2">
                                        <div class="input-group-append">
                                            <button class="btn btn-primary" type="button">
                                                <i class="fas fa-search fa-sm"></i>
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </li>

                        <!-- nav item - notifications -->
                        <li class="nav-item dropdown no-arrow mx-1">
                            <a class="nav-link dropdown-toggle position-relative" href="#" id="notificationsDropdown"
                            role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="fas fa-bell fa-fw"></i>
                                <span id="notificationBadge"
                                    class="badge badge-danger badge-counter" style="display: none;">0</span>
                            </a>

                            <div class="dropdown-menu dropdown-menu-right shadow notification-dropdown"
                                aria-labelledby="notificationsDropdown">

                                <!-- header -->
                                <div class="notification-header">
                                    <span class="title">Notification</span>
                                    <div class="actions">
                                        <a href="@Url.Action("Notifications", "Home")" title="expand">
                                            <i class="fas fa-expand"></i>
                                        </a>
                                        <button class="close-dropdown">&times;</button>
                                    </div>
                                </div>

                                <!-- tabs -->
                                <div class="notification-tabs">
                                    <button class="tab active" data-filter="all">All</button>
                                    <button class="tab" data-filter="unread">Unread</button>
                                </div>

                                <!-- list -->
                                <div class="notification-list" id="notificationList">
                                    <!-- AJAX-loaded notifications will appear here -->
                                    <div class="text-center py-4">
                                        <i class="fas fa-spinner fa-spin text-muted"></i>
                                        <p class="small text-muted mb-0 mt-2">Loading notifications...</p>
                                    </div>
                                </div>

                                <!-- footer -->
                                <div class="notification-footer">
                                    <a href="@Url.Action("Notifications", "Home")">View all notifications</a>
                                </div>
                            </div>
                        </li>


                        <div class="topbar-divider d-none d-sm-block"></div>

                        <!-- Nav Item - User Information -->
                        <li class="nav-item dropdown no-arrow">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span class="mr-2 d-none d-lg-inline text-gray-600 small">@User.Identity.Name</span>
                                <img class="img-profile rounded-circle" src="@(ViewBag.ProfilePictureUrl ?? "/img/undraw_profile.svg")" alt="Profile">
                            </a>
                            <!-- Dropdown - User Information -->
                            <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in" aria-labelledby="userDropdown">
                                <a class="dropdown-item" href="@Url.Action("Profile",roles)">
                                    <i class="fas fa-user fa-sm fa-fw mr-2 text-gray-400"></i>
                                    Profile
                                </a>
                                <a class="dropdown-item" href="#">
                                    <i class="fas fa-cogs fa-sm fa-fw mr-2 text-gray-400"></i>
                                    Settings
                                </a>
                                <a class="dropdown-item" href="#">
                                    <i class="fas fa-list fa-sm fa-fw mr-2 text-gray-400"></i>
                                    Activity Log
                                </a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" href="@Url.Action("Logout", "Account")">
                                    <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-gray-400"></i>
                                    Logout
                                </a>
                            </div>
                        </li>
                    </ul>
                </nav>
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>
            <!--footer-->
            <footer class="sticky-footer bg-white">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>Copyright &copy; TARUMT @DateTime.Now.Year</span>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!--scroll to top btn-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>
    <!--logout modal use when authentication is implemented-->
    <!-- <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Ready to Leave?</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">Select "Logout" below if you are ready to end your current session.</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                    <a class="btn btn-primary" href="@Url.Action("Login", "Account")">Logout</a>
                </div>
            </div>
        </div>
    </div> -->
    

    <script src="/js/jquery.min.js"></script>
    <!--jquery script-->
    <script src="/js/jquery.easing.min.js"></script>
    <script src="/js/jquery.unobtrusive-ajax.min.js"></script>
    <script src="/js/jquery.validate.min.js"></script>
    <script src="/js/jquery.validate.unobtrusive.min.js"></script>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>

    <!--sb admin template script-->
    <script src="/js/sb-admin-2.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script src="/js/app.js" asp-append-version="true"></script>


    @RenderSection("Scripts", required: false)

    <!-- Toast Notification Container -->
    <div id="toastContainer" class="toast-container"></div>
</body>
</html>
