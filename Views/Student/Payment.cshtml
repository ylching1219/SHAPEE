@model SHAPEE.Models.PaymentCheckoutVM

@{
    ViewData["Title"] = "Secure Checkout";
}

<style>
    /* ---------- GLOBAL ICON NORMALIZATION ---------- */
    i.fas, i.fab {
        line-height: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    /* ---------- STRIPE & PAYMENT ICONS ---------- */
    .icon-align {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .stripe-icon {
        font-size: 3.5rem;
        flex-shrink: 0;
    }

    .payment-icons {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .payment-icons i {
        font-size: 2rem;
        flex-shrink: 0;
    }

    .payment-icons .divider {
        height: 28px;
        border-left: 1px solid #dee2e6;
        margin: 0 0.5rem;
    }

    /* ---------- LAYOUT HEIGHT SYNC ---------- */
    .checkout-row {
        display: flex;
        align-items: stretch;
    }

    .checkout-left,
    .checkout-right {
        display: flex;
        flex-direction: column;
    }

    .checkout-left {
        height: 100%;
    }

    .checkout-right {
        height: 100%;
    }

    /* Stretch order summary */
    .order-summary {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .order-summary .card-body {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    /* Keep help card at bottom */
    .help-card {
        margin-top: 1rem;
    }

    /* ---------- PAYMENT CARD ---------- */
    .selected-payment-card {
        background-color: #f8f9fc !important;
        border: 2px solid #4e73df !important;
        border-radius: 0.75rem;
    }

    .card {
        border-radius: 0.75rem;
    }


    /* Make left column define height */
    .checkout-left {
        display: flex;
        flex-direction: column;
    }

    /* Allow payment card to stretch naturally */
    .checkout-left > .card:last-child {
        flex-grow: 1;
    }

</style>


<div class="mb-4">
    <h1 class="h3 mb-0 text-gray-900">Complete Your Payment</h1>
    <div class="small text-muted mt-1">
        Review your invoice and proceed with secure payment.
    </div>
</div>

<div class="row g-4 checkout-row">

    <!-- LEFT COLUMN -->
    <div class="col-lg-8 checkout-left">

        <!-- Invoice Summary -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body py-4 px-4">
                <div class="row g-3">
                    <div class="col-md-4 border-end-md">
                        <div class="text-uppercase text-xs text-muted fw-bold mb-1">Invoice Ref</div>
                        <div class="fw-bold text-gray-800">@Model.InvoiceId</div>
                        <div class="small text-muted">SemesterId: @Model.SemesterId</div>
                    </div>

                    <div class="col-md-4 border-end-md ps-md-4">
                        <div class="text-uppercase text-xs text-muted fw-bold mb-1">Due Date</div>
                        <div class="fw-bold text-gray-800">@Model.DueDate.ToString("dd MMM yyyy")</div>
                        <div class="small text-muted">
                            Status: <span class="text-danger fw-bold">Unpaid</span>
                        </div>
                    </div>

                    <div class="col-md-4 ps-md-4">
                        <div class="text-uppercase text-xs text-muted fw-bold mb-1">Total Due</div>
                        <div class="fw-bold text-primary fs-5">
                            RM @Model.TotalAmount.ToString("N2")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payment Method -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                <h6 class="mb-0 fw-bold text-primary">
                    Payment Method
                </h6>
            </div>

            <div class="card-body p-4">
                <form asp-action="Pay" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="invoiceId" value="@Model.InvoiceId" />
                    <input type="hidden" name="paymentMethod" value="Stripe" />

                    <div class="mb-4">
                        <div class="selected-payment-card p-4">

                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="icon-align">
                                    <i class="fab fa-stripe text-primary stripe-icon"></i>
                                    <span class="h5 fw-bold text-gray-800 mb-0">
                                        Secure Checkout
                                    </span>
                                </div>
                                <i class="fas fa-check-circle fa-2x text-primary"></i>
                            </div>

                            <p class="text-muted small mb-3">
                                Complete your payment securely using Credit/Debit Card
                                (Visa, Mastercard) or FPX Online Banking.
                            </p>

                            <div class="payment-icons opacity-75">
                                <i class="fab fa-cc-visa text-dark"></i>
                                <i class="fab fa-cc-mastercard text-dark"></i>
                                <div class="divider"></div>
                                <i class="fas fa-university text-dark"></i>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between pt-2">
                        <a asp-action="CurrentBilling"
                           class="text-decoration-none text-secondary fw-bold small">
                            <i class="fas fa-arrow-left me-1"></i> Cancel
                        </a>

                        <button type="submit"
                                class="btn btn-primary px-5 fw-bold shadow-sm">
                            Proceed to Stripe
                            <i class="fas fa-external-link-alt ms-2"></i>
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="col-lg-4 checkout-right">

        <!-- Order Summary -->
        <div class="card border-0 shadow-sm mb-3 order-summary">
            <div class="card-header bg-light border-0 py-3">
                <h6 class="mb-0 fw-bold text-gray-800">Order Summary</h6>
            </div>

            <div class="card-body">
                <div class="d-flex justify-content-between small mb-2">
                    <span class="text-muted">Invoice Ref</span>
                    <span class="fw-bold">@Model.InvoiceId</span>
                </div>

                <div class="d-flex justify-content-between small mb-4">
                    <span class="text-muted">SemesterId</span>
                    <span>@Model.SemesterId</span>
                </div>

                <div class="border rounded bg-light p-3 mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="fw-bold">Tuition Fees</span>
                        <span class="fw-bold">
                            RM @Model.TotalAmount.ToString("N2")
                        </span>
                    </div>

                    @if (Model.TotalCredits > 0 && Model.CostPerCreditHour > 0)
                    {
                        <div class="d-flex justify-content-between small text-muted">
                            <span>Rate per credit</span>
                            <span>RM @Model.CostPerCreditHour.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between small text-muted">
                            <span>Total credits</span>
                            <span>@Model.TotalCredits</span>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                    <span class="h6 fw-bold mb-0">Total Due</span>
                    <span class="h4 fw-bold text-primary mb-0">
                        RM @Model.TotalAmount.ToString("N2")
                    </span>
                </div>
            </div>
        </div>

    </div>
</div>
