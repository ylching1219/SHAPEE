@{
    ViewData["Title"] = "View Attendance";
    var sectionId = ViewData["SectionId"] as string;
    var qrToken = ViewData["QrToken"] as string;
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Take Attendance</h6>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <button type="button" class="btn btn-success mr-2" id="btnScanQr">
                <i class="fas fa-qrcode"></i> Scan QR
            </button>
            <button type="button" class="btn btn-primary" id="btnEnterCode">
                <i class="fas fa-keyboard"></i> Enter Code
            </button>
        </div>

        <!-- QR Scanner Panel -->
        <div id="qrPanel" class="border rounded p-3 mb-3" style="display:none;">
            <h6 class="font-weight-bold mb-2">Scan QR Code</h6>
            <div id="qrReader" style="width: 100%; max-width: 350px;"></div>
            <small class="text-muted d-block mt-2">
                Allow camera access, then point your device at the QR code shown by your lecturer.
            </small>
        </div>

        <!-- Manual Code Panel -->
        <div id="codePanel" class="border rounded p-3" style="display:none;">
            <h6 class="font-weight-bold mb-2">Enter Attendance Code</h6>
            <form method="post" asp-action="SubmitAttendance" asp-controller="Student" class="form-inline">
                <div class="form-group mr-2 mb-2">
                    <label for="manualCodeInput" class="sr-only">Manual Code</label>
                    <input type="text" class="form-control" id="manualCodeInput"
                           name="manualCode" placeholder="Enter code (e.g. A 7 X 9)" required />
                </div>
                <button type="submit" class="btn btn-primary mb-2">
                    <i class="fas fa-check"></i> Submit Code
                </button>
            </form>
        </div>
    </div>
</div>

<!-- Add this message container right after the TempData message section -->
<div id="dynamicMessageContainer" style="display:none;"></div>

@if (TempData["AttendanceMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["AttendanceMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (!string.IsNullOrEmpty(sectionId))
{
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Quick Attendance</h6>
            <span class="badge badge-info">Section: @sectionId</span>
        </div>
        <div class="card-body">
            <form method="post" asp-action="SubmitAttendance" asp-controller="Student" class="form-inline">
                <input type="hidden" name="sectionId" value="@sectionId" />
                <input type="hidden" name="qrToken" value="@qrToken" />

                <button type="submit" class="btn btn-success mr-3"
                        @(string.IsNullOrEmpty(qrToken) ? "disabled" : "")>
                    <i class="fas fa-qrcode"></i> Confirm via QR
                </button>

                <div class="form-group mr-2">
                    <label for="manualCodeInput" class="sr-only">Manual Code</label>
                    <input type="text" class="form-control" id="manualCodeInput"
                           name="manualCode" placeholder="Enter code (e.g. A 7 X 9)" />
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-keyboard"></i> Submit Code
                </button>
            </form>

            <small class="text-muted d-block mt-2">
                This section was opened from a QR code. You can confirm directly or use the backup code.
            </small>
        </div>
    </div>
}

@section Styles {
    <link href="~/css/attendance.css" rel="stylesheet" />
}

