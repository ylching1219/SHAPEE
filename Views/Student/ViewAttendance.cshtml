@section Scripts {
    <!-- HTML5 QR Code library -->
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

    <script>
        // Existing filter hooks (keep or extend)
        document.getElementById('subjectFilter').addEventListener('change', function () {
            // Filter logic
        });

        document.getElementById('monthFilter').addEventListener('change', function () {
            // Filter logic
        });

        document.getElementById('statusFilter').addEventListener('change', function () {
            // Filter logic
        });

        // NEW: Take Attendance UI
        const btnScanQr = document.getElementById('btnScanQr');
        const btnEnterCode = document.getElementById('btnEnterCode');
        const qrPanel = document.getElementById('qrPanel');
        const codePanel = document.getElementById('codePanel');

        let html5QrScanner = null;

        btnScanQr.addEventListener('click', function () {
            qrPanel.style.display = 'block';
            codePanel.style.display = 'none';

            if (!html5QrScanner) {
                html5QrScanner = new Html5Qrcode("qrReader");
                Html5Qrcode.getCameras().then(devices => {
                    if (devices && devices.length) {
                        const cameraId = devices[0].id;
                        html5QrScanner.start(
                            cameraId,
                            { fps: 10, qrbox: 250 },
                            onQrSuccess,
                            onQrError
                        );
                    }
                }).catch(err => {
                    console.error(err);
                    alert("Unable to access camera.");
                });
            }
        });

        btnEnterCode.addEventListener('click', function () {
            codePanel.style.display = 'block';
            qrPanel.style.display = 'none';
            if (html5QrScanner) {
                html5QrScanner.stop().catch(() => { });
                html5QrScanner = null;
            }
        });

        function onQrSuccess(decodedText, decodedResult) {
            // Expect the QR to contain a URL like /Student/ViewAttendance?sectionId=...&token=...
            try {
                const url = new URL(decodedText, window.location.origin);
                const sectionId = url.searchParams.get("sectionId");
                const token = url.searchParams.get("token");

                if (!sectionId || !token) {
                    alert("Invalid QR code.");
                    return;
                }

                // Auto-submit via fetch to SubmitAttendance
                fetch('@Url.Action("SubmitAttendance", "Student")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: new URLSearchParams({
                        sectionId: sectionId,
                        qrToken: token
                    })
                }).then(r => {
                    if (!r.ok) {
                        return r.text().then(t => { throw new Error(t); });
                    }
                    return r.text();
                }).then(_ => {
                    alert("Attendance recorded successfully.");
                    // Optionally stop scanner after success
                    if (html5QrScanner) {
                        html5QrScanner.stop().catch(() => { });
                        html5QrScanner = null;
                    }
                    qrPanel.style.display = 'none';
                }).catch(err => {
                    console.error(err);
                    alert("Failed to record attendance: " + err.message);
                });
            } catch (e) {
            console.error(e);
                alert("Invalid QR data.");
            }
        }

        function onQrError(err) {
            // You can log or ignore scan errors; they fire frequently
        }
    </script>
}