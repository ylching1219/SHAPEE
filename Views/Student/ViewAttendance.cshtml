@model StudentAttendanceVM
@{
    ViewData["Title"] = "View Attendance";
}
<style>
.date-pill {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    border: 1px solid #e9ecef;
    background: #f8f9fc;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    color: #4e73df;
    line-height: 1.1;
}
.date-pill .month {
    font-size: 11px;
    letter-spacing: 1px;
}

/* Align pill and text vertically */
.list-group-item .d-flex.align-items-start {
    align-items: center;      /* center pill with text block */
    gap: 14px;                /* consistent spacing */
}

/* Slight downward nudge for the pill */
.date-pill {
    margin-top: 2px;
}

/* Spacing for attendance row header and status */
.list-group-item .d-flex.justify-content-between.align-items-start.flex-wrap.gap-2 {
    margin-top: 10px;
    margin-bottom: 10px;
}
</style>

<!-- Page Heading: Take Attendance -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800">Take Attendance</h1>
        <p class="text-muted small mt-2">Scan the QR or enter the code to mark your attendance.</p>
    </div>
</div>

<!-- Take Attendance Section -->
<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Take Attendance</h6>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <button type="button" class="btn btn-success mr-2" id="btnScanQr">
                <i class="fas fa-qrcode"></i> Scan QR
            </button>
            <button type="button" class="btn btn-primary" id="btnEnterCode">
                <i class="fas fa-keyboard"></i> Enter Code
            </button>
        </div>

        <!-- QR Scanner Panel -->
        <div id="qrPanel" class="border rounded p-3 mb-3" style="display:none;">
            <h6 class="font-weight-bold mb-2">Scan QR Code</h6>
            <div id="qrReader" style="width: 100%; max-width: 350px;"></div>
            <small class="text-muted d-block mt-2">
                Allow camera access, then point your device at the QR code shown by your lecturer.
            </small>
        </div>

        <!-- Manual Code Panel -->
        <div id="codePanel" class="border rounded p-3" style="display:none;">
            <h6 class="font-weight-bold mb-2">Enter Attendance Code</h6>
            <form method="post" asp-action="SubmitAttendance" asp-controller="Student" class="form-inline">
                <div class="form-group mr-2 mb-2">
                    <label for="manualCodeInput" class="sr-only">Manual Code</label>
                    <input type="text" class="form-control" id="manualCodeInput"
                           name="manualCode" placeholder="Enter code (e.g. A 7 X 9)" required />
                </div>
                <button type="submit" class="btn btn-primary mb-2">
                    <i class="fas fa-check"></i> Submit Code
                </button>
            </form>
        </div>
    </div>
</div>

<div id="dynamicMessageContainer" style="display:none;"></div>

@if (TempData["AttendanceMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["AttendanceMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.SectionId))
{
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Quick Attendance</h6>
            <span class="badge badge-info">Section: @Model.SectionId</span>
        </div>
        <div class="card-body">
            <form method="post" asp-action="SubmitAttendance" asp-controller="Student" class="form-inline">
                <input type="hidden" name="sectionId" value="@Model.SectionId" />
                <input type="hidden" name="qrToken" value="@Model.QrToken" />

                <button type="submit" class="btn btn-success mr-3"
                        @(string.IsNullOrEmpty(Model.QrToken) ? "disabled" : "")>
                    <i class="fas fa-qrcode"></i> Confirm via QR
                </button>

                <div class="form-group mr-2">
                    <label for="manualCodeInput" class="sr-only">Manual Code</label>
                    <input type="text" class="form-control" id="manualCodeInput"
                           name="manualCode" placeholder="Enter code (e.g. A 7 X 9)" />
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-keyboard"></i> Submit Code
                </button>
            </form>

            <small class="text-muted d-block mt-2">
                This section was opened from a QR code. You can confirm directly or use the backup code.
            </small>
        </div>
    </div>
}

<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800">View Attendance</h1>
        <p class="text-muted small mt-2">Track your class attendance and performance</p>
    </div>
</div>

<!-- Filter Section -->
<div class="card shadow mb-4">
    <div class="card-body bg-light border-bottom">
        <div class="row g-3">
            <div class="col-12 col-md-2">
                <select id="subjectFilter" class="form-control">
                    <option value="">All Subjects</option>
                    @foreach (var s in Model.AvailableSubjects)
                    {
                        <option value="@s.CourseId">@s.CourseName</option>
                    }
                </select>
            </div>

            <div class="col-12 col-md-2">
                <select id="classTypeFilter" class="form-control">
                    <option value="">All Types</option>
                    <option value="Lecture">Lecture</option>
                    <option value="Tutorial">Tutorial</option>
                    <option value="Practical">Practical</option>
                </select>
            </div>

            <div class="col-12 col-md-2">
                <select id="monthFilter" class="form-control">
                    <option value="">All Months</option>
                    @foreach (var m in Model.AvailableMonths)
                    {
                        <option value="@($"{m.Year}-{m.Month:D2}")">
                            @m.DisplayText
                        </option>
                    }
                </select>
            </div>

            <div class="col-12 col-md-5">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text bg-white">
                            <i class="fas fa-search text-muted"></i>
                        </span>
                    </div>
                    <input type="text"
                           id="searchBox"
                           class="form-control"
                           placeholder="Search subject or section..." />
                </div>
            </div>

            <div class="col-12 col-md-1">
                <button type="button" class="btn btn-secondary w-100" id="resetFilters" title="Reset filters">
                    <i class="fas fa-undo"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Attendance Table -->
<div class="row">
    <div class="col-12 mb-4">
        <div class="card shadow">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Attendance Table</h6>
            </div>
           <div class="card-body">
                <div id="attendanceContainer">
                    <partial name="_AttendanceTable" model="Model" />
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Recent Attendance Records -->
<div class="row">
    <div class="col-12">
        <div class="card shadow">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Recent Attendance Records</h6>
            </div>
            <div class="card-body">
                @if (Model.RecentAttendances == null || !Model.RecentAttendances.Any())
                {
                    <div class="text-center py-5">
                        <i class="fas fa-clipboard-list fa-3x text-muted mb-3"></i>
                        <p class="text-muted">No recent attendance records found.</p>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var attendance in Model.RecentAttendances)
                        {
                            bool isPresent = attendance.Status == "Present";
                            bool isLeave = attendance.Status == "Leave";

                            var statusClass = isPresent ? "success"
                                            : isLeave  ? "warning"
                                            : "danger";

                            var statusText = isPresent ? "Present"
                                            : isLeave  ? "Leave"
                                            : "Absent";

                            <div class="list-group-item py-3">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="date-pill text-center">
                                        <div class="day">@attendance.Date.Day</div>
                                        <div class="month">@attendance.Date.ToString("MMM").ToUpper()</div>
                                    </div>

                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                            <div>
                                                <h6 class="mb-1 fw-bold">
                                                    @attendance.ClassSection.Course.Id - @attendance.ClassSection.Course.Name
                                                </h6>
                                                <div class="text-muted small mb-1">
                                                    @(attendance.ClassSection.Room?.Id ?? "N/A") •
                                                    @attendance.ClassSection.StartTime.ToString("HH:mm") - @attendance.ClassSection.EndTime.ToString("HH:mm")
                                                </div>
                                            </div>
                                            <span class="badge badge-@statusClass px-3 py-2">@statusText</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Attendance Details Modal -->
<div class="modal fade" id="attendanceDetailsModal" tabindex="-1" role="dialog" aria-labelledby="attendanceDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="attendanceDetailsModalLabel">Attendance Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="attendanceDetailsContent">
                <div class="text-center py-4">
                    <i class="fas fa-spinner fa-spin fa-2x text-primary"></i>
                    <p class="mt-2">Loading attendance details...</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- HTML5 QR Code library -->
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

    <script>
        //load attendance
        function loadAttendance() {
            $.get('@Url.Action("ViewAttendance", "Student")', {
                subject: $('#subjectFilter').val(),
                month: $('#monthFilter').val(),
                search: $('#searchBox').val(),
                classType: $('#classTypeFilter').val()
            }, function (html) {
                $('#attendanceContainer').html(html);
            });
        }

        $('#subjectFilter, #classTypeFilter, #monthFilter').on('change', loadAttendance); // include classTypeFilter
        $('#searchBox').on('keyup', loadAttendance);

        //take att
        const btnScanQr = document.getElementById('btnScanQr');
        const btnEnterCode = document.getElementById('btnEnterCode');
        const qrPanel = document.getElementById('qrPanel');
        const codePanel = document.getElementById('codePanel');

        let html5QrScanner = null;

        //show success or error msg
        function showMessage(message, isSuccess = true) {
            const messageContainer = document.getElementById('dynamicMessageContainer');
            if (!messageContainer) return;
            
            const alertClass = isSuccess ? 'alert-success' : 'alert-danger';
            messageContainer.innerHTML = `
                <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            `;
            messageContainer.style.display = 'block';
            messageContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            
            if (isSuccess) {
                setTimeout(() => {
                    const alert = messageContainer.querySelector('.alert');
                    if (alert) {
                        alert.classList.remove('show');
                        setTimeout(() => {
                            messageContainer.style.display = 'none';
                        }, 150);
                    }
                }, 5000);
            }
        }

        //submit attendance via AJAX
        function submitAttendance(data, onSuccess, onError) {
            const formData = new FormData();
            Object.keys(data).forEach(key => {
                if (data[key]) formData.append(key, data[key]);
            });
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');

            showMessage("Processing...", true);

            return fetch('@Url.Action("SubmitAttendance", "Student")', {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                },
                body: formData
            })
            .then(response => {
                const contentType = response.headers.get("content-type");
                if (contentType && contentType.includes("application/json")) {
                    return response.json();
                }
                if (!response.ok) {
                    return response.text().then(text => {
                        throw new Error(text || 'Failed to submit attendance');
                    });
                }
                window.location.reload();
                return null;
            })
            .then(data => {
                if (!data) return;
                
                if (data.success) {
                    showMessage(data.message || "Attendance recorded successfully!", true);
                    if (onSuccess) onSuccess();
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    showMessage(data.message || "Failed to record attendance.", false);
                    if (onError) onError();
                }
            })
            .catch(err => {
                let errorMsg = err.message;
                if (errorMsg.includes('BadRequest')) {
                    errorMsg = errorMsg.split('BadRequest')[1]?.trim() || 'Invalid request';
                } else if (errorMsg.length > 200) {
                    errorMsg = "Failed to record attendance. Please check your code and try again.";
                }
                showMessage(errorMsg || "Failed to record attendance. Please try again.", false);
                if (onError) onError();
            });
        }

        //form submissions go to SubmitAttendance
        $(document).on('submit', 'form[action*="SubmitAttendance"]', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            const form = $(this);
            const formData = new FormData(this);
            const data = {
                sectionId: formData.get('sectionId') || null,
                qrToken: formData.get('qrToken') || null,
                manualCode: formData.get('manualCode') || null
            };
            
            const submitBtn = form.find('button[type="submit"]:focus, button[type="submit"]').first();
            const originalHtml = submitBtn.html();
            submitBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Processing...');
            
            const resetButton = () => {
                submitBtn.prop('disabled', false).html(originalHtml);
            };
            
            submitAttendance(data, 
                () => {
                    $('#codePanel, #qrPanel').hide();
                    resetButton();
                },
                () => {
                    resetButton();
                }
            );
            
            return false;
        });

        //scan qr code
        btnScanQr.addEventListener('click', function () {
            qrPanel.style.display = 'block';
            codePanel.style.display = 'none';
            if (!html5QrScanner) {
                html5QrScanner = new Html5Qrcode("qrReader");
                Html5Qrcode.getCameras().then(devices => {
                    if (devices && devices.length) {
                        let cameraId = devices[0].id;
                        for (const d of devices) {
                            const label = (d.label || '').toLowerCase();
                            if (label.includes('back') || label.includes('rear') || label.includes('environment')) {
                                cameraId = d.id;
                                break;
                            }
                        }
                        html5QrScanner.start(cameraId, { 
                            fps: 10, 
                            qrbox: { width: 250, height: 250 },
                            aspectRatio: 1.0
                        }, onQrSuccess).catch(err => {
                            showMessage("Failed to start camera: " + err.message, false);
                        });
                    }
                }).catch(err => {
                    showMessage("Unable to access camera: " + err.message, false);
                });
            }
        });

        //enter code button
        btnEnterCode.addEventListener('click', function () {
            codePanel.style.display = 'block';
            qrPanel.style.display = 'none';
            if (html5QrScanner) {
                html5QrScanner.stop().catch(() => { });
                html5QrScanner = null;
            }
        });

        function onQrSuccess(decodedText, decodedResult) {
            if (html5QrScanner) {
                html5QrScanner.stop().catch(() => { });
                html5QrScanner = null;
            }

            try {
                let sectionId = null, token = null;

                if (decodedText.includes('http://') || decodedText.includes('https://')) {
                    const url = new URL(decodedText);
                    sectionId = url.searchParams.get("sectionId");
                    token = url.searchParams.get("token");
                } else if (decodedText.includes('sectionId=') && decodedText.includes('token=')) {
                    const params = new URLSearchParams(decodedText.split('?')[1] || decodedText);
                    sectionId = params.get("sectionId");
                    token = params.get("token");
                } else {
                    const match = decodedText.match(/sectionId=([^&]+).*token=([^&]+)/);
                    if (match) {
                        sectionId = match[1];
                        token = match[2];
                    }
                }

                if (!sectionId || !token) {
                    showMessage("Invalid QR code format. Expected: sectionId and token parameters.", false);
                    return;
                }

                const qrReaderDiv = document.getElementById('qrReader');
                qrReaderDiv.innerHTML = '<div class="text-center p-3"><i class="fas fa-spinner fa-spin fa-2x"></i><br>Processing...</div>';

                submitAttendance({ sectionId, qrToken: token }, 
                    () => {
                        qrPanel.style.display = 'none';
                        qrReaderDiv.innerHTML = '';
                    },
                    () => {
                        qrPanel.style.display = 'none';
                        qrReaderDiv.innerHTML = '';
                    }
                );

            } catch (e) {
                showMessage("Error processing QR code: " + e.message, false);
                qrPanel.style.display = 'none';
                document.getElementById('qrReader').innerHTML = '';
            }
        }

        $('#resetFilters').on('click', function() {
        $('#subjectFilter').val('');
        $('#classTypeFilter').val('');
        $('#monthFilter').val('');
        $('#searchBox').val('');
        loadAttendance();
    });

        //view details button click
        $(document).on('click', '.view-details-btn', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            const sectionId = $(this).data('section-id');
            if (!sectionId) {
                console.error('Section ID not found');
                return;
            }

            //show modal
            $('#attendanceDetailsModal').modal('show');

            //reset modal content to loading state
            $('#attendanceDetailsContent').html(`
                <div class="text-center py-4">
                    <i class="fas fa-spinner fa-spin fa-2x text-primary"></i>
                    <p class="mt-2">Loading attendance details...</p>
                </div>
            `);

            //load attendance details
            $.ajax({
                url: '@Url.Action("GetAttendanceDetails", "Student")',
                type: 'GET',
                data: { sectionId: sectionId },
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                success: function(html) {
                    $('#attendanceDetailsContent').html(html);
                },
                error: function(xhr, status, error) {
                    console.error('Error loading attendance details:', error);
                    $('#attendanceDetailsContent').html(`
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle"></i> 
                            Error loading attendance details. Please try again.
                        </div>
                    `);
                }
            });
        });

    </script>
}