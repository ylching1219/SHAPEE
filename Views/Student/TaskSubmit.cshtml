@model SHAPEE.Models.CourseTask

@{
    ViewData["Title"] = "Submit Assignment";
}

<div class="container mt-4">
    <div class="mb-3">
        <a href="@Url.Action("TaskList", "Student")" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> Back to Assignments
        </a>
    </div>

    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">@Model.Title</h2>
            <small>Course: @Model.ClassSection.Course.Name (@Model.ClassSectionId)</small>
        </div>

        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-8">
                    <h5>Instructions:</h5>
                    <p class="text-muted">@Model.Description</p>

                    @if (Model.Materials != null && Model.Materials.Any())
                    {
                        <div class="mt-4">
                            <h6 class="fw-bold"><i class="fas fa-paperclip"></i> Reference Materials:</h6>
                            <ul class="list-group list-group-flush">
                                @foreach (var taskMat in Model.Materials)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center bg-light border rounded mb-2">
                                        <span>@taskMat.Material.Title</span>
                                        <a href="@taskMat.Material.FileUrl" target="_blank" class="btn btn-sm btn-outline-info">
                                            <i class="fas fa-file-download"></i> View File
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
                <div class="col-md-4 border-left">
                    <h5>Deadline:</h5>
                    <p class="text-danger font-weight-bold">
                        <i class="fas fa-clock"></i> @Model.DueDate.ToString("dd MMM yyyy, hh:mm tt")
                    </p>
                </div>
            </div>

            <hr />

            @* --- Submission Logic --- *@
            @if (ViewBag.Submitted != null)
            {
                <div class="alert alert-success">
                    <h5 class="alert-heading"><i class="fas fa-check-circle"></i> Assignment Submitted</h5>
                    <p>Submitted on: @ViewBag.Submitted.SubmittedAt.ToString("g")</p>
                    <a href="@Url.Content(ViewBag.Submitted.FileUrl)" target="_blank" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-download"></i> Download My Submission
                    </a>

                    @if (ViewBag.Submitted.Grade != null)
                    {
                        <div class="mt-3 p-3 bg-white rounded border text-dark">
                            <span class="badge bg-info text-dark">Grade: @ViewBag.Submitted.Grade/100</span>
                            <p class="mt-2 mb-0"><strong>Feedback:</strong> @ViewBag.Submitted.Feedback</p>
                        </div>
                    }
                </div>
            }
            else if (ViewBag.IsLate)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-triangle"></i> The deadline has passed. Submissions are closed.
                </div>
            }
            else
            {
                @* Using asp-helpers for secure and accurate routing *@
                <form enctype="multipart/form-data" method="post"
                      asp-action="Upload"
                      asp-controller="Student"
                      asp-route-id="@Model.Id">

                    @Html.AntiForgeryToken()

                    <div class="form-group mb-3">
                        <label class="font-weight-bold mb-2">Upload Submission (PDF/DOCX):</label>
                        <input class="form-control" type="file" name="file" required />
                    </div>

                    <button type="submit" class="btn btn-success px-5">
                        <i class="fas fa-upload"></i> Submit Assignment
                    </button>
                </form>
            }
        </div>
    </div>
</div>