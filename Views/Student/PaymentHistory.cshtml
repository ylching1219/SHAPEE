@model SHAPEE.Models.PaymentHistoryVM

@{
    ViewData["Title"] = "Payment History";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Payment History</h1>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3 bg-white d-flex align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">Transaction Logs</h6>

        <div class="dropdown no-arrow">
            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown">
                <i class="fas fa-calendar mr-1"></i> Year
            </button>
            <div class="dropdown-menu shadow" aria-labelledby="dropdownMenuButton">
                <span class="dropdown-item-text text-muted small">Optional filter (not implemented)</span>
            </div>
        </div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3">Receipt ID</th>
                        <th class="py-3">Invoice Ref</th>
                        <th class="py-3">Date Paid</th>
                        <th class="py-3">Method</th>
                        <th class="py-3 text-end">Amount</th>
                        <th class="py-3 text-center">Status</th>
                        <th class="pe-4 py-3 text-end">Receipt</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Transactions == null || !Model.Transactions.Any())
                    {
                        <tr>
                            <td class="ps-4 py-4 text-muted" colspan="7">No payment transactions yet.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var t in Model.Transactions)
                        {
                            <tr>
                                <td class="ps-4 font-family-monospace fw-bold text-gray-800">#@t.ReceiptId</td>
                                <td>
                                    <span class="d-block small text-primary">@t.InvoiceId</span>
                                    <small class="text-muted">SemesterId: @t.SemesterId</small>
                                </td>
                                <td>@t.TransactionDate.ToString("dd MMM yyyy")</td>
                                <td>@t.PaymentMethod</td>
                                <td class="text-end fw-bold">RM @t.AmountPaid.ToString("N2")</td>
                                <td class="text-center"><span class="badge bg-success">Paid</span></td>
                                <td class="pe-4 text-end">
                                    <a asp-action="DownloadReceipt"
                                    asp-route-id="@t.ReceiptId"
                                    target="_blank"
                                    class="btn btn-sm btn-outline-primary shadow-sm px-3">
                                        Download
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>