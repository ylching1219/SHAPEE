@model SHAPEE.Models.PaymentHistoryVM

@{
    ViewData["Title"] = "Payment History";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Payment History</h1>
</div>

<div class="card shadow mb-4">
    <!-- Card Header -->
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Transaction Logs</h6>
    </div>

    <!-- Filter Section: same pattern as ViewAttendance -->
    <div class="card-body bg-light border-bottom">
        <div class="row g-3">
            <div class="col-12 col-md-2">
                <select id="dateFilter" class="form-control">
                    <option value="">All Dates</option>
                    <option value="last30">Last 30 days</option>
                    @foreach (var year in Model.Transactions
                        .Select(t => t.TransactionDate.Year)
                        .Distinct()
                        .OrderByDescending(y => y))
                    {
                        <option value="@year">@year</option>
                    }
                </select>
            </div>

            <div class="col-12 col-md-2">
                <select id="amountFilter" class="form-control">
                    <option value="">All Amounts</option>
                    <option value="lt500">Below RM 500</option>
                    <option value="500to1000">RM 500 – RM 1,000</option>
                    <option value="gt1000">Above RM 1,000</option>
                </select>
            </div>

            <div class="col-12 col-md-2">
                <button id="resetFilters" class="btn btn-secondary w-100" type="button">
                    <i class="fas fa-undo"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="card-body p-0">
        <div class="table-responsive" id="paymentHistoryContainer">
            <partial name="_PaymentHistory" model="Model" />
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function loadPayments() {
            $.get('@Url.Action("PaymentHistory", "Student")', {
                dateFilter: $('#dateFilter').val(),
                amountFilter: $('#amountFilter').val()
            }, function (html) {
                $('#paymentHistoryContainer').html(html);
            });
        }

        $('#dateFilter, #amountFilter').on('change', loadPayments);

        $('#resetFilters').on('click', function () {
            $('#dateFilter').val('');
            $('#amountFilter').val('');
            loadPayments();
        });
    </script>
}