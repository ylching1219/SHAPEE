@model SHAPEE.Models.Announcement

@if (Model == null)
{
    <div class="text-center text-muted py-5">
        <i class="fas fa-exclamation-circle fa-3x mb-3 d-block"></i>
        <p class="mb-0">Announcement not found</p>
    </div>
}
else
{
    <div class="announcement-details">
        <!-- Title -->
        <div class="mb-4">
            <h4 class="font-weight-bold text-gray-900 mb-3">
                @Model.Title
            </h4>

            <!-- Badges -->
            <div class="mb-3">
                @{
                    var isRecent = (DateTime.Now - Model.CreatedAt).TotalDays <= 3;
                    var isUpdated = Model.UpdatedAt.HasValue &&
                    (DateTime.Now - Model.UpdatedAt.Value).TotalDays <= 3;
                }

                @if (isRecent)
                {
                    <span class="badge badge-success mr-2">
                        <i class="fas fa-star mr-1"></i>New
                    </span>
                }

                @if (isUpdated)
                {
                    <span class="badge badge-info mr-2">
                        <i class="fas fa-sync-alt mr-1"></i>Recently Updated
                    </span>
                }
            </div>
        </div>

        <!-- Author & Date Info -->
        <div class="bg-light rounded p-3 mb-4">
            <div class="row">
                <div class="col-12 mb-3">
                    <div class="d-flex align-items-center">
                        <div class="icon-circle bg-primary text-white mr-3"
                             style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border-radius: 50%;">
                            <i class="fas fa-user-tie"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">Posted by</small>
                            <strong class="text-gray-900">@Model.Author</strong>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <hr class="my-2">
                </div>

                <div class="col-6">
                    <small class="text-muted d-block">
                        <i class="fas fa-calendar-plus mr-1"></i>Created
                    </small>
                    <small class="font-weight-medium text-gray-900">
                        @Model.CreatedAt.ToString("dd MMM yyyy")
                    </small>
                    <br>
                    <small class="text-muted">
                        @Model.CreatedAt.ToString("hh:mm tt")
                    </small>
                </div>

                @if (Model.UpdatedAt.HasValue)
                {
                    <div class="col-6">
                        <small class="text-muted d-block">
                            <i class="fas fa-edit mr-1"></i>Last Updated
                        </small>
                        <small class="font-weight-medium text-gray-900">
                            @Model.UpdatedAt.Value.ToString("dd MMM yyyy")
                        </small>
                        <br>
                        <small class="text-muted">
                            @Model.UpdatedAt.Value.ToString("hh:mm tt")
                        </small>
                    </div>
                }
            </div>
        </div>

        <!-- Content -->
        <div class="mb-4">
            <h6 class="font-weight-semibold text-gray-800 mb-3">
                <i class="fas fa-align-left mr-2 text-primary"></i>Message
            </h6>
            <div class="border-left border-primary pl-3">
                <p class="text-gray-700 mb-0" style="line-height: 1.8; white-space: pre-wrap;">@Model.Content</p>
            </div>
        </div>

        <!-- Additional Info Card -->
        <div class="alert alert-info border-0" role="alert">
            <div class="d-flex align-items-start">
                <i class="fas fa-info-circle mr-3 mt-1"></i>
                <div>
                    <strong class="d-block mb-1">Important Notice</strong>
                    <small>
                        Please make sure you read and understand all announcements.
                        If you have any questions, contact your program coordinator.
                    </small>
                </div>
            </div>
        </div>

    </div>
}

<style>
    .announcement-details {
        animation: fadeIn 0.3s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .icon-circle {
        flex-shrink: 0;
    }
</style>