@model List<SHAPEE.Models.ChatMessage>
@{
    ViewData["Title"] = "Class Chat";
}

<div class="container mt-4">
    @Html.AntiForgeryToken()
    <div class="d-flex justify-content-between align-items-center">
        <h2>Chat: @ViewBag.ClassId <small class="text-muted">(Student View)</small></h2>
        <a href="@Url.Action("Dashboard", "Student")" class="btn btn-outline-secondary">Back</a>
    </div>
    <hr />

    <div class="mb-3">
        <div class="input-group">
            <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
            <input type="text" id="chatSearch" class="form-control border-start-0" placeholder="Search messages..." autocomplete="off" />
        </div>
    </div>

    <div id="chatWindow" style="height: 400px; overflow-y: auto; border: 1px solid #ddd; padding: 20px; background: #f8f9fa; border-radius: 8px; position: relative;">
    </div>

    <div id="typingIndicator" style="height: 25px; font-size: 0.85rem; color: #6c757d; font-style: italic; padding-left: 10px;">
    </div>

    <form id="sendForm" class="mt-1">
        <div class="input-group">
            <input type="text" id="msgContent" class="form-control" placeholder="Type a message..." required autocomplete="off" />
            <button type="button" onclick="submitMessage()" class="btn btn-primary">Send</button>
        </div>
    </form>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    var currentUserId = "@ViewBag.UserId";
    var classId = "@ViewBag.ClassId";

    function refreshChat() {
        var searchTerm = $('#chatSearch').val();
        $.ajax({
            url: '@Url.Action("GetMessages", "Student")',
            type: 'GET',
            data: { search: searchTerm },
            success: function (data) {
                var chatWindow = $('#chatWindow');
                var html = '';
                data.forEach(function (m) {
                    var isMe = (m.sender === currentUserId);
                    var align = isMe ? 'flex-end' : 'flex-start';
                    var bg = isMe ? '#007bff' : '#fff';
                    var text = isMe ? 'white' : 'black';
                    var border = isMe ? 'none' : '1px solid #ddd';

                    html += `<div style="display: flex; justify-content: ${align}; margin-bottom: 15px;">
                                <div style="padding: 10px 15px; border-radius: 15px; background: ${bg}; color: ${text}; border: ${border}; max-width: 75%;">
                                    <small><b>${m.sender}</b></small>
                                    <p style="margin:0;">${m.content}</p>
                                    <small style="font-size:0.7rem; opacity:0.8; display:block; text-align:right;">${m.time}</small>
                                </div>
                            </div>`;
                });
                chatWindow.html(html);
                if (!searchTerm) { chatWindow.scrollTop(chatWindow[0].scrollHeight); }
            }
        });
    }

      function submitMessage() {
        var content = $('#msgContent').val();
        if (!content.trim()) return;

        $.ajax({
            url: '@Url.Action("Send", "Student")',
            type: 'POST',
            data: {
                classId: classId,
                content: content,
                // This line fixes the "Error connecting to server" (Security Token)
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function (response) {
                if (response.success) {
                    $('#msgContent').val('');
                    refreshChat();
                } else {
                    alert("Server rejected the message.");
                }
            },
            error: function(xhr) {
                // Check console (F12) to see if it's a 400 or 500 error
                console.error(xhr.responseText);
                alert("Error connecting to server.");
            }
        });
    }

    // Reuse the typing polling from StaffController
    function checkTypingStatus() {
        $.get('@Url.Action("GetTypingStatus", "Staff")', { classId: classId }, function(data) {
            if (data.isTyping) {
                $('#typingIndicator').text(data.users.join(", ") + " is typing...");
            } else {
                $('#typingIndicator').text("");
            }
        });
    }

    function sendTypingNotification() {
        $.post('@Url.Action("SetTyping", "Staff")', { classId: classId });
    }

    $(document).ready(function() {
        refreshChat();
        $('#chatSearch').on('keyup', refreshChat);
        $('#msgContent').on('keypress', function (e) {
            if (e.which == 13) { e.preventDefault(); submitMessage(); }
            else { sendTypingNotification(); }
        });

        setInterval(refreshChat, 3000);
        setInterval(checkTypingStatus, 2000);
    });
</script>