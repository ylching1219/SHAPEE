@model StudentDashboardVM
@using System.Text.Json
@{
    ViewData["Title"] = "Student Dashboard";
}

@section Styles {
    <link href="~/css/student-dashboard.css" rel="stylesheet" />
    <style>
        .subject-attendance-item {
            cursor: pointer;
            transition: all 0.2s ease;
            position: relative;
            padding-left: 15px;
        }

            .subject-attendance-item:hover {
                background-color: #f8f9fa;
                transform: translateX(2px);
            }

            .subject-attendance-item.active {
                background-color: #e7f3ff;
                border-left: 3px solid #007bff;
                padding-left: 15px;
            }

        .clickable-hint {
            font-size: 0.75rem;
            color: #6c757d;
            font-style: italic;
            margin-bottom: 10px;
        }

            .clickable-hint i {
                margin-right: 4px;
            }


         .attendance-chart-container {
            position: relative; /* needed for overlay positioning */
        }

        .attendance-overlay {
            position: absolute;
            inset: 0; /* top:0; right:0; bottom:0; left:0; */
            background: rgba(255, 255, 255, 0.85);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 1.5rem;
            z-index: 10;
        }

        .attendance-overlay i {
            font-size: 2.5rem;
            margin-bottom: 0.75rem;
            color: #6c757d;
        }
        .attendance-percentage {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 32px;
            font-weight: bold;
            /* no color here; JS sets it */
        }
    </style>
}

<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Student Dashboard</h1>
</div>

<!-- Content Row -->
<div class="row">
    <!-- Today's Schedule Card -->
    <div class="col-lg-7 mb-4">
        <div class="card shadow dashboard-card">
            <div class="card-body">
                <h4 class="font-weight-bold mb-3">Today's Schedule</h4>
                <p class="text-muted small mb-4">24 Nov 2025</p>

                <!-- Schedule Items -->
                <div class="schedule-item absent">
                    <span class="status-badge badge-absent">Absent</span>
                    <h6 class="font-weight-bold mb-2">BMCS2084 Data Structure and Algorithms</h6>
                    <p class="text-muted small mb-1">Block K – K103</p>
                    <p class="text-muted small">8.00 AM – 10.00 AM</p>
                </div>

                <div class="schedule-item completed">
                    <span class="status-badge badge-completed">Completed</span>
                    <h6 class="font-weight-bold mb-2">BMCS2068 Web Design and Development</h6>
                    <p class="text-muted small mb-1">DK Buildings – DKABA</p>
                    <p class="text-muted small">11.00 AM – 1.00 PM</p>
                </div>

                <div class="schedule-item inprogress">
                    <span class="status-badge badge-inprogress">Inprogress</span>
                    <h6 class="font-weight-bold mb-2">BMCS1024 Discrete Structure</h6>
                    <p class="text-muted small mb-1">Block B – B001G</p>
                    <p class="text-muted small">3.30 PM – 5.00 PM</p>
                </div>

                <!-- Legend -->
                <div class="mt-4 pt-3 border-top">
                    <div class="legend-item">
                        <span class="legend-dot normal"></span>
                        <span class="small">Normal</span>
                    </div>
                    <div class="legend-item">
                        <span class="legend-dot delay"></span>
                        <span class="small">Delay</span>
                    </div>
                    <div class="legend-item">
                        <span class="legend-dot cancelled"></span>
                        <span class="small">Cancelled</span>
                    </div>
                </div>

                <div class="text-right mt-3">
                    <a href="@Url.Action("ViewAttendance", "Student")" class="small text-primary">View More</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Attendance Overview Card -->
    <div class="col-lg-5 mb-4">
        <div class="card shadow dashboard-card">
            <div class="card-body">
                <h4 class="font-weight-bold mb-4">Attendance Overview</h4>
                <p class="text-muted small mb-3" id="selectedSubjectName">No subject selected</p>

                <div class="attendance-chart-container">
                    <!-- Donut Chart -->
                    <div class="attendance-chart">
                        <canvas id="attendanceChart" width="200" height="200"></canvas>
                        <div class="attendance-percentage" id="attendancePercentage">0%</div>
                    </div>

                    <!-- Overall Statistics -->
                    <div class="attendance-stats">
                        <p class="mb-2"><strong>Present:</strong> <span id="presentDays">0</span> days</p>
                        <p class="mb-2"><strong>Absent:</strong> <span id="absentDays">0</span> days</p>
                        <p class="mb-0"><strong>Leave:</strong> <span id="leaveDays">0</span> days</p>
                    </div>

                    @if (Model.SubjectAttendances == null || !Model.SubjectAttendances.Any())
                    {
                        <div class="attendance-overlay">
                            <i class="fas fa-clipboard-list"></i>
                            <p class="text-muted mb-1">No attendance records yet.</p>
                            <p class="text-muted small">
                                Once you start attending classes, your subjects attendance will appear here.
                            </p>
                        </div>
                    }
                </div>

                <!-- Subject-wise Attendance Breakdown -->
                <p class="clickable-hint">
                    <i class="fas fa-hand-pointer"></i>
                    Click on a subject to view its attendance chart
                </p>
                <div class="subject-attendance-list">
                    @for (var i = 0; i < Model.SubjectAttendances.Count; i++)
                    {
                        var s = Model.SubjectAttendances[i];
                        var cssClass = s.Percentage >= 80 ? "excellent" : "danger";

                        <div class="subject-attendance-item @(i == 0 ? "active" : "")"
                            data-subject="@i"
                            onclick="updateAttendanceChart(@i)">
                            <div class="subject-name">
                                <div>@s.CourseName</div>
                                <span class="subject-code">@s.CourseId</span>
                            </div>
                            <div>
                                <div class="subject-percentage @cssClass">@s.Percentage%</div>
                                <div class="subject-progress">
                                    <div class="subject-progress-bar @cssClass" style="width: @s.Percentage%"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <p class="text-muted small mb-3 mt-3">Nice work, keep going!</p>

                <div class="text-right">
                    <a href="@Url.Action("ViewAttendance", "Student")" class="small text-primary">View Details</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Content Row -->
<div class="row">
    <!-- Latest Announcements Card -->
    <div class="col-lg-6 mb-4">
        <div class="card shadow dashboard-card">
            <div class="card-body">
                <h4 class="font-weight-bold mb-4">Latest Announcements</h4>

                <!-- Announcement Items -->
                <div class="announcement-item important">
                    <div class="announcement-header">
                        <h6 class="announcement-title">
                            Final Examination Schedule Released
                            <span class="announcement-badge important">Important</span>
                        </h6>
                        <span class="announcement-date">20 Nov 2025</span>
                    </div>
                    <p class="announcement-content">
                        The final examination schedule for Semester 1, 2025/2026 has been released. Please check your student portal for your exam timetable. All exams will be conducted from 2nd to 15th December 2025.
                    </p>
                </div>

                <div class="announcement-item info">
                    <div class="announcement-header">
                        <h6 class="announcement-title">
                            Library Extended Hours
                            <span class="announcement-badge info">Info</span>
                        </h6>
                        <span class="announcement-date">18 Nov 2025</span>
                    </div>
                    <p class="announcement-content">
                        The main library will have extended operating hours during the examination period. The library will be open from 7:00 AM to 11:00 PM from Monday to Sunday, starting from 1st December.
                    </p>
                </div>

                <div class="announcement-item warning">
                    <div class="announcement-header">
                        <h6 class="announcement-title">
                            Fee Payment Reminder
                            <span class="announcement-badge warning">Reminder</span>
                        </h6>
                        <span class="announcement-date">15 Nov 2025</span>
                    </div>
                    <p class="announcement-content">
                        This is a friendly reminder that the deadline for Semester 2 fee payment is 30th November 2025. Please ensure your payment is made before the deadline to avoid late charges.
                    </p>
                </div>

                <div class="announcement-item">
                    <div class="announcement-header">
                        <h6 class="announcement-title">Student Portal Maintenance</h6>
                        <span class="announcement-date">12 Nov 2025</span>
                    </div>
                    <p class="announcement-content">
                        The student portal will undergo scheduled maintenance on 25th November 2025 from 2:00 AM to 6:00 AM. During this time, the portal will be temporarily unavailable. We apologize for any inconvenience caused.
                    </p>
                </div>

                <div class="text-right mt-3">
                    <a href="#" class="small text-primary">View All Announcements</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions Card -->
    <div class="col-lg-6 mb-4">
        <div class="card shadow dashboard-card">
            <div class="card-body">
                <h4 class="font-weight-bold mb-4">Quick Actions</h4>

                <div class="quick-actions-container">
                    <div class="row g-3">
                        <div class="col-6">
                            <button class="btn btn-primary w-100 quick-action-btn" onclick="alert('Feature coming soon!')">
                                <i class="fas fa-dollar-sign"></i>
                                <span>Pay Fees</span>
                            </button>
                        </div>
                        <div class="col-6">
                            <button class="btn btn-success w-100 quick-action-btn" onclick="location.href='@Url.Action("ViewAttendance", "Dashboard")'">
                                <i class="fas fa-calendar-check"></i>
                                <span>Attendance</span>
                            </button>
                        </div>
                        <div class="col-6">
                            <button class="btn btn-warning w-100 quick-action-btn" onclick="alert('Feature coming soon!')">
                                <i class="fas fa-graduation-cap"></i>
                                <span>Join Class</span>
                            </button>
                        </div>
                        <div class="col-6">
                            <button class="btn btn-info w-100 quick-action-btn" onclick="alert('Feature coming soon!')">
                                <i class="fas fa-book"></i>
                                <span>View Results</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <script>
        // Subject data
            const subjectsData = @Html.Raw(JsonSerializer.Serialize(
            Model.SubjectAttendances.Select(s => new {
                name = s.CourseName,
                code = s.CourseId,
                percentage = s.Percentage,
                present = s.Present,
                absent = s.Absent,
                leave = s.Leave
            })
        ));

        let attendanceChart;

        // Initialize chart on page load
        document.addEventListener('DOMContentLoaded', function() {
            var ctx = document.getElementById('attendanceChart');
            if (!ctx || subjectsData.length === 0) return;

                const first = subjectsData[0];

                attendanceChart = new Chart(ctx.getContext('2d'), {
                    type: 'doughnut',
                    data: {
                        datasets: [{
                            data: [first.percentage, 100 - first.percentage],
                            backgroundColor: ['#28a745', '#e9ecef'],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        cutout: '75%',
                        responsive: true,
                        maintainAspectRatio: true,
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                enabled: false
                            }
                        }
                    }
                });

            updateAttendanceChart(0);
        });

        // Function to update chart when subject is clicked
        function updateAttendanceChart(subjectIndex) {
        const subject = subjectsData[subjectIndex];

        // Update chart data
        attendanceChart.data.datasets[0].data = [subject.percentage, 100 - subject.percentage];

        // Decide color based on percentage
        let color = '#28a745'; // green by default
        if (subject.percentage < 80) {
            color = '#dc3545'; // red if below 80%
        }

        // Apply color to chart ring
        attendanceChart.data.datasets[0].backgroundColor = [color, '#e9ecef'];
        attendanceChart.update();

        // Apply color to central percentage text
        const percentEl = document.getElementById('attendancePercentage');
        percentEl.style.color = color;

        // Update text values
        document.getElementById('selectedSubjectName').textContent = subject.name;
        percentEl.textContent = subject.percentage + '%';
        document.getElementById('presentDays').textContent = subject.present;
        document.getElementById('absentDays').textContent = subject.absent;
        document.getElementById('leaveDays').textContent = subject.leave;

        // Active row
        document.querySelectorAll('.subject-attendance-item').forEach(item => item.classList.remove('active'));
        document.querySelector(`[data-subject="${subjectIndex}"]`).classList.add('active');
    }
    </script>
}