@model StudentTimetableVM

@if (!Model.ClassSections.Any())
{
    <p class="text-muted text-center">No course materials available.</p>
}
else
{
    var groupedCourses = Model.ClassSections
        .GroupBy(cs => cs.Course.Id)
        .Select(g => new
        {
            Course = g.First().Course,
            Sessions = g.ToList()
        })
        .OrderBy(x => x.Course.Id)
        .ToList();

    <div class="table-responsive">
        <table class="table table-bordered table-sm">
            <thead class="bg-light">
                <tr>
                    <th style="width: 5%;">No</th>
                    <th style="width: 30%;">Course</th>
                    <th style="width: 35%;">Day & Time (Duration)</th>
                    <th style="width: 15%;">Venue</th>
                    <th style="width: 15%;">Lecturer/Instructor</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < groupedCourses.Count; i++)
                {
                    var item = groupedCourses[i];
                    var course = item.Course;
                    var sessions = item.Sessions;

                    // Calculate average attendance percentage for this course
                    var courseSectionIds = sessions.Select(s => s.SectionId).ToList();
                    var coursePercentages = courseSectionIds
                    .Where(id => Model.AttendancePercentages.ContainsKey(id))
                    .Select(id => Model.AttendancePercentages[id])
                    .ToList();

                    var avgAttendance = coursePercentages.Any()
                    ? Math.Round(coursePercentages.Average(), 1)
                    : 0;

                    var attendanceClass = avgAttendance >= 80 ? "badge-success" :
                    avgAttendance >= 60 ? "badge-warning" : "badge-danger";

                    var colors = new[] { "#e74c3c", "#3498db", "#2ecc71", "#f39c12", "#9b59b6", "#1abc9c" };
                    var courseColor = colors[i % colors.Length];

                    <tr>
                        <td class="text-center">@(i + 1)</td>
                        <td>
                            <span class="badge course-badge @attendanceClass">
                                @avgAttendance%
                            </span>
                            <strong>@course.Id</strong> @course.Name
                        </td>
                        <td>
                            @foreach (var session in sessions.OrderBy(s => s.Day))
                            {
                                var duration = (session.EndTime.ToTimeSpan() - session.StartTime.ToTimeSpan()).TotalHours;
                                <div class="mb-1">
                                    <strong>@session.Day</strong>,
                                    @session.StartTime.ToString("h:mm tt") - @session.EndTime.ToString("h:mm tt")
                                    ( @session.SectionType: @duration.ToString("0.0") hours )
                                </div>
                            }
                        </td>
                        <td>
                            @foreach (var session in sessions.OrderBy(s => s.Day))
                            {
                                <div class="mb-1">@(session.Room?.Id ?? "TBA")</div>
                            }
                        </td>
                        <td>
                            @foreach (var session in sessions.OrderBy(s => s.Day))
                            {
                                var staffName = session.Staff != null
                                ? $"{session.Staff.FirstName} {session.Staff.LastName}"
                                : "TBA";
                                <div class="mb-1">@staffName (Weekly)</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}