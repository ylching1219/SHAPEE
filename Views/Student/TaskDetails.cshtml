@model SHAPEE.Models.CourseTask

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h1 class="display-6">@Model.Title</h1>
                    <p class="text-muted">
                        <i class="bi bi-calendar-event"></i> Due: @Model.DueDate.ToString("f")
                    </p>
                    <hr />
                    <p style="white-space: pre-wrap;">@Model.Description</p>

                    <h5 class="mt-4">Attached Materials</h5>
                    <ul class="list-group">
                        @foreach (var tm in Model.Materials)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                @tm.Material.Title
                                <a href="@tm.Material.FileUrl" class="btn btn-sm btn-outline-primary" download>
                                    Download
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-primary">
                <div class="card-header bg-primary text-white">
                    Submit Your Work
                </div>
                <div class="card-body">
                    <form method="post" asp-action="SubmitTask" enctype="multipart/form-data">
                        <input type="hidden" name="CourseTaskId" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label">Upload File (PDF/Zip)</label>
                            <input type="file" name="file" class="form-control" required />
                        </div>

                        <button type="submit" class="btn btn-success w-100">
                            Upload Submission
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>