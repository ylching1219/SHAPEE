@model StudentAttendanceDetailsVM

@if (Model == null || Model.Course == null)
{
    <div class="alert alert-danger">Attendance details not found.</div>
}
else
{
    <div class="mb-3">
        <h6 class="font-weight-bold">@Model.Course.Name</h6>
        <p class="text-muted small mb-0">
            <strong>Code:</strong> @Model.Course.Id | 
            <strong>Section:</strong> @Model.ClassSection.SectionId | 
            <strong>Semester:</strong> @Model.Semester.Id
        </p>
    </div>
    
    <div class="row mb-3">
        <div class="col-md-3">
            <div class="text-center p-2 border rounded">
                <div class="h4 mb-0 text-success">@Model.PresentCount</div>
                <small class="text-muted">Present</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="text-center p-2 border rounded">
                <div class="h4 mb-0 text-danger">@Model.AbsentCount</div>
                <small class="text-muted">Absent</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="text-center p-2 border rounded">
                <div class="h4 mb-0 text-info">@Model.TotalSessions</div>
                <small class="text-muted">Total</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="text-center p-2 border rounded">
                <div class="h4 mb-0">@Model.AttendancePercentage%</div>
                <small class="text-muted">Percentage</small>
            </div>
        </div>
    </div>
    
    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
        <table class="table table-sm table-bordered">
            <thead class="thead-light sticky-top">
                <tr>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Time</th>
                    <th>Flagged</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Attendances != null && Model.Attendances.Any())
                {
                    @foreach (var att in Model.Attendances)
                    {
                        <tr>
                            <td>@att.Date.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (att.Status == "Present")
                                {
                                    <span class="badge badge-success">Present</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Absent</span>
                                }
                            </td>
                            <td>@att.RegisteredAt.ToString("HH:mm:ss")</td>
                            <td>
                                @if (att.IsFlaged)
                                {
                                    <span class="badge badge-warning">Yes</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">No attendance records</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
