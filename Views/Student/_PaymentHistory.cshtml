@model SHAPEE.Models.PaymentHistoryVM

<table class="table table-hover align-middle mb-0">
    <thead class="bg-light">
        <tr>
            <th class="ps-4 py-3">Receipt ID</th>
            <th class="py-3">Invoice Ref</th>
            <th class="py-3">Date Paid</th>
            <th class="py-3">Method</th>
            <th class="py-3 text-end">Amount</th>
            <th class="py-3 text-center">Status</th>
            <th class="pe-4 py-3 text-end">Receipt</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Transactions == null || !Model.Transactions.Any())
        {
            <tr>
                <td class="ps-4 py-4 text-muted" colspan="7">No payment transactions yet.</td>
            </tr>
        }
        else
        {
            foreach (var t in Model.Transactions)
            {
                <tr>
                    <td class="ps-4 font-family-monospace fw-bold text-gray-800">#@t.ReceiptId</td>
                    <td>
                        <span class="d-block small text-primary">@t.InvoiceId</span>
                        <small class="text-muted">SemesterId: @t.SemesterId</small>
                    </td>
                    <td>@t.TransactionDate.ToString("dd MMM yyyy")</td>
                    <td>@t.PaymentMethod</td>
                    <td class="text-end fw-bold">RM @t.AmountPaid.ToString("N2")</td>
                    <td class="text-center"><span class="badge bg-success">Paid</span></td>
                    <td class="pe-4 text-end">
                        <a asp-action="DownloadReceipt"
                           asp-route-id="@t.ReceiptId"
                           target="_blank"
                           class="btn btn-sm btn-outline-primary shadow-sm px-3">
                            Download
                        </a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>