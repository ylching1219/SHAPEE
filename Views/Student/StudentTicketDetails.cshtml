@model SHAPEE.Models.SupportTicket

@{
    ViewData["Title"] = "Ticket Details";
}

<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f7f9fc;
        margin: 0;
        padding: 0;
    }

    /* Set headers to Blue and align left */
    h2, h4 {
        color: #007bff;
        text-align: left;
        font-weight: 700;
    }

    h2 {
        margin-top: 20px;
    }

    h4 {
        margin-top: 30px;
    }

    /* Fix Back button hover: ensures text remains white */
    .back-btn {
        display: inline-block;
        padding: 10px 20px;
        background-color: #007bff;
        color: white;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        margin-bottom: 20px;
        transition: background 0.3s;
    }

        .back-btn:hover {
            background-color: #0056b3;
            color: white !important; /* Forces word to stay white on hover */
        }

    .ticket-container {
        padding: 20px 40px;
        width: 100%;
        display: flex;
        flex-direction: column;
    }

    .ticket-info {
        background: #fff;
        padding: 25px 30px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        margin-bottom: 20px;
    }

    /* Styling for the Description label */
    .desc-label {
        font-weight: bold;
        color: #007bff;
    }

    .ticket-info p {
        font-size: 1rem;
        margin-bottom: 12px;
        color: #555;
    }

    .list-group-item {
        background: #fff;
        border: 1px solid #eef2f7;
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 15px;
    }

        .list-group-item strong {
            color: #007bff;
        }

    form.reply-form {
        background: #fff;
        padding: 25px 30px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

        form.reply-form textarea {
            width: 100%;
            padding: 15px;
            border-radius: 8px;
            border: 1px solid #ddd;
        }

        /* Send button hover: ensures word stays white */
        form.reply-form button {
            padding: 12px 25px;
            background: #007bff;
            color: #fff;
            font-weight: 600;
            border: none;
            border-radius: 8px;
            cursor: pointer;
        }

            form.reply-form button:hover {
                background: #0056b3;
                color: white !important;
            }
</style>

<audio id="notificationSound" src="https://www.soundjay.com/buttons/sounds/button-3.mp3" preload="auto"></audio>

<div class="ticket-container">
    <div>
        <a href="@Url.Action("TicketList", "Student")" class="back-btn">← Back to My Tickets</a>
    </div>

    <div class="ticket-info">
        <h2>Ticket #@Model.Id - @Model.Subject</h2>
        <p>Status: <strong style="color: @(Model.Status == "Closed" ? "#dc3545" : "#28a745")">@Model.Status</strong> | Priority: <strong>@Model.Priority</strong></p>
        <p><span class="desc-label">Desc:</span> @Model.Description</p>
    </div>

    <h4>Replies</h4>
    <div id="repliesContainer">
        @await Html.PartialAsync("_TicketMessage", Model.TicketMessages.OrderBy(m => m.SentAt).ToList())
    </div>
    @if (Model.Status != "Closed")
    {
        <h4>Reply</h4>
        <form asp-controller="Student" asp-action="Reply" method="post" class="reply-form" id="ticketReplyForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ticketId" value="@Model.Id" id="hiddenTicketId" />
            <textarea name="message" id="messageText" placeholder="Write your reply..." required></textarea>
            <div style="text-align: right;">
                <button type="submit" id="sendBtn">Send Reply</button>
            </div>
        </form>
    }
    else
    {
        <div style="margin-top:20px; text-align:center; padding: 20px; background: #e9ecef; border-radius: 12px; color: #6c757d; border: 1px solid #dee2e6;">
            <strong>This ticket is closed.</strong> No further replies can be sent.
        </div>
    }
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        const tId = $('#hiddenTicketId').val();
        let msgCount = $('.list-group-item').length;

        // Fast Polling
        setInterval(function() {
            $.get('@Url.Action("GetRepliesPartial", "Student")/' + tId, function(data) {
                let newCount = $(data).filter('.list-group-item').length || $(data).find('.list-group-item').length;
                if (newCount > msgCount) {
                    document.getElementById('notificationSound').play();
                    msgCount = newCount;
                    $('#repliesContainer').html(data);
                }
            });
        }, 3000);

        // Ajax Submit
        $('#ticketReplyForm').on('submit', function (e) {
            e.preventDefault();
            var $btn = $('#sendBtn');
            if ($('#messageText').val().trim() === "") return;

            $btn.prop('disabled', true).text('Sending...');
            $.ajax({
                url: $(this).attr('action'),
                type: 'POST',
                data: $(this).serialize(),
                headers: { "X-Requested-With": "XMLHttpRequest" },
                success: function () {
                    $('#messageText').val('');
                    $btn.prop('disabled', false).text('Send Reply');
                    $.get('@Url.Action("GetRepliesPartial", "Student")/' + tId, function(data) {
                        $('#repliesContainer').html(data);
                        msgCount = $(data).filter('.list-group-item').length || $(data).find('.list-group-item').length;
                    });
                }
            });
        });
    });
</script>