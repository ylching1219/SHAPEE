@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - TARUMT</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
    <link href="~/css/login.css" rel="stylesheet">
</head>
<body>
    <div class="login-container">
        <!-- Left Side - Form -->
        <div class="login-left">
            <div class="login-form-container">
                <!-- Step 1: Email Input Form -->
                <div id="emailFormStep" class="form-step active">
                    <div class="key-icon-section">
                        <div class="key-icon">
                            <i class="fas fa-key"></i>
                        </div>
                    </div>

                    <h1 class="login-title">Forgot your password?</h1>
                    <p class="login-subtitle">
                        A code will be sent to your email to help reset password
                    </p>

                    <form class="login-form" id="forgotPasswordForm">
                        <!-- Email Input -->
                        <div class="form-group">
                            <label for="email">Email Address <span class="required">*</span></label>
                            <input type="email" id="email" name="email" class="form-control" placeholder="Enter your email address" required>
                            <i class="fas fa-envelope input-icon"></i>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn-login">
                            Reset password
                        </button>
                    </form>

                    <!-- Back to Login Link -->
                    <div class="signup-link">
                        <a href="@Url.Action("Login", "Account")">
                            <i class="fas fa-arrow-left"></i> Back to login
                        </a>
                    </div>
                </div>

                <!-- Step 2: Success Message -->
                <div id="successStep" class="form-step">
                    <div class="success-icon-section">
                        <div class="success-icon">
                            <i class="fas fa-check-circle"></i>
                        </div>
                    </div>

                    <h1 class="login-title">Check your email</h1>
                    <p class="login-subtitle">
                        We've sent a password reset link to your email address. Please check your inbox and follow the instructions to reset your password.
                    </p>

                    <div class="success-actions">
                        <a href="@Url.Action("Login", "Account")" class="btn-login">
                            Back to login
                        </a>
                        <button type="button" class="btn-resend" id="resendButton">
                            Resend email
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side - Features Animation -->
        <div class="login-right">
            <div class="features-slider">
                <!-- Feature Slide 1 -->
                <div class="feature-slide active">
                    <div class="feature-icon">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <h2 class="feature-title">Secure Password Reset</h2>
                    <p class="feature-description">
                        Your account security is our priority. We'll send you a secure code to reset your password.
                    </p>
                </div>

                <!-- Feature Slide 2 -->
                <div class="feature-slide">
                    <div class="feature-icon">
                        <i class="fas fa-envelope-open"></i>
                    </div>
                    <h2 class="feature-title">Check Your Email</h2>
                    <p class="feature-description">
                        We'll send a verification code to your registered email address for secure password reset.
                    </p>
                </div>

                <!-- Feature Slide 3 -->
                <div class="feature-slide">
                    <div class="feature-icon">
                        <i class="fas fa-clock"></i>
                    </div>
                    <h2 class="feature-title">Quick & Easy</h2>
                    <p class="feature-description">
                        Reset your password in just a few simple steps and get back to your account quickly.
                    </p>
                </div>

                <!-- Slide Indicators -->
                <div class="feature-indicators">
                    <span class="feature-indicator active" data-slide="0"></span>
                    <span class="feature-indicator" data-slide="1"></span>
                    <span class="feature-indicator" data-slide="2"></span>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/slider.js"></script>
    <script>
        // Form step management
        const emailFormStep = document.getElementById('emailFormStep');
        const successStep = document.getElementById('successStep');
        const forgotPasswordForm = document.getElementById('forgotPasswordForm');
        const resendButton = document.getElementById('resendButton');

        // Handle form submission
        if (forgotPasswordForm) {
            forgotPasswordForm.addEventListener('submit', function(e) {
                e.preventDefault();
                
                
                showSuccessStep();
            });
        }

        // Show success step
        function showSuccessStep() {
            emailFormStep.classList.remove('active');
            successStep.classList.add('active');
        }

        //resend email
        if (resendButton) {
            resendButton.addEventListener('click', function() {
                //reset to email form
                emailFormStep.classList.add('active');
                successStep.classList.remove('active');
                forgotPasswordForm.reset();
            });
        }
    </script>
</body>
</html>
