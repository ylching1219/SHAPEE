@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - TARUMT</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
    <link href="~/css/login.css" rel="stylesheet">
</head>
<body>
    <div class="login-container">
        <div class="login-left">
            <div class="login-form-container">
                <div class="logo-section">
                    <div class="logo-icon-small">
                        <i class="fas fa-graduation-cap"></i>
                    </div>
                    <h1 class="login-title">Login</h1>
                    <p class="login-subtitle">Welcome back! Please login to your account.</p>
                </div>

                @if (TempData["ResetSuccess"] != null)
                {
                    <div class="success-message" style="background-color: #d4edda; color: #155724; border-color: #c3e6cb; padding: 10px; margin-bottom: 15px; border-radius: 4px;">
                        <i class="fas fa-check-circle"></i>
                        <span>@TempData["ResetSuccess"]</span>
                    </div>
                }

                <form class="login-form" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnURL" value="@ViewData["ReturnUrl"]" />

                    <div class="form-group">
                        <label for="id">ID <span class="required">*</span></label>
                        <input type="text" id="id" name="id" class="form-control @(ViewData.ModelState[""]?.Errors.Count > 0 && Context.Request.Method == "POST" ? "error" : "")" placeholder="Enter your ID" required value="@(Model?.Id ?? "")">
                        <i class="fas fa-id-card input-icon"></i>
                    </div>

                    <div class="form-group">
                        <label for="password">Password <span class="required">*</span></label>
                        <input type="password" id="password" name="password" class="form-control @(ViewData.ModelState[""]?.Errors.Count > 0 && Context.Request.Method == "POST" ? "error" : "")" placeholder="Enter your password" required>
                        <i class="fas fa-lock input-icon"></i>
                        <i class="fas fa-eye-slash toggle-password" id="togglePassword"></i>
                    </div>

                    @if (ViewData.ModelState[""]?.Errors.Count > 0 && Context.Request.Method == "POST")
                    {
                        <div class="error-message" id="errorMessage">
                            <i class="fas fa-exclamation-circle"></i>
                            <span>@ViewData.ModelState[""].Errors[0].ErrorMessage</span>
                        </div>
                    }

                    <div class="form-options">
                        <label class="checkbox-label">
                            <input type="checkbox" name="rememberMe" id="rememberMe">
                            <span class="checkmark"></span>
                            Remember me
                        </label>
                        <a href="@Url.Action("ForgotPassword", "Account")" class="forgot-password">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn-login">
                        Login
                    </button>

                </form>

                <div class="copyright">
                    <span>&copy; @DateTime.Now.Year TARUMT. All rights reserved.</span>
                </div>
            </div>
        </div>

        <div class="login-right">
            <div class="features-slider">
                <div class="feature-slide active">
                    <div class="feature-icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <h2 class="feature-title">Track Your Progress</h2>
                    <p class="feature-description">
                        Monitor your academic performance with real-time analytics and comprehensive reports.
                    </p>
                </div>

                <div class="feature-slide">
                    <div class="feature-icon">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <h2 class="feature-title">Manage Attendance</h2>
                    <p class="feature-description">
                        Keep track of your class attendance and never miss important deadlines.
                    </p>
                </div>

                <div class="feature-slide">
                    <div class="feature-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <h2 class="feature-title">Connect with Classes</h2>
                    <p class="feature-description">
                        Join classes, interact with teachers, and collaborate with fellow students.
                    </p>
                </div>

                <div class="feature-slide">
                    <div class="feature-icon">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <h2 class="feature-title">Secure & Reliable</h2>
                    <p class="feature-description">
                        Your data is protected with enterprise-grade security and encryption.
                    </p>
                </div>

                <div class="feature-slide">
                    <div class="feature-icon">
                        <i class="fas fa-mobile-alt"></i>
                    </div>
                    <h2 class="feature-title">Access Anywhere</h2>
                    <p class="feature-description">
                        Access your dashboard from any device, anywhere, at any time.
                    </p>
                </div>

                <div class="feature-indicators">
                    <span class="feature-indicator active" data-slide="0"></span>
                    <span class="feature-indicator" data-slide="1"></span>
                    <span class="feature-indicator" data-slide="2"></span>
                    <span class="feature-indicator" data-slide="3"></span>
                    <span class="feature-indicator" data-slide="4"></span>
                </div>
            </div>
        </div>
    </div>

    <script src="~/js/slider.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.3/dist/sweetalert2.all.min.js"></script>
    <script src="~/js/app.js"></script>
    <script>
        //password visibility toggle
        document.addEventListener('DOMContentLoaded', function() {
            const togglePassword = document.getElementById('togglePassword');
            const passwordInput = document.getElementById('password');
            const idInput = document.getElementById('id');

            if (togglePassword && passwordInput) {
                togglePassword.addEventListener('click', function() {
                    const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                    passwordInput.setAttribute('type', type);
                    this.classList.toggle('fa-eye');
                    this.classList.toggle('fa-eye-slash');
                });
            }

             const successMessage = document.querySelector('.success-message');
            if (successMessage) {
                setTimeout(function() {
                    successMessage.style.transition = 'opacity 0.5s ease';
                    successMessage.style.opacity = '0';
                    setTimeout(function() {
                        successMessage.style.display = 'none';
                    }, 500);
                }, 7000);
            }

            @if (ViewData.ModelState[""]?.Errors.Count > 0 && Context.Request.Method == "POST")
            {
                    <text>
                    if (idInput) {
                        idInput.classList.add('error');
                    }
                    if (passwordInput) {
                        passwordInput.classList.add('error');
                    }
                    </text>
            }

            //remove error class on input
            if (idInput) {
                idInput.addEventListener('input', function() {
                    this.classList.remove('error');
                    const errorMsg = document.getElementById('errorMessage');
                    if (errorMsg) {
                        errorMsg.style.display = 'none';
                    }
                });
            }

            if (passwordInput) {
                passwordInput.addEventListener('input', function() {
                    this.classList.remove('error');
                    const errorMsg = document.getElementById('errorMessage');
                    if (errorMsg) {
                        errorMsg.style.display = 'none';
                    }
                });
            }
        });
    </script>
</body>
</html>