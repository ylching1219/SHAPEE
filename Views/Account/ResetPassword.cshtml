@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - TARUMT</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
    <link href="~/css/reset-password.css" rel="stylesheet">
</head>
<body>
    <div class="reset-password-container">
        <div class="reset-password-content">
            <div id="resetFormStep" class="reset-step active">
                <div class="icon-section">
                    <div class="lock-icon">
                        <i class="fas fa-lock"></i>
                    </div>
                </div>

                <h1 class="reset-title">Set a new password</h1>
                <p class="reset-description">
                    Your new password must be different from previously used passwords
                </p>

                <form class="reset-form" id="resetPasswordForm" method="post" asp-action="ResetPassword" asp-controller="Account">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tokenId" value="@ViewBag.TokenId" />

                    <div class="form-group">
                        <label for="newPassword">Password <span class="required">*</span></label>
                        <input type="password" id="password" name="newPassword" class="form-control" placeholder="Enter your new password" required>
                        <i class="fas fa-lock input-icon"></i>
                        <i class="fas fa-eye-slash toggle-password" id="togglePassword"></i>
                    </div>

                    <div class="form-group">
                        <label for="confirmPassword">Confirm password <span class="required">*</span></label>
                        <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" placeholder="Confirm your new password" required>
                        <i class="fas fa-lock input-icon"></i>
                        <i class="fas fa-eye-slash toggle-password" id="toggleConfirmPassword"></i>
                    </div>

                    <div class="password-requirements">
                        <div class="requirement-item">
                            <span class="requirement-check" id="reqLength">
                                <i class="fas fa-circle"></i>
                            </span>
                            <span class="requirement-text">Must be at least 6 characters</span>
                        </div>
                    </div>

                    <button type="submit" class="btn-reset-password">
                        Reset password
                    </button>
                </form>

                <div class="back-to-login">
                    <a href="@Url.Action("Login", "Account")">
                        <i class="fas fa-arrow-left"></i> Back to login
                    </a>
                </div>
            </div>
            
            <div id="successStep" class="reset-step">
                <div class="icon-section">
                    <div class="success-icon">
                        <i class="fas fa-check-circle"></i>
                    </div>
                </div>

                <h1 class="reset-title">Password reset!</h1>
                <p class="reset-description">
                    You've successfully created a new password, click below to login
                </p>

                <div class="success-actions">
                    <a href="@Url.Action("Login", "Account")" class="btn-login">
                        Log In
                    </a>
                    <a href="@Url.Action("Login", "Account")" class="back-to-login-link">
                        <i class="fas fa-arrow-left"></i> Back to login
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script>
        const resetFormStep = document.getElementById('resetFormStep');
        const successStep = document.getElementById('successStep');
        const resetPasswordForm = document.getElementById('resetPasswordForm');
        const passwordInput = document.getElementById('password');
        const confirmPasswordInput = document.getElementById('confirmPassword');
        const reqLength = document.getElementById('reqLength');
        const reqSpecial = document.getElementById('reqSpecial');

        //password validation
        function validatePassword() {
            const password = passwordInput.value;
            const hasLength = password.length >= 6;
            const hasSpecial = /[!@@\x23$%^&*(),.?":{}|<>]/.test(password);

            //update requirement indicators (red for invalid, green for valid)
            if (hasLength) {
                reqLength.innerHTML = '<i class="fas fa-check-circle"></i>';
                reqLength.classList.add('valid');
                reqLength.classList.remove('invalid');
                reqLength.closest('.requirement-item').classList.remove('invalid');
            } else {
                reqLength.innerHTML = '<i class="fas fa-circle"></i>';
                reqLength.classList.remove('valid');
                if (password.length > 0) {
                    reqLength.classList.add('invalid');
                    reqLength.closest('.requirement-item').classList.add('invalid');
                } else {
                    reqLength.classList.remove('invalid');
                    reqLength.closest('.requirement-item').classList.remove('invalid');
                }
            }

            if (hasSpecial) {
                reqSpecial.innerHTML = '<i class="fas fa-check-circle"></i>';
                reqSpecial.classList.add('valid');
                reqSpecial.classList.remove('invalid');
                reqSpecial.closest('.requirement-item').classList.remove('invalid');
            } else {
                reqSpecial.innerHTML = '<i class="fas fa-circle"></i>';
                reqSpecial.classList.remove('valid');
                if (password.length > 0) {
                    reqSpecial.classList.add('invalid');
                    reqSpecial.closest('.requirement-item').classList.add('invalid');
                } else {
                    reqSpecial.classList.remove('invalid');
                    reqSpecial.closest('.requirement-item').classList.remove('invalid');
                }
            }

            return hasLength && hasSpecial;
        }

        //check password match
        function checkPasswordMatch() {
            if (confirmPasswordInput.value && passwordInput.value !== confirmPasswordInput.value) {
                confirmPasswordInput.setCustomValidity('Passwords do not match');
            } else {
                confirmPasswordInput.setCustomValidity('');
            }
        }

        //event listeners
        passwordInput.addEventListener('input', validatePassword);
        passwordInput.addEventListener('input', checkPasswordMatch);
        confirmPasswordInput.addEventListener('input', checkPasswordMatch);

        //toggle password visibility
        document.getElementById('togglePassword').addEventListener('click', function() {
            const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordInput.setAttribute('type', type);
            this.classList.toggle('fa-eye');
            this.classList.toggle('fa-eye-slash');
        });

        document.getElementById('toggleConfirmPassword').addEventListener('click', function() {
            const type = confirmPasswordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            confirmPasswordInput.setAttribute('type', type);
            this.classList.toggle('fa-eye');
            this.classList.toggle('fa-eye-slash');
        });

        if (resetPasswordForm) {
            resetPasswordForm.addEventListener('submit', function(e) {
                if (!validatePassword()) {
                    e.preventDefault();
                    alert('Please meet all password requirements');
                    return;
                }

                if (passwordInput.value !== confirmPasswordInput.value) {
                    e.preventDefault();
                    alert('Passwords do not match');
                    return;
                }
            });
        }
    </script>
</body>
</html>
