@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Admin Dashboard</h1>
</div>

<div class="row">
    <!--total students-->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Students</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.TotalStudents</div>
                        @if (ViewBag.StudentGrowth > 0)
                        {
                            <div class="text-xs text-success mt-1">
                                <i class="fas fa-arrow-up"></i> @ViewBag.StudentGrowth% increase this month
                            </div>
                        }
                        else if (ViewBag.StudentGrowth < 0)
                        {
                            <div class="text-xs text-danger mt-1">
                                <i class="fas fa-arrow-down"></i> @Math.Abs(ViewBag.StudentGrowth)% decrease this month
                            </div>
                        }
                        else
                        {
                            <div class="text-xs text-muted mt-1">
                                No change this month
                            </div>
                        }
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-users fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--total staff-->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Total Staff</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.TotalStaff</div>
                        @if (ViewBag.StaffGrowth > 0)
                        {
                            <div class="text-xs text-success mt-1">
                                <i class="fas fa-arrow-up"></i> @ViewBag.StaffGrowth% increase this month
                            </div>
                        }
                        else if (ViewBag.StaffGrowth < 0)
                        {
                            <div class="text-xs text-danger mt-1">
                                <i class="fas fa-arrow-down"></i> @Math.Abs(ViewBag.StaffGrowth)% decrease this month
                            </div>
                        }
                        else
                        {
                            <div class="text-xs text-muted mt-1">
                                No change this month
                            </div>
                        }
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-chalkboard-teacher fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--total classes-->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Total Classes</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.TotalClasses</div>
                        <div class="text-xs text-muted mt-1">
                            Active class sections
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-book fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--system status-->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-warning shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">System Status</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">Active</div>
                        <div class="text-xs text-success mt-1">
                            <i class="fas fa-check-circle"></i> All systems operational
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-server fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- analytics chart-->
<div class="row mb-4">
    <div class="col-12">
        <div class="card shadow">
            <div class="card-header py-3">
                <div class="d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">Analytics Overview</h6>
                    <div class="d-flex align-items-center">
                        <div class="mr-3">
                            <label class="text-xs text-gray-600 mb-0" for="dataTypeSelect">
                                <i class="fas fa-filter"></i> Data Type
                            </label>
                            <select id="dataTypeSelect" class="form-control form-control-sm border-0 shadow-sm" style="min-width: 140px; font-size: 0.875rem;">
                                <option value="students">Students</option>
                                <option value="staff">Staff</option>
                                <option value="classes">Classes</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-xs text-gray-600 mb-0" for="timelineSelect">
                                <i class="fas fa-calendar-alt"></i> Timeline
                            </label>
                            <select id="timelineSelect" class="form-control form-control-sm border-0 shadow-sm" style="min-width: 140px; font-size: 0.875rem;">
                                <option value="7days">7 Days</option>
                                <option value="30days" selected>30 Days</option>
                                <option value="3months">3 Months</option>
                                <option value="6months">6 Months</option>
                                <option value="1year">1 Year</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="text-center py-5" id="chartLoader">
                    <div class="spinner-border text-primary" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">Loading chart data...</p>
                </div>
                <canvas id="analyticsChart" height="80" style="display: none;"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!--recent activity-->
    <div class="col-lg-8 mb-4">
        <div class="card shadow h-100">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Recent Activities</h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Activity</th>
                                <th>User</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.RecentActivities != null && ViewBag.RecentActivities.Count > 0)
                            {
                                @foreach (var activity in ViewBag.RecentActivities)
                                {
                                    <tr>
                                        <td>@activity.Date.ToString("dd MMM yyyy")</td>
                                        <td>@activity.Activity</td>
                                        <td>@activity.User</td>
                                        <td><span class="badge badge-success">@activity.Status</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted">No recent activities</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!--quick actions-->
    <div class="col-lg-4 mb-4">
        <div class="card shadow h-100">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Quick Actions</h6>
            </div>
            <div class="card-body d-flex flex-column">
                <a href="@Url.Action("StudentManagement", "Admin")" class="btn btn-primary btn-block mb-2">
                    <i class="fas fa-user-plus"></i> Manage Students
                </a>
                <a href="@Url.Action("StaffManagement", "Admin")" class="btn btn-success btn-block mb-2">
                    <i class="fas fa-chalkboard-teacher"></i> Manage Staff
                </a>
                <a href="@Url.Action("ClassSection", "Admin")" class="btn btn-info btn-block mb-2">
                    <i class="fas fa-book"></i> Create Classes
                </a>
                <a href="@Url.Action("RoomManagement", "Admin")" class="btn btn-dark btn-block mb-2">
                    <i class="fas fa-door-open"></i> Manage Rooms
                </a>
                <a href="@Url.Action("LeaveManagement", "Admin")" class="btn btn-warning btn-block mb-2">
                    <i class="fas fa-calendar-check"></i> Approve/Reject Leave
                </a>
                <a href="@Url.Action("PaymentMonitoring", "Admin")" class="btn btn-danger btn-block mb-2">
                    <i class="fas fa-money-bill-wave"></i> Monitor Payment
                </a>
                <a href="@Url.Action("FacultyManagement", "Admin")" class="btn btn-secondary btn-block mb-2">
                    <i class="fas fa-university"></i> Manage Faculties
                </a>
                <a href="@Url.Action("ProgramManagement", "Admin")" class="btn btn-outline-primary btn-block mb-2">
                    <i class="fas fa-graduation-cap"></i> Manage Programs
                </a>
                <div class="mt-auto">
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        //color mapping for different data
        const colorMap = {
            students: {
                border: 'rgba(78, 115, 223, 1)',
                background: 'rgba(78, 115, 223, 0.1)'
            },
            staff: {
                border: 'rgba(28, 200, 138, 1)',
                background: 'rgba(28, 200, 138, 0.1)'
            },
            classes: {
                border: 'rgba(54, 185, 204, 1)',
                background: 'rgba(54, 185, 204, 0.1)'
            }
        };

        //initialize chart
        let analyticsChart;
        const ctx = document.getElementById('analyticsChart').getContext('2d');

        function updateChart() {
            const dataType = document.getElementById('dataTypeSelect').value;
            const timeline = document.getElementById('timelineSelect').value;

            // Show loader
            document.getElementById('chartLoader').style.display = 'block';
            document.getElementById('analyticsChart').style.display = 'none';

            // Fetch data from server
            fetch(`@Url.Action("GetChartData", "Admin")?dataType=${dataType}&timeline=${timeline}`)
                .then(response => response.json())
                .then(chartData => {
                    const colors = colorMap[dataType];

                    if (analyticsChart) {
                        analyticsChart.destroy();
                    }

                    // Hide loader and show chart
                    document.getElementById('chartLoader').style.display = 'none';
                    document.getElementById('analyticsChart').style.display = 'block';

                    analyticsChart = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: chartData.labels,
                            datasets: [{
                                label: dataType.charAt(0).toUpperCase() + dataType.slice(1),
                                data: chartData.data,
                                borderColor: colors.border,
                                backgroundColor: colors.background,
                                borderWidth: 3,
                                fill: true,
                                tension: 0.4,
                                pointRadius: 5,
                                pointHoverRadius: 7,
                                pointBackgroundColor: colors.border,
                                pointBorderColor: '#fff',
                                pointBorderWidth: 2,
                                pointHoverBackgroundColor: colors.border,
                                pointHoverBorderColor: '#fff',
                                pointHoverBorderWidth: 3
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: true,
                            plugins: {
                                legend: {
                                    display: true,
                                    position: 'top',
                                    labels: {
                                        usePointStyle: true,
                                        padding: 15,
                                        font: {
                                            size: 12,
                                            weight: 'bold'
                                        }
                                    }
                                },
                                tooltip: {
                                    backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                    padding: 12,
                                    titleFont: {
                                        size: 14,
                                        weight: 'bold'
                                    },
                                    bodyFont: {
                                        size: 13
                                    },
                                    displayColors: true,
                                    callbacks: {
                                        label: function(context) {
                                            return context.dataset.label + ': ' + context.parsed.y.toLocaleString();
                                        }
                                    }
                                }
                            },
                            scales: {
                                y: {
                                    beginAtZero: false,
                                    grid: {
                                        color: 'rgba(0, 0, 0, 0.05)',
                                        drawBorder: false
                                    },
                                    ticks: {
                                        font: {
                                            size: 11
                                        },
                                        callback: function(value) {
                                            return value.toLocaleString();
                                        }
                                    }
                                },
                                x: {
                                    grid: {
                                        display: false,
                                        drawBorder: false
                                    },
                                    ticks: {
                                        font: {
                                            size: 11
                                        }
                                    }
                                }
                            },
                            interaction: {
                                intersect: false,
                                mode: 'index'
                            },
                            animation: {
                                duration: 1000,
                                easing: 'easeInOutQuart'
                            }
                        }
                    });
                })
                .catch(error => {
                    console.error('Error loading chart data:', error);
                    document.getElementById('chartLoader').innerHTML =
                        '<p class="text-danger">Error loading chart data. Please try again.</p>';
                });
        }


        document.getElementById('dataTypeSelect').addEventListener('change', updateChart);
        document.getElementById('timelineSelect').addEventListener('change', updateChart);

        document.addEventListener('DOMContentLoaded', function() {
            updateChart();
        });
    </script>
}