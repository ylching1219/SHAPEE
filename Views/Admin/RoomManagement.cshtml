@model IEnumerable<Room>
@using System.Text.Json
@* @{
    ViewData["Title"] = "Room Management";
} *@

<!-- Success/Error Messages -->
@* @if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
} *@

<!-- Header -->
<div class="bg-white border-bottom px-4 py-3 mb-4">
    <h1 class="h3 mb-0 text-gray-800">Room Management</h1>
</div>

<div class="tab-content" id="RoomManagementTabContent">
    <!-- Rooms Tab -->
    <div class="tab-pane fade show active" id="rooms" role="tabpanel">
        <div class="card shadow-sm">
            <!-- Card Header -->
            <div class="card-header bg-white border-bottom py-3">
                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between">
                    <h5 class="mb-3 mb-md-0 font-weight-semibold text-gray-800">
                        Rooms (<span id="roomCount">@Model.Count()</span>)
                    </h5>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary btn-sm" data-toggle="modal" data-target="#addEditRoomModal" onclick="prepareAddModal()">
                            <i class="fas fa-plus mr-1"></i> Add Room
                        </button>
                        <button class="btn btn-outline-primary btn-sm" id="exportCsvBtn">
                            <i class="fas fa-download mr-1"></i> Export CSV
                        </button>
                    </div>
                </div>
            </div>

            <!-- Filters Section -->
            <div class="card-body bg-light border-bottom">
                <div class="row g-3">
                    <div class="col-12 col-md-3">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-white">
                                    <i class="fas fa-search text-muted"></i>
                                </span>
                            </div>
                            <input type="text" class="form-control" id="searchInput" placeholder="Search rooms...">
                        </div>
                    </div>
                    <div class="col-12 col-md-2">
                        <select class="form-control" id="typeFilter">
                            <option value="">All Types</option>
                            <option value="Classroom">Classroom</option>
                            <option value="Lab">Lab</option>
                            <option value="Lecture Hall">Lecture Hall</option>
                            <option value="Conference">Conference</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-2">
                        <select class="form-control" id="blockFilter">
                            <option value="">All Blocks</option>
                            <option value="A">Block A</option>
                            <option value="B">Block B</option>
                            <option value="C">Block C</option>
                            <option value="D">Block D</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-2">
                        <select class="form-control" id="statusFilter">
                            <option value="">All Status</option>
                            <option value="Available">Available</option>
                            <option value="Occupied">Occupied</option>
                            <option value="Maintenance">Maintenance</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <form id="sortForm" data-ajax="true"
                              data-ajax-url="/Admin/RoomManagement"
                              data-ajax-method="GET"
                              data-ajax-update="#roomData">
                            <select class="form-control" name="sort" id="roomSort">
                                <option value="">Sort By</option>
                                <option value="1">Room ID (Ascending)</option>
                                <option value="2">Room ID (Descending)</option>
                                <option value="3">Block (A-Z)</option>
                                <option value="4">Floor (Low-High)</option>
                            </select>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Rooms Table -->
            <div class="card-body p-0">
                <div class="table-responsive">
                    <div id="roomData">
                        <partial name="_Room" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Room Modal -->
<div class="modal fade" id="addEditRoomModal" tabindex="-1" role="dialog" aria-labelledby="addEditRoomModalLabel">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title font-weight-semibold" id="addEditRoomModalLabel">Add New Room</h5>
                <button class="close text-white" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="roomForm" method="post" asp-controller="Admin" asp-action="CreateRoom">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="roomId" name="RoomID" value="" />

                    <div class="form-group">
                        <label for="roomID" class="font-weight-medium">Room ID <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="roomIDInput" name="RoomID" placeholder="e.g., A101, B205" required>
                    </div>

                    <div class="form-group">
                        <label for="roomType" class="font-weight-medium">Type <span class="text-danger">*</span></label>
                        <select class="form-control" id="roomType" name="Type" required>
                            <option value="">Select Room Type</option>
                            <option value="Classroom">Classroom</option>
                            <option value="Lab">Lab</option>
                            <option value="Lecture Hall">Lecture Hall</option>
                            <option value="Conference">Conference</option>
                        </select>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="block" class="font-weight-medium">Block <span class="text-danger">*</span></label>
                                <select class="form-control" id="block" name="Block" required>
                                    <option value="">Select Block</option>
                                    <option value="A">Block A</option>
                                    <option value="B">Block B</option>
                                    <option value="C">Block C</option>
                                    <option value="D">Block D</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="floor" class="font-weight-medium">Floor <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="floor" name="Floor" min="0" max="20" required>
                            </div>
                        </div>
                    </div>

                    <div class="form-group" id="statusGroup" style="display:none;">
                        <label for="status" class="font-weight-medium">Status</label>
                        <select class="form-control" id="status" name="Status">
                            <option value="Available">Available</option>
                            <option value="Occupied">Occupied</option>
                            <option value="Maintenance">Maintenance</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i> Cancel
                    </button>
                    <button class="btn btn-primary" type="submit" id="saveRoomBtn">
                        <i class="fas fa-save mr-1"></i> Save Room
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteRoomModal" tabindex="-1" role="dialog" aria-labelledby="deleteRoomModalLabel">
    <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title font-weight-semibold">Confirm Deletion</h5>
                <button class="close text-white" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <i class="fas fa-exclamation-triangle fa-3x text-danger"></i>
                </div>
                <p class="text-center mb-2">Are you sure you want to delete</p>
                <p class="text-center font-weight-bold mb-3"><span id="roomToDeleteName"></span>?</p>
                <p class="text-danger small text-center mb-0">
                    <i class="fas fa-info-circle mr-1"></i>This action cannot be undone.
                </p>
            </div>
            <div class="modal-footer bg-light">
                <button class="btn btn-secondary btn-sm" type="button" data-dismiss="modal">
                    <i class="fas fa-times mr-1"></i> Cancel
                </button>
                <form id="deleteForm" method="post" asp-controller="Admin" asp-action="DeleteRoom" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteRoomId" name="RoomID" />
                    <button class="btn btn-danger btn-sm" type="submit">
                        <i class="fas fa-trash mr-1"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Modal elements
            const modalTitle = document.getElementById('addEditRoomModalLabel');
            const form = document.getElementById('roomForm');
            const statusGroup = document.getElementById('statusGroup');

            // Prepare Add Modal
            window.prepareAddModal = function() {
                modalTitle.innerText = 'Add New Room';
                form.setAttribute('action', '@Url.Action("CreateRoom", "Admin")');
                form.reset();
                document.getElementById('roomId').value = '';
                document.getElementById('roomIDInput').disabled = false;
                statusGroup.style.display = 'none';
            };

            // Prepare Edit Modal
            window.prepareEditModal = function(element) {
                const row = element.closest('tr');
                const roomData = JSON.parse(row.getAttribute('data-room'));

                modalTitle.innerText = 'Edit Room: ' + roomData.RoomID;
                form.setAttribute('action', '@Url.Action("EditRoom", "Admin")');

                document.getElementById('roomId').value = roomData.RoomID;
                document.getElementById('roomIDInput').value = roomData.RoomID;
                document.getElementById('roomIDInput').disabled = true;
                document.getElementById('roomType').value = roomData.Type;
                document.getElementById('block').value = roomData.Block;
                document.getElementById('floor').value = roomData.Floor;
                document.getElementById('status').value = roomData.Status.trim();

                statusGroup.style.display = 'block';
            };

            // Prepare Delete Modal
            window.prepareDeleteModal = function(element) {
                const row = element.closest('tr');
                const roomID = row.getAttribute('data-room-id');
                const roomData = JSON.parse(row.getAttribute('data-room'));

                document.getElementById('roomToDeleteName').innerText = 'Room ' + roomID;
                document.getElementById('deleteRoomId').value = roomData.RoomID;
            };

            // Search and Filter functionality
            const searchInput = document.getElementById('searchInput');
            const typeFilter = document.getElementById('typeFilter');
            const blockFilter = document.getElementById('blockFilter');
            const statusFilter = document.getElementById('statusFilter');

            searchInput.addEventListener('keyup', filterTable);
            typeFilter.addEventListener('change', filterTable);
            blockFilter.addEventListener('change', filterTable);
            statusFilter.addEventListener('change', filterTable);

            function filterTable() {
                const searchValue = searchInput.value.toLowerCase();
                const typeValue = typeFilter.value.toLowerCase();
                const blockValue = blockFilter.value.toLowerCase();
                const statusValue = statusFilter.value.toLowerCase();

                const rows = document.querySelectorAll('#roomsTableBody tr');
                let visibleCount = 0;

                rows.forEach(row => {
                    // Skip "no rooms" row
                    if (row.cells.length === 1) return;

                    const roomID = row.cells[0].textContent.toLowerCase();
                    const type = row.cells[1].textContent.toLowerCase();
                    const block = row.cells[2].textContent.toLowerCase();
                    const status = row.cells[4].textContent.toLowerCase();

                    const matchesSearch = roomID.includes(searchValue);
                    const matchesType = !typeValue || type.includes(typeValue);
                    const matchesBlock = !blockValue || block.includes(blockValue);
                    const matchesStatus = !statusValue || status.includes(statusValue);

                    if (matchesSearch && matchesType && matchesBlock && matchesStatus) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                document.getElementById('roomCount').textContent = visibleCount;
            }

            // Sort functionality
            $('#roomSort').change(function() {
                $('#sortForm').submit();
            });

            // Auto-dismiss alerts after 5 seconds
            setTimeout(function() {
                const alerts = document.querySelectorAll('.alert');
                alerts.forEach(alert => {
                    const closeBtn = alert.querySelector('.close');
                    if (closeBtn) {
                        closeBtn.click();
                    }
                });
            }, 5000);

            // Export CSV functionality
            document.getElementById('exportCsvBtn').addEventListener('click', function() {
                window.location.href = '@Url.Action("ExportRoomsCSV", "Admin")';
            });
        });
    </script>
}