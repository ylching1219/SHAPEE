@model RoomManageVM
@{
    ViewData["Title"] = "Room Management";
}

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<!-- Header -->
<div class="bg-white border-bottom px-4 py-3 mb-4">
    <h1 class="h3 mb-0 text-gray-800">Room Management</h1>
</div>

<div class="tab-content" id="RoomManagementTabContent">
    <div class="tab-pane fade show active" id="rooms" role="tabpanel">
        <div class="card shadow-sm">
            <!-- Card Header -->
            <div class="card-header bg-white border-bottom py-3">
                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between">
                    <h5 class="mb-3 mb-md-0 font-weight-semibold text-gray-800">
                        Rooms
                    </h5>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary btn-sm" data-toggle="modal" data-target="#addEditModal" id="addData" onclick="onAddLoaded()">
                            <i class="fas fa-plus mr-1"></i> Add Room
                        </button>
                        <button class="btn btn-outline-primary btn-sm" id="exportCsvBtn">
                            <i class="fas fa-download mr-1"></i> Export CSV
                        </button>
                    </div>
                </div>
            </div>

            <!-- Filters Section -->
            <div class="card-body bg-light border-bottom">
                <form id="filterForm"
                      data-ajax="true"
                      data-ajax-method="GET"
                      data-ajax-url="/Admin/RoomManagement"
                      data-ajax-update="#roomData">
                    <div class="row g-3">
                        <div class="col-12 col-md-3">
                            <div class="input-group">
                                <span class="input-group-text bg-white">
                                    <i class="fas fa-search text-muted"></i>
                                </span>
                                <input type="text" class="form-control" name="search" id="searchInput" placeholder="Search rooms...">
                            </div>
                        </div>
                        <div class="col-12 col-md-2">
                            <select class="form-control" name="type" id="typeFilter">
                                <option value="">All Types</option>
                                <option value="Classroom">Classroom</option>
                                <option value="Lab">Lab</option>
                                <option value="Lecture Hall">Lecture Hall</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-2">
                            <select class="form-control" name="block" id="blockFilter">
                                <option value="">All Blocks</option>
                                <!-- Lab Blocks (B, D, CC) -->
                                <option value="B" data-room-type="Lab">Block B</option>
                                <option value="D" data-room-type="Lab">Block D</option>
                                <option value="CC" data-room-type="Lab">Block CC</option>
                                <!-- Classroom Blocks -->
                                <option value="L" data-room-type="Classroom">Block L</option>
                                <option value="H" data-room-type="Classroom">Block H</option>
                                <option value="K" data-room-type="Classroom">Block K</option>
                                <option value="R" data-room-type="Classroom">Block R</option>
                                <option value="Q" data-room-type="Classroom">Block Q</option>
                                <option value="QA" data-room-type="Classroom">Block QA</option>
                                <option value="PA" data-room-type="Classroom">Block PA</option>
                                <option value="J" data-room-type="Classroom">Block J</option>
                                <option value="G" data-room-type="Classroom">Block G</option>
                                <option value="S" data-room-type="Classroom">Block S</option>
                                <option value="W" data-room-type="Classroom">Block W</option>
                                <!-- Lecture Hall Block -->
                                <option value="DK" data-room-type="Lecture Hall">Block DK</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-2">
                            <select class="form-control" name="status" id="statusFilter">
                                <option value="">All Status</option>
                                <option value="Available">Available</option>
                                <option value="Occupied">Occupied</option>
                                <option value="Maintenance">Maintenance</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-2">
                            <select class="form-control" name="sort" id="roomSort">
                                <option value="">Default Sort</option>
                                <option value="1">Room ID (A-Z)</option>
                                <option value="2">Room ID (Z-A)</option>
                                <option value="3">Floor (Low to High)</option>
                                <option value="4">Floor (High to Low)</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-1">
                            <button type="reset" class="btn btn-secondary w-100" title="Reset filters">
                                <i class="fas fa-undo"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Rooms Table -->
            <div class="card-body p-0">
                <div class="table-responsive">
                    <div id="roomData">
                        <partial name="_Room" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Room Modal -->
<div class="modal fade" id="addEditModal" tabindex="-1" role="dialog" aria-labelledby="addEditModalLabel">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title font-weight-semibold" id="addEditModalLabel">Add New Room</h5>
                <button class="close text-white closeBtn" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div id="AddEditData">
                <partial name="_RoomForm" />
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel">
    <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title font-weight-semibold">Confirm Deletion</h5>
                <button class="close text-white" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <i class="fas fa-exclamation-triangle fa-3x text-danger"></i>
                </div>
                <p class="text-center mb-2">Are you sure you want to delete</p>
                <p class="text-center font-weight-bold mb-3"><span id="ToDeleteName"></span>?</p>
                <p class="text-danger small text-center mb-0">
                    <i class="fas fa-info-circle mr-1"></i>This action cannot be undone.
                </p>
            </div>
            <div class="modal-footer bg-light">
                <button class="btn btn-secondary btn-sm" type="button" data-dismiss="modal">
                    <i class="fas fa-times mr-1"></i> Cancel
                </button>
                <form id="deleteForm" method="post" asp-controller="Admin" asp-action="DeleteRoom" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteId" name="Id" />
                    <button class="btn btn-danger btn-sm" type="submit">
                        <i class="fas fa-trash mr-1"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $("#exportCsvBtn").on("click", function () {
            const search = $('#searchInput').val();
            const type = $('#typeFilter').val();
            const block = $('#blockFilter').val();
            const status = $('#statusFilter').val();

            const params = new URLSearchParams();
            if (search) params.append('search', search);
            if (type) params.append('type', type);
            if (block) params.append('block', block);
            if (status) params.append('status', status);

            window.location.href = '/Admin/ExportRoomsCsv?' + params.toString();
        });

        function onEditLoaded() {
            console.log("Edit Mode Loaded");

            $("#addEditModal").modal("show");
            $("#addEditModalLabel").text("Edit Room");
            $("#saveBtn").html('<i class="fas fa-save mr-1"></i> Update Room');

            // In EDIT mode: disable everything except status
            $("#roomType").prop("disabled", true);
            $("#block").prop("disabled", true);
            $("#floorSelect").prop("disabled", true);
            $("#roomNumber").prop("disabled", true);
            $("#RoomID").prop("disabled", true);

            // Hide component selectors and room ID input in edit mode
            $("#roomComponentsGroup").hide();
            $("#roomIdGroup").hide();

            // Show only the status field
            $("#statusGroup").show();

            $("#addEditForm").attr("action", "/Admin/EditRoom");

            // Add hidden field for roomId in edit mode
            if ($("#editRoomId").length === 0) {
                const roomId = $("#RoomID").val();
                $("#addEditForm").append(`<input type="hidden" id="editRoomId" name="roomId" value="${roomId}">`);
            }

            // Clear any previous errors
            $('#formErrorMessage').hide().html('');
        }

        function onAddLoaded() {
            console.log("Add Mode Loaded");

            $("#addEditModalLabel").text("Add Room");
            $("#saveBtn").html('<i class="fas fa-save mr-1"></i> Add Room');

            // Reset all form fields
            $("#roomType").val("").prop("disabled", false);
            $("#block").val("").prop("disabled", false);
            $("#floorSelect").val("").prop("disabled", false);
            $("#roomNumber").val("").prop("disabled", false);
            $("#RoomID").val("").prop("disabled", false);
            $("#status").val("Available");

            // Hide status in add mode, show component selectors
            $("#statusGroup").hide();
            $("#roomComponentsGroup").show();
            $("#roomIdGroup").hide();
            $("#generatedRoomId").hide();
            $("#roomIdPreview").text("-");

            $("#addEditForm").attr("action", "/Admin/AddRoom");

            // Remove edit-specific hidden field if it exists
            $("#editRoomId").remove();

            // Clear any previous errors
            $('#formErrorMessage').hide().html('');
        }

        function prepareDeleteModal(element) {
            var id = $(element).data("id");
            var name = $(element).data("name");

            $("#deleteId").val(id);
            $("#ToDeleteName").text(name);
        }

        function applyFilters() {
            const search = $('#searchInput').val();
            const type = $('#typeFilter').val();
            const block = $('#blockFilter').val();
            const status = $('#statusFilter').val();
            const sort = $('#roomSort').val();

            const params = new URLSearchParams();
            if (search) params.append('search', search);
            if (type) params.append('type', type);
            if (block) params.append('block', block);
            if (status) params.append('status', status);
            if (sort) params.append('sort', sort);

            $.ajax({
                url: '/Admin/RoomManagement',
                type: 'GET',
                data: params.toString(),
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                success: function(data) {
                    $('#roomData').html(data);
                },
                error: function() {
                    alert('Error loading rooms');
                }
            });
        }

        $(document).ready(function() {
            // Handle TYPE filter change to update BLOCK filter options
            $("#typeFilter").on("change", function() {
                const selectedType = $(this).val();
                const $blockFilter = $("#blockFilter");

                // Reset block filter
                $blockFilter.val("");

                // Show/hide block options based on type
                $blockFilter.find('option').each(function() {
                    const $option = $(this);
                    const blockValue = $option.val();

                    if (blockValue === "") {
                        // Always show "All Blocks" option
                        $option.show();
                    } else if (selectedType === "") {
                        // If no type selected, show all blocks
                        $option.show();
                    } else if (selectedType === "Lab") {
                        // For Lab, only show B, D, CC
                        if (["B", "D", "CC"].includes(blockValue)) {
                            $option.show();
                        } else {
                            $option.hide();
                        }
                    } else if (selectedType === "Classroom") {
                        // For Classroom, show L, H, K, R, Q, QA, PA, J, G, S, W
                        if (["L", "H", "K", "R", "Q", "QA", "PA", "J", "G", "S", "W"].includes(blockValue)) {
                            $option.show();
                        } else {
                            $option.hide();
                        }
                    } else if (selectedType === "Lecture Hall") {
                        // For Lecture Hall, only show DK (if you want to add it to filter)
                        // Or hide all blocks since lecture halls don't use standard blocks
                        $option.hide();
                    }
                });

                // Trigger filter update
                applyFilters();
            });

            // Handle room type change
            $(document).on("change", "#roomType", function () {
            console.log("Room type changed");

            const type = $(this).val();
            const $block = $("#block");
            const $floorSelect = $("#floorSelect");

            // Clear previous selections
            $floorSelect.html('<option value="">Select Floor</option>');
            $("#roomNumber").val("");
            $("#generatedRoomId").hide();

            if (type === "Lecture Hall") {
                $("#roomIdGroup").show();
                $("#roomComponentsGroup").hide();
                $("#RoomID").prop("required", true).prop("disabled", false);
                $block.prop("required", false);
                $floorSelect.prop("required", false);
                $("#roomNumber").prop("required", false);
                $("#floorHint").text("Lecture Hall - Block DK (no floor specification)");
            }
            else if (type === "") {
                $("#roomIdGroup").hide();
                $("#roomComponentsGroup").show();
                $block.prop("disabled", true);
                $floorSelect.prop("disabled", true);
                $("#roomNumber").prop("disabled", true);
                $("#RoomID").prop("required", false);
                $("#floorHint").text("Select room type first");
            }
            else {
                $("#roomIdGroup").hide();
                $("#roomComponentsGroup").show();
                $("#RoomID").prop("required", false);

                $block.prop("disabled", false).prop("required", true);
                $floorSelect.prop("required", true);
                $("#roomNumber").prop("required", true).prop("disabled", false);

                // Filter blocks
                $block.find('option').each(function () {
                    const optionType = $(this).data('room-type');
                    if (!optionType || optionType === type) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });

                if (type === "Lab") {
                    $("#floorHint").text("Lab floors: 0-2");
                    $floorSelect.append('<option value="0">0</option>')
                                .append('<option value="1">1</option>')
                                .append('<option value="2">2</option>');
                } else if (type === "Classroom") {
                    $("#floorHint").text("Classroom floors: 1-3");
                    $floorSelect.append('<option value="1">1</option>')
                                .append('<option value="2">2</option>')
                                .append('<option value="3">3</option>');
                }

                $floorSelect.prop("disabled", false);
            }
        });

            // Generate Room ID preview when block, floor, or room number changes
            function updateRoomIdPreview() {
                const type = $("#roomType").val();

                if (type === "Lecture Hall") {
                    return; // No preview for lecture hall
                }

                const block = $("#block").val();
                const floor = $("#floorSelect").val();
                const roomNum = $("#roomNumber").val();

                if (block && floor !== "" && roomNum) {
                    const roomId = `${block}${floor}0${roomNum}`;
                    $("#roomIdPreview").text(roomId);
                    $("#generatedRoomId").show();

                    // Set the hidden RoomID value
                    $("#RoomID").val(roomId);
                } else {
                    $("#generatedRoomId").hide();
                    $("#roomIdPreview").text("-");
                    $("#RoomID").val("");
                }
            }

            $("#block, #floorSelect, #roomNumber").on("change", updateRoomIdPreview);

            // Handle form submission with AJAX
            $(document).on('submit', '#addEditForm', function(e) {
                e.preventDefault();

                // Clear previous errors
                $('#formErrorMessage').hide().html('');

                const actionUrl = $(this).attr('action');
                let formData;

                if (actionUrl.includes('AddRoom')) {
                    const type = $("#roomType").val();

                    if (type === "Lecture Hall") {
                        // For lecture hall, use the manual room ID and set block to DK
                        formData = {
                            roomId: $("#RoomID").val(),
                            type: type,
                            block: "DK",
                            floor: null
                        };
                    } else {
                        // For Lab/Classroom, construct room ID from components
                        const block = $("#block").val();
                        const floor = $("#floorSelect").val();
                        const roomNum = $("#roomNumber").val();
                        const roomId = `${block}${floor}0${roomNum}`;

                        formData = {
                            roomId: roomId,
                            type: type,
                            block: block,
                            floor: parseInt(floor)
                        };
                    }

                    // Add anti-forgery token
                    formData.__RequestVerificationToken = $('input[name="__RequestVerificationToken"]').val();
                } else {
                    // Edit mode - just serialize the form
                    formData = $(this).serialize();
                }

                $.ajax({
                    url: actionUrl,
                    type: 'POST',
                    data: formData,
                    success: function(response) {
                        if (response.success) {
                            $('#addEditModal').modal('hide');

                            const successAlert = `
                                <div class="alert alert-success alert-dismissible fade show" role="alert">
                                    <i class="fas fa-check-circle mr-2"></i>${response.message}
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>`;
                            $('.tab-content').prepend(successAlert);

                            applyFilters();

                            setTimeout(function() {
                                $('.alert').alert('close');
                            }, 5000);
                        } else {
                            const errorHtml = `
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <i class="fas fa-exclamation-circle mr-2"></i>${response.message}
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>`;

                            $('#formErrorMessage').html(errorHtml).show();
                        }
                    },
                    error: function(xhr) {
                        let errorMessage = 'An error occurred. Please try again.';

                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMessage = xhr.responseJSON.message;
                        }

                        const errorHtml = `
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="fas fa-exclamation-circle mr-2"></i>${errorMessage}
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>`;

                        $('#formErrorMessage').html(errorHtml).show();
                    }
                });
            });

            // Trigger filter on change
            $('#searchInput, #typeFilter, #blockFilter, #statusFilter, #roomSort').on('change keyup', function() {
                if ($(this).attr('id') === 'searchInput') {
                    clearTimeout(window.searchTimeout);
                    window.searchTimeout = setTimeout(applyFilters, 500);
                } else {
                    applyFilters();
                }
            });

            // Reset button
            $('button[type="reset"]').on('click', function() {
                $('#searchInput').val('');
                $('#typeFilter').val('');
                $('#blockFilter').val('');
                $('#statusFilter').val('');
                $('#roomSort').val('');

                // Show all block options again
                $('#blockFilter option').show();

                applyFilters();
            });

            // Auto-dismiss alerts
            setTimeout(function() {
                $('.alert').each(function() {
                    $(this).find('.close').click();
                });
            }, 5000);
        });
    </script>
}