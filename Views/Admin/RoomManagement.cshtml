@model RoomManageVM
@{
    ViewData["Title"] = "Room Management";
}

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<!-- Header -->
<div class="bg-white border-bottom px-4 py-3 mb-4">
    <h1 class="h3 mb-0 text-gray-800">Room Management</h1>
</div>

<div class="tab-content" id="RoomManagementTabContent">
    <!-- Rooms Tab -->
    <div class="tab-pane fade show active" id="rooms" role="tabpanel">
        <div class="card shadow-sm">
            <!-- Card Header -->
            <div class="card-header bg-white border-bottom py-3">
                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between">
                    <h5 class="mb-3 mb-md-0 font-weight-semibold text-gray-800">
                        Rooms (<span id="roomCount">@Model.Rooms.Count()</span>)
                    </h5>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary btn-sm" data-toggle="modal" data-target="#addEditRoomModal" id="addData">
                            <i class="fas fa-plus mr-1"></i> Add Room
                        </button>
                        <button class="btn btn-outline-primary btn-sm" id="exportCsvBtn">
                            <i class="fas fa-download mr-1"></i> Export CSV
                        </button>
                    </div>
                </div>
            </div>

            <!-- Filters Section -->
            <div class="card-body bg-light border-bottom">
                <form id="filterForm"
                      data-ajax="true"
                      data-ajax-method="GET"
                      data-ajax-url="/Admin/RoomManagement"
                      data-ajax-update="#roomData">
                    <div class="row g-3">
                        <div class="col-12 col-md-3">
                            <div class="input-group">
                                <span class="input-group-text bg-white">
                                    <i class="fas fa-search text-muted"></i>
                                </span>
                                <input type="text" class="form-control" name="search" id="searchInput" placeholder="Search rooms...">
                            </div>
                        </div>
                        <div class="col-12 col-md-2">
                            <select class="form-control" name="type" id="typeFilter">
                                <option value="">All Types</option>
                                <option value="Classroom">Classroom</option>
                                <option value="Lab">Lab</option>
                                <option value="Lecture Hall">Lecture Hall</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-2">
                            <select class="form-control" name="block" id="blockFilter">
                                <option value="">All Blocks</option>
                                <option value="B" data-room-type="Lab">Block B</option>
                                <option value="D" data-room-type="Lab">Block D</option>
                                <option value="CC" data-room-type="Lab">Block CC</option>
                                <option value="L" data-room-type="Classroom">Block L</option>
                                <option value="H" data-room-type="Classroom">Block H</option>
                                <option value="K" data-room-type="Classroom">Block K</option>
                                <option value="R" data-room-type="Classroom">Block R</option>
                                <option value="Q" data-room-type="Classroom">Block Q</option>
                                <option value="QA" data-room-type="Classroom">Block QA</option>
                                <option value="PA" data-room-type="Classroom">Block PA</option>
                                <option value="J" data-room-type="Classroom">Block J</option>
                                <option value="G" data-room-type="Classroom">Block G</option>
                                <option value="S" data-room-type="Classroom">Block S</option>
                                <option value="W" data-room-type="Classroom">Block W</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-2">
                            <select class="form-control" name="status" id="statusFilter">
                                <option value="">All Status</option>
                                <option value="Available">Available</option>
                                <option value="Occupied">Occupied</option>
                                <option value="Maintenance">Maintenance</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-2">
                            <select class="form-control" name="sort" id="roomSort">
                                <option value="">Sort By</option>
                                <option value="1">Room ID (Ascending)</option>
                                <option value="2">Room ID (Descending)</option>
                                <option value="3">Floor (Low to High)</option>
                                <option value="4">Floor (High to Low)</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-1">
                            <button type="reset" class="btn btn-secondary w-100" title="Reset filters">
                                <i class="fas fa-undo"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Rooms Table -->
            <div class="card-body p-0">
                <div class="table-responsive">
                    <div id="roomData">
                        <partial name="_Room" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Room Modal -->
<div class="modal fade" id="addEditRoomModal" tabindex="-1" role="dialog" aria-labelledby="addEditRoomModalLabel">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title font-weight-semibold" id="addEditRoomModalLabel">Add New Room</h5>
                <button class="close text-white closeBtn" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div id="AddEditData">
                <form id="roomForm" method="post" asp-controller="Admin" asp-action="AddRoom">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="form-group">
                            <label for="RoomID" class="font-weight-medium">Room ID <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="RoomID" name="roomId"
                                   value="@(Model.EditRoom?.Id ?? "")"
                                   required>
                        </div>

                        <div class="form-group">
                            <label for="roomType" class="font-weight-medium">Type <span class="text-danger">*</span></label>
                            <select class="form-control" id="roomType" name="type" required>
                                <option value="">Select Room Type</option>
                                <option value="Classroom" selected="@(Model.EditRoom?.Type == "Classroom")">Classroom</option>
                                <option value="Lab" selected="@(Model.EditRoom?.Type == "Lab")">Lab</option>
                                <option value="Lecture Hall" selected="@(Model.EditRoom?.Type == "Lecture Hall")">Lecture Hall</option>
                            </select>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="block" class="font-weight-medium">Block <span class="text-danger">*</span></label>
                                    <select class="form-control" id="block" name="block" required>
                                        <option value="">Select Block</option>
                                        <option value="B" data-room-type="Lab" selected="@(Model.EditRoom?.Block == "B")">Block B</option>
                                        <option value="D" data-room-type="Lab" selected="@(Model.EditRoom?.Block == "D")">Block D</option>
                                        <option value="CC" data-room-type="Lab" selected="@(Model.EditRoom?.Block == "CC")">Block CC</option>
                                        <option value="L" data-room-type="Classroom" selected="@(Model.EditRoom?.Block == "L")">Block L</option>
                                        <option value="H" data-room-type="Classroom" selected="@(Model.EditRoom?.Block == "H")">Block H</option>
                                        <option value="K" data-room-type="Classroom" selected="@(Model.EditRoom?.Block == "K")">Block K</option>
                                        <option value="R" data-room-type="Classroom" selected="@(Model.EditRoom?.Block == "R")">Block R</option>
                                        <option value="Q" data-room-type="Classroom" selected="@(Model.EditRoom?.Block == "Q")">Block Q</option>
                                        <option value="QA" data-room-type="Classroom" selected="@(Model.EditRoom?.Block == "QA")">Block QA</option>
                                        <option value="PA" data-room-type="Classroom" selected="@(Model.EditRoom?.Block == "PA")">Block PA</option>
                                        <option value="J" data-room-type="Classroom" selected="@(Model.EditRoom?.Block == "J")">Block J</option>
                                        <option value="G" data-room-type="Classroom" selected="@(Model.EditRoom?.Block == "G")">Block G</option>
                                        <option value="S" data-room-type="Classroom" selected="@(Model.EditRoom?.Block == "S")">Block S</option>
                                        <option value="W" data-room-type="Classroom" selected="@(Model.EditRoom?.Block == "W")">Block W</option>
                                        <option value="DK" data-room-type="Lecture Hall" selected="@(Model.EditRoom?.Block == "DK")">DK (Lecture Hall)</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="floor" class="font-weight-medium">Floor <span class="text-danger">*</span></label>
                                    <input type="number" class="form-control" id="floor" name="floor"
                                           value="@Model.EditRoom?.Floor"
                                           min="0" max="20">
                                </div>
                            </div>
                        </div>

                        <div class="form-group" id="statusGroup" style="@(Model.EditRoom != null ? "display:block;" : "display:none;")">
                            <label for="status" class="font-weight-medium">Status</label>
                            <select class="form-control" id="status" name="status">
                                <option value="Available" selected="@(Model.EditRoom?.Status == "Available")">Available</option>
                                <option value="Occupied" selected="@(Model.EditRoom?.Status == "Occupied")">Occupied</option>
                                <option value="Maintenance" selected="@(Model.EditRoom?.Status == "Maintenance")">Maintenance</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button class="btn btn-secondary closeBtn" type="button" data-dismiss="modal">
                            <i class="fas fa-times mr-1"></i> Cancel
                        </button>
                        <button class="btn btn-primary" type="submit" id="saveRoomBtn">
                            <i class="fas fa-save mr-1"></i> Add Room
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteRoomModal" tabindex="-1" role="dialog" aria-labelledby="deleteRoomModalLabel">
    <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title font-weight-semibold">Confirm Deletion</h5>
                <button class="close text-white" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <i class="fas fa-exclamation-triangle fa-3x text-danger"></i>
                </div>
                <p class="text-center mb-2">Are you sure you want to delete</p>
                <p class="text-center font-weight-bold mb-3"><span id="roomToDeleteName"></span>?</p>
                <p class="text-danger small text-center mb-0">
                    <i class="fas fa-info-circle mr-1"></i>This action cannot be undone.
                </p>
            </div>
            <div class="modal-footer bg-light">
                <button class="btn btn-secondary btn-sm" type="button" data-dismiss="modal">
                    <i class="fas fa-times mr-1"></i> Cancel
                </button>
                <form id="deleteForm" method="post" asp-controller="Admin" asp-action="DeleteRoom" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteRoomId" name="Id" />
                    <button class="btn btn-danger btn-sm" type="submit">
                        <i class="fas fa-trash mr-1"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
                  $(document).ready(function () {
            const url = new URL(window.location.href);
            const editId = url.searchParams.get("editId");

            if (editId) {
                @if (Model.EditRoom != null)
                {
                        <text>
                            $('#addEditRoomModal').modal('show');
                            $("#addEditRoomModalLabel").text("Edit Room: @Model.EditRoom.Id");
                            $("#saveRoomBtn").html('<i class="fas fa-save mr-1"></i> Update Room');
                            $("#RoomID").prop("readonly", true);
                            $("#roomType").prop("disabled", true);
                            $("#block").prop("disabled", true);
                            $("#floor").prop("disabled", true);
                            $("#statusGroup").show();
                            $("#roomForm").attr("action", "/Admin/EditRoom");
                        </text>
                }
            }

            $(".closeBtn").on("click", function () {
                window.location.href = '/Admin/RoomManagement';
            });

            // === FILTER FUNCTIONALITY ===
            function applyFilters() {
                const search = $('#searchInput').val();
                const type = $('#typeFilter').val();
                const block = $('#blockFilter').val();
                const status = $('#statusFilter').val();
                const sort = $('#roomSort').val();

                const params = new URLSearchParams();
                if (search) params.append('search', search);
                if (type) params.append('type', type);
                if (block) params.append('block', block);
                if (status) params.append('status', status);
                if (sort) params.append('sort', sort);

                $.ajax({
                    url: '/Admin/RoomManagement',
                    type: 'GET',
                    data: params.toString(),
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    success: function(data) {
                        $('#roomData').html(data);
                        const count = $('#roomsTableBody tr[data-room-id]').length;
                        $('#roomCount').text(count);
                    },
                    error: function() {
                        alert('Error loading rooms');
                    }
                });
            }

            // Trigger filter on change
            $('#searchInput, #typeFilter, #blockFilter, #statusFilter, #roomSort').on('change keyup', function() {
                // Debounce for search input
                if ($(this).attr('id') === 'searchInput') {
                    clearTimeout(window.searchTimeout);
                    window.searchTimeout = setTimeout(applyFilters, 500);
                } else {
                    applyFilters();
                }
            });

            // Handle type change for filtering blocks and setting floor constraints
            function handleTypeChange() {
                const selectedType = $("#roomType").val();
                const $blockSelect = $("#block");
                const $floorInput = $("#floor");

                if (selectedType === 'Lecture Hall') {
                    $blockSelect.prop('disabled', true);
                    $blockSelect.val('DK');
                    $floorInput.prop('disabled', true);
                    $floorInput.val('');
                    $floorInput.prop('required', false);

                    $blockSelect.find('option').each(function() {
                        if ($(this).val() === 'DK' || $(this).val() === '') {
                            $(this).show();
                        } else {
                            $(this).hide();
                        }
                    });
                } else if (selectedType === '') {
                    $blockSelect.prop('disabled', true);
                    $floorInput.prop('disabled', true);
                    $floorInput.prop('required', false);
                    $blockSelect.val('');
                    $floorInput.val('');
                } else {
                    $blockSelect.prop('disabled', false);
                    $floorInput.prop('disabled', false);
                    $floorInput.prop('required', true);

                    if (selectedType === 'Lab') {
                        $floorInput.attr('min', '0');
                        $floorInput.attr('max', '2');
                        $floorInput.attr('placeholder', 'Floor 0-2');
                    } else if (selectedType === 'Classroom') {
                        $floorInput.attr('min', '1');
                        $floorInput.attr('max', '3');
                        $floorInput.attr('placeholder', 'Floor 1-3');
                    }

                    $blockSelect.find('option').each(function() {
                        const $option = $(this);
                        const optionType = $option.data('room-type');

                        if (!optionType || optionType === selectedType) {
                            $option.show();
                        } else {
                            $option.hide();
                        }
                    });

                    const currentBlock = $blockSelect.val();
                    const currentOption = $blockSelect.find('option[value="' + currentBlock + '"]');
                    if (currentOption.is(':hidden')) {
                        $blockSelect.val('');
                    }
                }
            }

            $("#roomType").on("change", handleTypeChange);

            // Handle filter type change
            $("#typeFilter").on("change", function() {
                const selectedType = $(this).val();
                const $blockFilter = $("#blockFilter");

                if (selectedType === 'Lecture Hall') {
                    $blockFilter.prop('disabled', true);
                    $blockFilter.val('');
                } else {
                    $blockFilter.prop('disabled', false);

                    $blockFilter.find('option').each(function() {
                        const $option = $(this);
                        const optionType = $option.data('room-type');

                        if (!optionType) {
                            $option.show();
                        } else if (selectedType === '') {
                            $option.show();
                        } else if (selectedType !== optionType) {
                            $option.hide();
                        } else {
                            $option.show();
                        }
                    });

                    const currentBlock = $blockFilter.val();
                    const currentOption = $blockFilter.find('option[value="' + currentBlock + '"]');
                    if (currentOption.is(':hidden')) {
                        $blockFilter.val('');
                    }
                }
            });

            // Reset button
            $('button[type="reset"]').on('click', function() {
                $('#searchInput').val('');
                $('#typeFilter').val('');
                $('#blockFilter').val('');
                $('#statusFilter').val('');
                $('#roomSort').val('');

                setTimeout(function() {
                    window.location.href = '/Admin/RoomManagement';
                }, 100);
            });

            // Auto-dismiss alerts
            setTimeout(function() {
                $('.alert').each(function() {
                    $(this).find('.close').click();
                });
            }, 5000);

            // Export CSV
            $("#exportCsvBtn").on('click', function() {
                window.location.href = '@Url.Action("ExportRoomsCSV", "Admin")';
            });

            // Add Room button - reset form
            $("#addData").on('click', function() {
                $("#addEditRoomModalLabel").text("Add New Room");
                $("#saveRoomBtn").html('<i class="fas fa-save mr-1"></i> Add Room');
                $("#roomForm").attr("action", "/Admin/AddRoom");
                $("#RoomID").prop("readonly", false);
                $("#statusGroup").hide();
                $("#roomForm")[0].reset();

                // Disable block and floor until type is selected
                $("#block").prop('disabled', true);
                $("#floor").prop('disabled', true);
                $("#floor").prop('required', false);

                // Clear any error messages
                $('#roomFormError').remove();
            });

            // Handle Add Room form submission with AJAX
            $("#roomForm").on('submit', function(e) {
                // Only handle AJAX for Add Room, not Edit Room
                if ($(this).attr('action') === '/Admin/AddRoom') {
                    e.preventDefault();

                    // Clear previous error
                    $('#roomFormError').remove();

                    const formData = $(this).serialize();

                    $.ajax({
                        url: '/Admin/AddRoom',
                        type: 'POST',
                        data: formData,
                        success: function(response) {
                            if (response.success) {
                                // Close modal and show success message
                                $('#addEditRoomModal').modal('hide');

                                // Show success alert
                                const successAlert = `
                                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                                        <i class="fas fa-check-circle mr-2"></i>${response.message}
                                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                    </div>`;
                                $('.tab-content').prepend(successAlert);

                                // Refresh the room list
                                applyFilters();

                                // Auto-dismiss after 5 seconds
                                setTimeout(function() {
                                    $('.alert').alert('close');
                                }, 5000);
                            } else {
                                // Show error in modal
                                const errorHtml = `
                                    <div id="roomFormError" class="alert alert-danger alert-dismissible fade show" role="alert">
                                        <i class="fas fa-exclamation-circle mr-2"></i>${response.message}
                                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                    </div>`;

                                $('#roomForm .modal-body').prepend(errorHtml);
                            }
                        },
                        error: function() {
                            const errorHtml = `
                                <div id="roomFormError" class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <i class="fas fa-exclamation-circle mr-2"></i>An error occurred. Please try again.
                                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>`;

                            $('#roomForm .modal-body').prepend(errorHtml);
                        }
                    });
                }
            });
        });

        window.prepareDeleteModal = function(element) {
            const row = $(element).closest('tr');
            const roomName = row.attr('data-room-name');
            const roomId = row.attr('data-room-id');

            $('#roomToDeleteName').text('Room ' + roomName);
            $('#deleteRoomId').val(roomId);
        };
    </script>
}