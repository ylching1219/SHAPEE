@model GroupManageVM
<table class="table table-hover mb-0" id="facultyTable">
    <thead class="bg-light">
        <tr>
            <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold">Group Name</th>
            <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold">Program Id</th>
            <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold">Year Level</th>
            <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold">Semester</th>
            <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold">Number Of Student</th>
            <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold text-center">Actions</th>
        </tr>
    </thead>
    <tbody id="facultyTableBody">
        @if (Model.Groups!.Count() == 0)
        {
            <tr>
                <td colspan="6" class="text-center py-5">
                    <i class="fas fa-user-graduate fa-3x text-muted mb-3 d-block"></i>
                    <p class="text-muted mb-0">No group found</p>
                </td>
            </tr>
        }
        else
        {
            @foreach (var f in Model.Groups!)
            {
                <tr class="border-bottom">
                    <td class="px-4 py-3">
                        <div class="font-weight-medium text-gray-900">@f.GroupName</div>
                    </td>
                    <td class="px-4 py-3 text-muted">@f.ProgramId</td>
                    <td class="px-4 py-3 text-muted">@f.YearLevel</td>
                    <td class="px-4 py-3 text-muted">@f.Semester</td>
                    <td class="px-4 py-3 text-muted">@f.NumberOfStudents</td>
                    <td class="px-4 py-3 text-center">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-light" type="button" data-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-ellipsis-v"></i>
                            </button>
                            <div class="dropdown-menu dropdown-menu-right shadow-sm">
                                <a class="dropdown-item" href="@Url.Action("GroupManagement", "Admin", new { editId = f.Id })">
                                    <i class="fas fa-edit mr-2 text-primary"></i> Edit
                                </a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item text-danger" href="#" onclick="prepareDeleteModal(this); return false;" data-toggle="modal" data-target="#deleteFacultyModal">
                                    <i class="fas fa-trash mr-2"></i> Delete
                                </a>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>