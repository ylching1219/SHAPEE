<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteStudentModal" tabindex="-1" role="dialog" aria-labelledby="deleteStudentModalLabel">
    <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title font-weight-semibold">Confirm Deletion</h5>
                <button class="close text-white" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <i class="fas fa-exclamation-triangle fa-3x text-danger"></i>
                </div>
                <p class="text-center mb-2">Are you sure you want to delete</p>
                <p class="text-center font-weight-bold mb-3"><span id="studentToDeleteName"></span>?</p>
                <p class="text-danger small text-center mb-0">
                    <i class="fas fa-info-circle mr-1"></i>This action cannot be undone.
                </p>
            </div>
            <div class="modal-footer bg-light">
                <button class="btn btn-secondary btn-sm" type="button" data-dismiss="modal">
                    <i class="fas fa-times mr-1"></i> Cancel
                </button>
                <form id="deleteForm" method="post" asp-controller="Admin" asp-action="Delete" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteStudentId" name="Id" />
                    <button class="btn btn-danger btn-sm" type="submit">
                        <i class="fas fa-trash mr-1"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
        const url = new URL(window.location.href);
        const editId = url.searchParams.get("editId");

        if (editId) {
            // Check TempData server-side
            @if (Model.EditCourse != null)
            {
                <text>
                    $('#addEditModal').modal('show');      
                    $("#addEditModalLabel").text("Edit Program");
                    $("#saveBtn").html('<i class="fas fa-save mr-1"></i> Update Course');
                    $("#CourseId").prop("readonly", true);
                </text>
            }
        }

             $(".closeBtn").on("click", function() {
                  window.location.href = '/Admin/ProgramManagement';
        });

        });
    </script>

}