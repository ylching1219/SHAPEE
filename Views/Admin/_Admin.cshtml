@model IEnumerable<Admin>
@using System.Text.Json

@{
    var currentUserName = User?.Identity?.Name;
}

<table class="table table-hover mb-0" id="adminsTable">
    <thead class="bg-light">
        <tr>
            <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold">Admin ID</th>
            <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold">Name</th>
            <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold">Email</th>
            <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold">Contact</th>
            <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold">Status</th>
            <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold text-center">Actions</th>
        </tr>
    </thead>
    <tbody id="adminsTableBody">
        @if (Model.Count() == 0)
        {
            <tr>
                <td colspan="9" class="text-center py-5">
                    <i class="fas fa-user-shield fa-3x text-muted mb-3 d-block"></i>
                    <p class="text-muted mb-0">No admins found</p>
                </td>
            </tr>
        }
        else
        {
            foreach (var admin in Model)
            {
                var statusRaw = admin.Status ?? "Unknown";
                var status = statusRaw.Trim();
                var statusClass = status.ToLowerInvariant() switch
                {
                    "active" => "badge-success",
                    "inactive" => "badge-secondary",
                    "suspended" => "badge-warning",
                    _ => "badge-light"
                };
                var adminJson = JsonSerializer.Serialize(new
                {
                    admin.Id,
                    admin.FirstName,
                    admin.LastName,
                    admin.Email,
                    admin.Contact,
                    admin.Status
                });
                var isCurrentUser = admin.Id == currentUserName;

                <tr data-admin='@adminJson' data-admin-name="@admin.FullName" class="border-bottom @(isCurrentUser ? "bg-light" : "")">
                    <td class="px-4 py-3 text-muted">
                        @admin.Id
                        @if (isCurrentUser)
                        {
                            <span class="badge badge-info badge-sm ml-1">You</span>
                        }
                    </td>
                    <td class="px-4 py-3">
                        <div class="font-weight-medium text-gray-900">@admin.FullName</div>
                    </td>
                    <td class="px-4 py-3 text-muted">@admin.Email</td>
                    <td class="px-4 py-3 text-muted">@(admin.Contact ?? "N/A")</td>
                    <td class="px-4 py-3">
                        <span class="badge @statusClass badge-pill">@statusRaw</span>
                    </td>
                    <td class="px-4 py-3 text-center">
                        @if (isCurrentUser)
                        {
                            <!-- Limited actions for current user -->
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light" type="button" data-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-ellipsis-v"></i>
                                </button>
                                <div class="dropdown-menu dropdown-menu-right shadow-sm">
                                    <a class="dropdown-item" href="#" onclick="prepareEditModal(this); return false;" data-toggle="modal" data-target="#addEditAdminModal">
                                        <i class="fas fa-edit mr-2 text-primary"></i> Edit Profile
                                    </a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item disabled text-muted" href="#" onclick="return false;" title="You cannot suspend your own account">
                                        <i class="fas fa-ban mr-2"></i> Cannot Suspend Self
                                    </a>
                                    <a class="dropdown-item disabled text-muted" href="#" onclick="return false;" title="You cannot delete your own account">
                                        <i class="fas fa-ban mr-2"></i> Cannot Delete Self
                                    </a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- Full actions for other admins -->
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light" type="button" data-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-ellipsis-v"></i>
                                </button>
                                <div class="dropdown-menu dropdown-menu-right shadow-sm">
                                    <a class="dropdown-item" href="#" onclick="prepareEditModal(this); return false;" data-toggle="modal" data-target="#addEditAdminModal">
                                        <i class="fas fa-edit mr-2 text-primary"></i> Edit
                                    </a>
                                    <a class="dropdown-item" href="#" onclick="toggleSuspend('@admin.Id', this); return false;">
                                        <i class="fas fa-user-lock mr-2 text-warning"></i> @(status == "Suspended" ? "Activate" : "Suspend")
                                    </a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item text-danger" href="#" onclick="prepareDeleteModal(this); return false;" data-toggle="modal" data-target="#deleteAdminModal">
                                        <i class="fas fa-trash mr-2"></i> Delete
                                    </a>
                                </div>
                            </div>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>