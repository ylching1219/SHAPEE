@model SHAPEE.Models.PaymentMonitoringVM

<!-- Statistics Cards -->
<div class="row">
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Total Revenue</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">RM @Model.TotalRevenue.ToString("N2")</div>
                        <small class="text-muted">@(Model.Period == "all" ? "All Time" : Model.Period.ToUpper())</small>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-dollar-sign fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-warning shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Outstanding Payments</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">RM @Model.OutstandingPayments.ToString("N2")</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-exclamation-triangle fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-danger shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Overdue Payments Count</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.OverduePaymentsCount</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-clock fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Export Reports</div>
                        <div class="mt-2">
                            <a href="@Url.Action("ExportPaymentReportCsv", "Admin", new { period = Model.Period, startDate = Model.StartDate, endDate = Model.EndDate })" 
                               class="btn btn-sm btn-success">
                                <i class="fas fa-file-csv"></i> CSV
                            </a>
                            <a href="@Url.Action("ExportPaymentReportPdf", "Admin", new { period = Model.Period, startDate = Model.StartDate, endDate = Model.EndDate })" 
                               class="btn btn-sm btn-danger">
                                <i class="fas fa-file-pdf"></i> PDF
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Payment Trends Chart -->
<div class="row">
    <div class="col-lg-12">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Payment Trends @(Model.Period == "all" ? "(Last 12 Months)" : Model.Period == "today" ? "(Today)" : Model.Period == "week" ? "(Last 7 Days)" : Model.Period == "month" ? "(Last 30 Days)" : Model.Period == "year" ? "(Last Year)" : "(Selected Period)")</h6>
            </div>
            <div class="card-body">
                <canvas id="paymentTrendsChart" height="80"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Students with Overdue Payments -->
<div class="row">
    <div class="col-lg-12">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-primary">Students with Overdue Payments</h6>
                <button type="button" class="btn btn-danger btn-sm" id="sendOverdueRemindersBtn">
                    <i class="fas fa-exclamation-triangle"></i> Send Overdue Reminders
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    @if (Model.OverdueStudents.Any())
                    {
                        <table class="table table-hover mb-0" id="overduePaymentsTable">
                            <thead class="bg-light">
                                <tr>
                                    <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold">Student ID</th>
                                    <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold">Student Name</th>
                                    <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold">Invoice ID</th>
                                    <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold">Semester</th>
                                    <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold text-right">Amount</th>
                                    <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold">Due Date</th>
                                    <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold text-center">Days Overdue</th>
                                </tr>
                            </thead>
                            <tbody id="overduePaymentsTableBody">
                                @foreach (var student in Model.OverdueStudents)
                                {
                                    <tr class="border-bottom">
                                        <td class="px-4 py-3">
                                            <div class="font-weight-medium text-gray-900">@student.StudentId</div>
                                        </td>
                                        <td class="px-4 py-3">
                                            <div class="font-weight-medium text-gray-900">@student.StudentName</div>
                                        </td>
                                        <td class="px-4 py-3">
                                            <div class="font-weight-medium text-gray-900">@student.InvoiceId</div>
                                        </td>
                                        <td class="px-4 py-3">
                                            <div class="font-weight-medium text-gray-900">@student.SemesterId</div>
                                        </td>
                                        <td class="px-4 py-3 text-right">
                                            <div class="font-weight-bold text-danger">RM @student.Amount.ToString("N2")</div>
                                        </td>
                                        <td class="px-4 py-3 text-muted">
                                            <div>@student.DueDate.ToString("yyyy-MM-dd")</div>
                                        </td>
                                        <td class="px-4 py-3 text-center">
                                            <span class="badge badge-danger">
                                                <i class="fas fa-exclamation-circle"></i> @student.DaysOverdue days
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-clipboard-list fa-3x text-muted mb-3 d-block"></i>
                            <p class="text-muted mb-0">No overdue payments found</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    //initialize chart after content is loaded
    (function() {
        function initChart() {
            if (typeof Chart === 'undefined') {
                setTimeout(initChart, 100);
                return;
            }

            const canvas = document.getElementById('paymentTrendsChart');
            if (!canvas) {
                setTimeout(initChart, 100);
                return;
            }

            const trendsData = @Html.Raw(Json.Serialize(Model.PaymentTrends));
            
            //destroy existing chart if it exists
            const existingChart = Chart.getChart('paymentTrendsChart');
            if (existingChart) {
                existingChart.destroy();
            }
            
            const ctx = canvas.getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: trendsData.map(t => t.month),
                    datasets: [{
                        label: 'Revenue (RM)',
                        data: trendsData.map(t => t.amount),
                        borderColor: 'rgb(75, 192, 192)',
                        backgroundColor: 'rgba(75, 192, 192, 0.2)',
                        tension: 0.1,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return 'RM ' + value.toLocaleString();
                                }
                            }
                        }
                    },
                    plugins: {
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return 'RM ' + context.parsed.y.toLocaleString();
                                }
                            }
                        }
                    }
                }
            });
        }

        //start initialization
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initChart);
        } else {
            setTimeout(initChart, 50);
        }
    })();
</script>