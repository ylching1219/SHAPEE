@model RoomManageVM

<table class="table table-hover mb-0" id="roomTable">
    <thead class="bg-light">
        <tr>
            <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold">Room ID</th>
            <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold">Type</th>
            <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold">Block</th>
            <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold">Floor</th>
            <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold">Status</th>
            <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold text-center">Actions</th>
        </tr>
    </thead>
    <tbody id="roomsTableBody">
        @if (Model.Rooms.Count() == 0)
        {
            <tr>
                <td colspan="6" class="text-center py-5">
                    <i class="fas fa-door-closed fa-3x text-muted mb-3 d-block"></i>
                    <p class="text-muted mb-0">No rooms found</p>
                </td>
            </tr>
        }
        else
        {
            @foreach (var room in Model.Rooms)
            {
                var statusClass = room.Status switch
                {
                    "Available" => "success",
                    "Occupied" => "warning",
                    "Maintenance" => "danger",
                    _ => "secondary"
                };

                var typeIcon = room.Type switch
                {
                    "Classroom" => "fa-chalkboard-teacher",
                    "Lab" => "fa-flask",
                    "Lecture Hall" => "fa-building",
                    _ => "fa-door-open"
                };

                <tr class="border-bottom">
                    <td class="px-4 py-3">
                        <div class="d-flex align-items-center">
                            <div class="icon-circle bg-primary text-white mr-2" style="width: 35px; height: 35px; display: flex; align-items: center; justify-content: center; border-radius: 50%;">
                                <i class="fas @typeIcon fa-sm"></i>
                            </div>
                            <div class="font-weight-medium text-gray-900">@room.Id</div>
                        </div>
                    </td>
                    <td class="px-4 py-3">
                        <span class="badge badge-info">@room.Type</span>
                    </td>
                    <td class="px-4 py-3 text-muted">Block @room.Block</td>
                    <td class="px-4 py-3 text-muted">
                        @if (room.Floor.HasValue)
                        {
                            <span>Floor @room.Floor</span>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td class="px-4 py-3">
                        <span class="badge badge-@statusClass">@room.Status</span>
                    </td>
                    <td class="px-4 py-3 text-center">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-light" type="button" data-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-ellipsis-v"></i>
                            </button>
                            <div class="dropdown-menu dropdown-menu-right shadow-sm">
                                <a class="dropdown-item editBtn"
                                   data-ajax="true"
                                   data-ajax-method="GET"
                                   data-ajax-url="@Url.Action("RoomManagement", "Admin", new { editId = room.Id })"
                                   data-ajax-update="#AddEditData"
                                   data-ajax-success="onEditLoaded">
                                    <i class="fas fa-edit mr-2 text-primary"></i> Edit
                                </a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item text-danger" href="#" onclick="prepareDeleteModal(this); return false;"
                                   data-toggle="modal"
                                   data-target="#deleteModal"
                                   data-id="@room.Id"
                                   data-name="@room.Id">
                                    <i class="fas fa-trash mr-2"></i> Delete
                                </a>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>