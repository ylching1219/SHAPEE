@model SHAPEE.Models.PaymentTransactionManagementVM

<table class="table table-hover mb-0" id="paymentTransactionsTable">
    <thead class="bg-light">
        <tr>
            <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold">Receipt ID</th>
            <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold">Invoice ID</th>
            <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold">Student ID</th>
            <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold">Student Name</th>
            <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold">Semester</th>
            <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold">Transaction Date</th>
            <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold">Payment Method</th>
            <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold text-right">Amount Paid</th>
            <th class="border-0 px-4 py-3 text-uppercase text-muted small font-weight-semibold text-center">Actions</th>
        </tr>
    </thead>
    <tbody id="paymentTransactionsTableBody">
        @if (Model.Transactions == null || !Model.Transactions.Any())
        {
            <tr>
                <td colspan="9" class="text-center py-5">
                    <i class="fas fa-receipt fa-3x text-muted mb-3 d-block"></i>
                    <p class="text-muted mb-0">No payment transactions found</p>
                </td>
            </tr>
        }
        else
        {
            @foreach (var txn in Model.Transactions)
            {
                <tr class="border-bottom">
                    <td class="px-4 py-3">
                        <div class="font-weight-medium text-gray-900">@txn.ReceiptId</div>
                    </td>
                    <td class="px-4 py-3">
                        <div class="font-weight-medium text-gray-900">@txn.InvoiceId</div>
                    </td>
                    <td class="px-4 py-3">
                        <div class="font-weight-medium text-gray-900">@txn.StudentId</div>
                    </td>
                    <td class="px-4 py-3">
                        <div class="font-weight-medium text-gray-900">@txn.StudentName</div>
                    </td>
                    <td class="px-4 py-3">
                        <div class="font-weight-medium text-gray-900">@txn.SemesterId</div>
                    </td>
                    <td class="px-4 py-3 text-muted">
                        <div>@txn.TransactionDate.ToString("yyyy-MM-dd")</div>
                        <div class="small">@txn.TransactionDate.ToString("hh:mm:ss tt")</div>
                    </td>
                    <td class="px-4 py-3">
                        <span class="badge badge-info">@txn.PaymentMethod</span>
                    </td>
                    <td class="px-4 py-3 text-right">
                        <div class="font-weight-bold text-success">RM @txn.AmountPaid.ToString("N2")</div>
                    </td>
                    <td class="px-4 py-3 text-center">
                        <a href="@Url.Action("ViewReceipt", "Admin", new { receiptId = txn.ReceiptId })" 
                           target="_blank" 
                           class="btn btn-sm btn-info mr-1" 
                           title="View Receipt">
                            <i class="fas fa-eye"></i>
                        </a>
                        <a href="@Url.Action("DownloadReceipt", "Admin", new { receiptId = txn.ReceiptId })" 
                           class="btn btn-sm btn-primary" 
                           title="Download Receipt">
                            <i class="fas fa-download"></i>
                        </a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>