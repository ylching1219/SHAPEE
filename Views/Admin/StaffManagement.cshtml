@model IEnumerable<Staff>
@{
    var staff = Model?.ToList() ?? new List<Staff>();
    var staffCount = staff.Count;
}

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="card shadow-sm">
    <!-- Card Header -->
    <div class="card-header bg-white border-bottom py-3">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between">
            <h5 class="mb-3 mb-md-0 font-weight-semibold text-gray-800">
                Teaching Staff (<span id="staffCount">@staffCount</span>)
            </h5>
            <div class="d-flex gap-2">
                <button class="btn btn-primary btn-sm" data-toggle="modal" data-target="#addEditStaffModal" onclick="prepareAddStaffModal()">
                    <i class="fas fa-user-plus mr-1"></i> Add Staff
                </button>
                <button class="btn btn-outline-primary btn-sm" id="exportCsvBtn">
                    <i class="fas fa-download mr-1"></i> Export CSV
                </button>
            </div>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="card-body bg-light border-bottom">
        <form id="filterForm"
              data-ajax="true"
              data-ajax-method="GET"
              data-ajax-url="/Admin/StaffManagement"
              data-ajax-update="#staffData">
            <div class="row g-3">
                <div class="col-12 col-md-3">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-white">
                                <i class="fas fa-search text-muted"></i>
                            </span>
                        </div>
                        <input type="text" class="form-control" id="searchInput" name="name" placeholder="Search staff by name...">
                    </div>
                </div>
                <div class="col-12 col-md-3">
                    <select class="form-control" id="statusFilter" name="filter1">
                        <option value="">All Status</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                        <option value="Suspended">Suspended</option>
                        <option value="Locked">Locked</option>
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <select class="form-control" id="genderFilter" name="filter2">
                        <option value="">All Genders</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <select class="form-control" id="facultyFilter" name="filter3">
                        <option value="">All Faculties</option>
                        <option value="FOCS">FOCS</option>
                        <option value="FAFB">FAFB</option>
                        <option value="FAS">FAS</option>
                        <option value="FOET">FOET</option>
                    </select>
                </div>
                <div class="col-12 col-md-1">
                    <button type="reset" class="btn btn-secondary w-100" title="Reset filters">
                        <i class="fas fa-undo"></i>
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Staff Table -->
    <div class="card-body p-0">
        <div class="table-responsive">
            <div id="staffData">
                <partial name="_Staff" />
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Staff Modal -->
<div class="modal fade" id="addEditStaffModal" tabindex="-1" role="dialog" aria-labelledby="addEditStaffModalLabel">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title font-weight-semibold" id="addEditStaffModalLabel">Add New Staff</h5>
                <button class="close text-white" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="staffForm" method="post" asp-controller="Admin" asp-action="CreateStaff">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="staffId" name="Id" value="" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="staffFirstName" class="font-weight-medium">First Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="staffFirstName" name="firstName" required>
                                <div class="invalid-feedback">Please enter first name.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="staffLastName" class="font-weight-medium">Last Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="staffLastName" name="lastName" required>
                                <div class="invalid-feedback">Please enter last name.</div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="staffGender" class="font-weight-medium">Gender <span class="text-danger">*</span></label>
                        <select class="form-control" id="staffGender" name="gender" required>
                            <option value="">Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                        <div class="invalid-feedback">Please select gender.</div>
                    </div>

                    <div class="form-group">
                        <label for="staffEmail" class="font-weight-medium">Email <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" id="staffEmail" name="email" required>
                        <div class="invalid-feedback">Please enter a valid email.</div>
                    </div>

                    <div class="form-group">
                        <label for="contactNumber" class="font-weight-medium">Contact Number</label>
                        <input type="tel" class="form-control" id="contactNumber" name="contact"
                               placeholder="Contact Number" pattern="[0-9]*" inputmode="numeric">
                        <div class="invalid-feedback">Please enter numbers only.</div>
                    </div>

                    <div class="form-group">
                        <label for="staffFaculty" class="font-weight-medium">Faculty <span class="text-danger">*</span></label>
                        <select class="form-control" id="staffFaculty" name="facultyId" required>
                            <option value="">Select Faculty</option>
                            <option value="FOCS">Faculty of Computer Science (FOCS)</option>
                            <option value="FAFB">Faculty of Accountancy, Finance & Business (FAFB)</option>
                            <option value="FAS">Faculty of Applied Sciences (FAS)</option>
                            <option value="FOET">Faculty of Engineering & Technology (FOET)</option>
                        </select>
                        <div class="invalid-feedback">Please select a faculty.</div>
                    </div>

                    <div class="form-group" id="staffStatusGroup" style="display:none;">
                        <label for="staffStatus" class="font-weight-medium">Status</label>
                        <select class="form-control" id="staffStatus" name="status">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                            <option value="Suspended">Suspended</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i> Cancel
                    </button>
                    <button class="btn btn-primary" type="submit" id="saveStaffBtn">
                        <i class="fas fa-save mr-1"></i> Save Staff
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Staff Confirmation Modal -->
<div class="modal fade" id="deleteStaffModal" tabindex="-1" role="dialog" aria-labelledby="deleteStaffModalLabel">
    <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title font-weight-semibold">Confirm Deletion</h5>
                <button class="close text-white" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <i class="fas fa-exclamation-triangle fa-3x text-danger"></i>
                </div>
                <p class="text-center mb-2">Are you sure you want to delete</p>
                <p class="text-center font-weight-bold mb-3"><span id="staffToDeleteName"></span>?</p>
                <p class="text-danger small text-center mb-0">
                    <i class="fas fa-info-circle mr-1"></i>This action cannot be undone.
                </p>
            </div>
            <div class="modal-footer bg-light">
                <button class="btn btn-secondary btn-sm" type="button" data-dismiss="modal">
                    <i class="fas fa-times mr-1"></i> Cancel
                </button>
                <form id="deleteStaffForm" method="post" asp-controller="Admin" asp-action="DeleteStaff" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteStaffId" name="Id" />
                    <button class="btn btn-danger btn-sm" type="submit">
                        <i class="fas fa-trash mr-1"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const modalTitle = document.getElementById('addEditStaffModalLabel');
            const form = document.getElementById('staffForm');
            const statusGroup = document.getElementById('staffStatusGroup');
            const contactNumberInput = document.getElementById('contactNumber');

            contactNumberInput.addEventListener('input', function(e) {
            this.value = this.value.replace(/[^0-9]/g, '');
            });

            contactNumberInput.addEventListener('keypress', function(e) {
            const charCode = e.which ? e.which : e.keyCode;
            if (charCode > 31 && (charCode < 48 || charCode > 57)) {
                e.preventDefault();
                return false;
            }
            return true;
            });

            contactNumberInput.addEventListener('paste', function(e) {
            e.preventDefault();
            const pastedText = (e.clipboardData || window.clipboardData).getData('text');
            const numbersOnly = pastedText.replace(/[^0-9]/g, '');
            this.value = numbersOnly;
            });

            window.prepareAddStaffModal = function() {
                modalTitle.innerText = 'Add New Staff';
                form.setAttribute('action', '@Url.Action("CreateStaff", "Admin")');
                form.reset();
                document.getElementById('staffId').value = '';
                statusGroup.style.display = 'none';

                form.classList.remove('was-validated');
                document.querySelectorAll('.form-control').forEach(input => {
                    input.classList.remove('is-invalid');
                    input.classList.remove('is-valid');
                });
            };

            form.addEventListener('submit', function(e) {
                if (!form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);

        window.prepareEditModal = function(element) {
            const row = element.closest('tr');

            const staffId = row.getAttribute('data-staff-id');
            const firstName = row.getAttribute('data-first-name');
            const lastName = row.getAttribute('data-last-name');
            const gender = row.getAttribute('data-gender');
            const email = row.getAttribute('data-email');
            const contact = row.getAttribute('data-contact');
            const facultyId = row.getAttribute('data-faculty-id');
            const status = row.getAttribute('data-status');

            modalTitle.innerText = 'Edit Staff: ' + firstName + ' ' + lastName;
            form.setAttribute('action', '@Url.Action("EditStaff", "Admin")');

            document.getElementById('staffId').value = staffId;
            document.getElementById('staffFirstName').value = firstName;
            document.getElementById('staffLastName').value = lastName;
            document.getElementById('staffGender').value = gender || '';
            document.getElementById('staffEmail').value = email;
            document.getElementById('contactNumber').value = contact || '';
            document.getElementById('staffFaculty').value = facultyId || '';
            document.getElementById('staffStatus').value = (status || '').trim();

            statusGroup.style.display = 'block';

            form.classList.remove('was-validated');
            document.querySelectorAll('.form-control').forEach(input => {
                input.classList.remove('is-invalid');
                input.classList.remove('is-valid');
            });
        };

            window.prepareDeleteModal = function(element) {
                const row = element.closest('tr');
                const staffName = row.getAttribute('data-staff-name');
                const staffId = row.getAttribute('data-staff-id');

                document.getElementById('staffToDeleteName').innerText = staffName;
                document.getElementById('deleteStaffId').value = staffId;
            };

            window.toggleSuspend = function(staffId, element) {
                if (confirm('Are you sure you want to change this staff\'s status?')) {
                    const formData = new FormData();
                    formData.append('id', staffId);
                    formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

                    fetch('@Url.Action("SuspendStaff", "Admin")', {
                        method: 'POST',
                        body: formData
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            location.reload();
                        } else {
                            alert('Error: ' + data.message);
                        }
                    })
                    .catch(error => {
                        alert('Error: ' + error);
                    });
                }
            };

            setTimeout(function() {
                const alerts = document.querySelectorAll('.alert');
                alerts.forEach(alert => {
                    const closeBtn = alert.querySelector('.close');
                    if (closeBtn) {
                        closeBtn.click();
                    }
                });
            }, 5000);


          $("#exportCsvBtn").on("click", function () {

            const form = $("#filterForm")[0];
            const params = new URLSearchParams(new FormData(form));

            window.location.href = '/Admin/ExportStaffCsv?' + params.toString();
           });
        });
    </script>
}