<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Program Course Overview</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        .page-header {
            background: white;
            border-radius: 0.5rem;
            box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.075);
        }

        .program-header {
            background: linear-gradient(to right, #0d6efd, #0b5ed7);
            border-radius: 0.5rem;
            color: white;
        }

        .year-header {
            background: linear-gradient(to right, #212529, #495057);
            color: white;
        }

        .course-card {
            border: 1px solid #dee2e6;
            border-radius: 0.5rem;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .course-card:hover {
                border-color: #0d6efd;
                background-color: #e7f1ff;
                transform: translateY(-2px);
            }

                .course-card:hover .course-code {
                    color: #0d6efd;
                }

        .credits-badge {
            background-color: #e9ecef;
            font-size: 0.75rem;
        }

        .course-card:hover .credits-badge {
            background-color: #cfe2ff;
        }

        .modal-header-custom {
            background: linear-gradient(to right, #0d6efd, #0b5ed7);
            color: white;
        }

        .stat-card {
            background-color: #f8f9fa;
            border-radius: 0.5rem;
        }

        .empty-state {
            padding: 4rem 2rem;
            text-align: center;
            color: #6c757d;
        }

            .empty-state i {
                font-size: 4rem;
                color: #dee2e6;
            }
    </style>
</head>

<body class="bg-light">

    <div class="container py-4">

        <!-- Header -->
        <div class="page-header p-4 mb-4">
            <h1 class="display-5 fw-bold mb-2">Program Course Overview</h1>
            <p class="text-muted mb-0">Select faculty and program to view complete course structure</p>
        </div>

        <!-- Selection -->
        <div class="card shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Faculty</label>
                        <select id="faculty" class="form-select">
                            <option value="">Select Faculty</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Program</label>
                        <select id="program" class="form-select" disabled>
                            <option value="">Select Program</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary" onclick="viewOverview()">
                        <i class="bi bi-eye"></i> View Overview
                    </button>
                    <button class="btn btn-secondary" onclick="resetForm()">
                        <i class="bi bi-arrow-clockwise"></i> Reset
                    </button>
                </div>
            </div>
        </div>

        <!-- Overview -->
        <div id="overview"></div>

        <div class="text-center mt-5 text-muted">
            &copy; TARUMT 2025
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="courseModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-header-custom border-0">
                    <div>
                        <h5 class="modal-title fw-bold" id="modalCode"></h5>
                        <p class="mb-0 small opacity-75" id="modalName"></p>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="row g-3 mb-4">
                        <div class="col-4">
                            <div class="stat-card p-3 text-center">
                                <p class="small text-muted mb-1">Year & Semester</p>
                                <p class="fw-semibold mb-0" id="modalYear"></p>
                                <p class="small text-muted mb-0" id="modalSemester"></p>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="stat-card p-3 text-center">
                                <p class="small text-muted mb-1">Credits</p>
                                <p class="display-6 fw-bold text-primary mb-0" id="modalCredits"></p>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="stat-card p-3 text-center">
                                <p class="small text-muted mb-1">Enrolled</p>
                                <p class="display-6 fw-bold text-success mb-0" id="modalEnrolled"></p>
                            </div>
                        </div>
                    </div>

                    <hr>

                    <div class="empty-state">
                        <i class="bi bi-people"></i>
                        <p class="mt-2 mb-0">Student management coming soon</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const faculties = [
            "Faculty of Engineering",
            "Faculty of Science",
            "Faculty of Business",
            "Faculty of Arts"
        ];

        const programsByFaculty = {
            "Faculty of Engineering": ["Computer Science"],
            "Faculty of Business": ["Business Administration"]
        };

        const programCourses = {
            "Computer Science": {
                "Year 1": {
                    "Semester 1": [
                        { code: "CS101", name: "Introduction to Programming", credits: 3, enrolled: 45 },
                        { code: "MATH101", name: "Calculus I", credits: 3, enrolled: 48 }
                    ]
                }
            }
        };

        const facultySelect = document.getElementById("faculty");
        const programSelect = document.getElementById("program");
        const overview = document.getElementById("overview");
        const modal = new bootstrap.Modal(document.getElementById("courseModal"));

        faculties.forEach(f => {
            facultySelect.innerHTML += `<option value="${f}">${f}</option>`;
        });

        facultySelect.addEventListener("change", () => {
            programSelect.innerHTML = `<option value="">Select Program</option>`;
            programSelect.disabled = !facultySelect.value;
            overview.innerHTML = "";

            (programsByFaculty[facultySelect.value] || []).forEach(p => {
                programSelect.innerHTML += `<option value="${p}">${p}</option>`;
            });
        });

        function viewOverview() {
            overview.innerHTML = "";
            const program = programSelect.value;
            const data = programCourses[program];

            if (!data) {
                overview.innerHTML = `<div class="card p-5 text-center text-muted">No data available</div>`;
                return;
            }

            for (const year in data) {
                let yearHtml = `
                    <div class="card mb-4 shadow-sm">
                        <div class="year-header p-3"><h5>${year}</h5></div>
                        <div class="card-body row g-3">
                `;

                for (const sem in data[year]) {
                    yearHtml += `<div class="col-md-4"><h6>${sem}</h6>`;
                    data[year][sem].forEach(c => {
                        yearHtml += `
                        <div class="course-card p-3 mb-2"
                             data-code="${c.code}"
                             data-name="${c.name}"
                             data-credits="${c.credits}"
                             data-enrolled="${c.enrolled}"
                             data-year="${year}"
                             data-semester="${sem}"
                             onclick="openModal(this)">
                            <div class="d-flex justify-content-between">
                                <span class="course-code fw-semibold">${c.code}</span>
                                <span class="badge credits-badge">${c.credits} CR</span>
                            </div>
                            <small class="text-muted">${c.name}</small>
                        </div>`;
                    });
                    yearHtml += `</div>`;
                }

                yearHtml += `</div></div>`;
                overview.innerHTML += yearHtml;
            }
        }

        function openModal(el) {
            modalCode.textContent = el.dataset.code;
            modalName.textContent = el.dataset.name;
            modalCredits.textContent = el.dataset.credits;
            modalEnrolled.textContent = el.dataset.enrolled;
            modalYear.textContent = el.dataset.year;
            modalSemester.textContent = el.dataset.semester;
            modal.show();
        }

        function resetForm() {
            facultySelect.value = "";
            programSelect.value = "";
            programSelect.disabled = true;
            programSelect.innerHTML = `<option value="">Select Program</option>`;
            overview.innerHTML = "";
        }
    </script>

</body>
</html>
