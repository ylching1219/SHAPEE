@model ProgramCourseVM
<style>
    .page-header {
        background: white;
        border-radius: 0.5rem;
        box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.075);
    }

    .program-header {
        background: linear-gradient(to right, #0d6efd, #0b5ed7);
        border-radius: 0.5rem;
        color: white;
    }

    .year-header {
        background: linear-gradient(to right, #212529, #495057);
        color: white;
    }

    .course-card {
        border: 1px solid #dee2e6;
        border-radius: 0.5rem;
        transition: all 0.2s;
        cursor: pointer;
    }

        .course-card:hover {
            border-color: #dc3545;
            background-color: #f8d7da;
            transform: translateY(-2px);
        }

            .course-card:hover .course-code {
                color: #dc3545;
            }

    .credits-badge {
        background-color: #e9ecef;
        font-size: 0.75rem;
    }

    .course-card:hover .credits-badge {
        background-color: #f1aeb5;
    }

    .modal-header-custom {
        background: linear-gradient(to right, #0d6efd, #0b5ed7);
        color: white;
    }

    .modal-header-danger {
        background: linear-gradient(to right, #dc3545, #bb2d3b);
        color: white;
    }

    .stat-card {
        background-color: #f8f9fa;
        border-radius: 0.5rem;
    }

    .empty-state {
        padding: 4rem 2rem;
        text-align: center;
        color: #6c757d;
    }

        .empty-state i {
            font-size: 4rem;
            color: #dee2e6;
        }

    .add-course-btn {
        position: sticky;
        top: 1rem;
        z-index: 100;
    }

    .warning-text {
        background-color: #fff3cd;
        border-left: 4px solid #ffc107;
    }
</style>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div id="alertContainer"></div>
<!-- Header -->
<div class="page-header p-4 mb-4">
    <h1 class="display-5 fw-bold mb-2">Program Course Assignment</h1>
    <p class="text-muted mb-0">Select faculty and program to view , add and remove course structure</p>
</div>

<!-- Selection -->
<div class="card shadow-sm mb-4">
    <div class="card-body p-4">
        <form id="submitForm"
              data-ajax="true"
              data-ajax-method="GET"
              data-ajax-url="/Admin/ProgramCourse"
              data-ajax-update="#overview">
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Faculty</label>
                    <select id="faculty" class="form-control" name="facultyId">
                        <option value="">Select Faculty</option>
                        @foreach (var f in Model.Faculties!)
                        {
                            <option value="@f.Id">@f.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Program</label>
                    <select id="program" class="form-control" name="programId" disabled>
                        <option value="">Select Program</option>
                    </select>
                </div>
            </div>

            <div class="mt-3">
                <button type="reset" class="btn btn-secondary" onclick="resetForm()">
                    <i class="bi bi-arrow-clockwise"></i> Reset
                </button>
            </div>

        </form>
    </div>


</div>

<!-- Overview -->
<div id="overview">
    <partial name="_ProgramCourse" />
</div>



<!-- Add Course Modal -->
<div class="modal fade" id="addCourseModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header modal-header-custom border-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-plus-circle me-2"></i>Add New Course
                </h5>
                <button class="close text-white" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="addCourseForm">
                <div class="modal-body p-4">

                    <input type="hidden" name="programId" id="programId" value="" />
                    <div class="mb-3">
                        <label for="Course" class="form-label fw-semibold">Course</label>
                        <select class="select2"
                                asp-for="CourseId"
                                asp-items="@ViewBag.CourseList"
                                required>
                            <option value="">Select Course</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="courseYear" class="form-label fw-semibold">Year</label>
                        <select class="form-control" id="courseYear" name="yearLevel" required>
                            <option value="">Select Year</option>
                            <option value="1">Year 1</option>
                            <option value="2">Year 2</option>
                            <option value="3">Year 3</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="courseSemester" class="form-label fw-semibold">Semester</label>
                        <select class="form-control" id="courseSemester" name="semester" required>
                            <option value="">Select Semester</option>
                            <option value="1">Semester 1</option>
                            <option value="2">Semester 2</option>
                            <option value="3">Semester 3</option>
                        </select>
                    </div>

                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" type="button" data-dismiss="modal">
                        <i class="fas fa-times mr-1"></i> Cancel
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-1"></i> Add Course
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <input type="hidden" id="deleteCourseId">
            <input type="hidden" id="deleteProgramId">

            <div class="modal-header modal-header-danger border-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-exclamation-triangle me-2"></i>Confirm Delete
                </h5>
                <button class="close text-white" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-4">
                <p class="mb-3">Are you sure you want to remove this course in this program?</p>
                <div class="alert alert-danger mb-0">
                    <strong id="deleteCode"></strong> - <span id="deleteName"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary btn-sm" type="button" data-dismiss="modal">
                    <i class="fas fa-times mr-1"></i> Cancel
                </button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">
                    <i class="bi bi-trash me-1"></i> Remove Course
                </button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        $('#addCourseForm .select2').select2({
                theme: 'bootstrap-5',
                width: '100%',
                minimumResultsForSearch: 0,
                dropdownParent: $('#addCourseForm')
         });

        $("#faculty").on("change", function () {

            const facultyId = $(this).val();
             $("#overview").html(`
                   <div class="card shadow-sm">
                        <div class="card-body empty-state">
                            <i class="bi bi-book"></i>
                            <p class="mt-2 mb-0">Please select a Faculty and Program to view the courses.</p>
                        </div>
                    </div>
            `);

            $("#program").empty().append('<option value="">Select Program</option>');
            $("#program").prop("disabled", true);


            if (!facultyId) return;

            $.ajax({
                url: '/Admin/GetProgramFromFaculty',
                type: 'GET',
                data: {
                    facultyId: facultyId
                },
                dataType: 'json',
                success: function (data) {

                    if (data.length === 0) {
                        console.log("No programs found");
                        return;
                    }

                    data.forEach(function (p) {
                        $("#program").append(
                            `<option value="${p.id}">${p.name}</option>`
                        );
                    });

                    $("#program").prop("disabled", false);
                },
                error: function (xhr, status, error) {
                    console.error('Error loading programs:', error);
                }
            });
        });

        $("#program").on("change", function () {
            $("#submitForm").submit();
        });


        function openAddCourseModal() {
            $('#addCourseForm')[0].reset();
            $("#addCourseModal").modal("show");
            $("#programId").val($("#program").val());
        }

        function openDeleteModal(courseId, courseName) {
            $('#deleteCode').text(courseId);
            $('#deleteName').text(courseName);

            $('#deleteCourseId').val(courseId);
            $('#deleteProgramId').val($("#program").val());

            $("#deleteModal").modal("show");
        }

        function confirmDelete(){
            const courseId = $('#deleteCourseId').val();
            const programId = $('#deleteProgramId').val();
            if (!courseId && programId) return;

            $.ajax({
                url: '/Admin/RemoveCourseFromProgram',
                type: 'POST',
                data: {
                     courseId: courseId,
                     programId: programId,
                },
                dataType: 'json',
                success: function (res) {

                    if(res.success){
                        $("#deleteModal").modal("hide");
                        $("#submitForm").submit();
                        showAlert("success",res.message);
                    } else {
                        $("#deleteModal").modal("hide");
                        showAlert("danger",res.message);
                    }

                },
                error: function (xhr, status, error) {
                    console.error('Error loading programs:', error);
                    showAlert("danger","An error occurred while removing the course.");
                }
            });
        }

        $("#addCourseForm").on("submit", function (e) {
            e.preventDefault();

            if (!this.checkValidity()) {
                this.reportValidity();
                return;
            }

            $.ajax({
                url: '@Url.Action("AddCourseToProgram", "Admin")',
                type: 'POST',
                data: $(this).serialize(),
                dataType: 'json',
                success: function (res) {

                    $("#addCourseModal").modal("hide");

                    if (res.success) {
                        showAlert("success", res.message);
                        $("#submitForm").submit();
                    } else {
                        showAlert("danger", res.message);
                    }

                    $("#addCourseForm")[0].reset();
                    $(".select2").val(null).trigger("change");
                },
                error: function () {
                    showAlert("danger", "An error occurred while adding the course.");
                }
            });
        });

        function resetForm() {
            $("#program").prop("disabled", true);
            $("#program").empty().append('<option value="">Select Program</option>');

            $("#overview").html(`
                   <div class="card shadow-sm">
                        <div class="card-body empty-state">
                            <i class="bi bi-book"></i>
                            <p class="mt-2 mb-0">Please select a Faculty and Program to view the courses.</p>
                        </div>
                    </div>
            `);
        }

          function showAlert(type, message) {
            let icon = '';
            if (type === 'success') {
                icon = '<i class="fas fa-check-circle me-2"></i>'; // success icon
            } else if (type === 'danger') {
                icon = '<i class="fas fa-exclamation-circle me-2"></i>'; // danger icon
            }

            const alertHtml = `
                <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${icon}${message}
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            `;

            $('#alertContainer').html(alertHtml);
        }

    </script>
}


