@model GroupManageVM

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<!-- Header -->
<div class="bg-white border-bottom px-4 py-3 mb-4">
    <h1 class="h3 mb-0 text-gray-800">Group Management</h1>
</div>



<div class="tab-content" id="ProgramCourseTabContent">

    <div class="tab-pane fade show active" id="groups" role="tabpanel">
        <div class="card shadow-sm">
            <!-- Card Header -->
            <div class="card-header bg-white border-bottom py-3">
                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between">
                    <h5 class="mb-3 mb-md-0 font-weight-semibold text-gray-800">
                        Groups
                    </h5>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary btn-sm" data-toggle="modal" data-target="#addEditModal" id="addData">
                            <i class="fas fa-user-plus mr-1"></i> Assign New Course To Program
                        </button>
                        <button class="btn btn-outline-primary btn-sm" id="exportCsvBtn">
                            <i class="fas fa-download mr-1"></i> Export CSV
                        </button>

                    </div>
                </div>
            </div>

            <!-- Filters Section -->
            <div class="card-body bg-light border-bottom">
                <form id="filterForm"
                      data-ajax="true"
                      data-ajax-method="GET"
                      data-ajax-url="/Admin/GroupManagement"
                      data-ajax-update="#groupData">
                    <div class="row g-3">
                        <div class="col-12 col-md-5">
                            <select asp-for="ProgramId"
                                    asp-items="ViewBag.ProgramList"
                                    class="select2 filter">
                                <option value="">Select Program</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-3">
                            <select class="form-control filter" id="yearLevel" name="yearLevel" required>
                                <option value="">All Year</option>
                                <option value="1">Year 1</option>
                                <option value="2">Year 2</option>
                                <option value="3">Year 3</option>
                                <option value="4">Year 4</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-3">
                            <select class="form-control filter" id="semester" name="semester" required>
                                <option value="">All Semester</option>
                                <option value="1">Sem 1</option>
                                <option value="2">Sem 2</option>
                                <option value="3">Sem 3</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-1">
                            <button type="reset" class="btn btn-secondary w-100" title="Reset filters">
                                <i class="fas fa-undo"></i>
                            </button>
                        </div>

                    </div>
                </form>
            </div>

            <!-- Faculty Table -->
            <div class="card-body p-0">
                <div class="table-responsive">
                    <div id="groupData">
                        <partial name="_ProgramCourse" />
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>



<div class="modal fade" id="addEditModal" tabindex="-1" role="dialog" aria-labelledby="addEditModalLabel">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title font-weight-semibold" id="addEditModalLabel">Add New Faculty</h5>
                <button class="close text-white closeBtn" type="button" data-dismiss="modal" aria-label="Close" onclick="onAddLoaded()">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div id="AddEditData">
                <form id="addEditForm"
                      method="post"
                      asp-controller="Admin"
                      asp-action="AddGroup">
                    <div class="modal-body">

                        <div class="form-group">
                            <label for="ProgramId" class="font-weight-medium">Group Number<span class="text-danger">*</span></label>
                            <input asp-for="GroupNumber" type="number" class="form-control" id="GroupNumber" name="GroupNumber"
                                   required>
                            <span asp-validation-for="GroupNumber" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label for="ProgramId" class="font-weight-medium">Program<span class="text-danger">*</span></label>
                            <select asp-for="ProgramId" id="test"
                                    asp-items="ViewBag.ProgramList"
                                    class="select2">
                                <option value="">Select Program</option>
                            </select>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="yearLevel" class="font-weight-medium">Year <span class="text-danger">*</span></label>
                                    <select class="form-control" id="yearLevel" name="yearLevel" required>
                                        <option value="">Year</option>
                                        <option value="1">1</option>
                                        <option value="2">2</option>
                                        <option value="3">3</option>
                                        <option value="4">4</option>
                                    </select>
                                    <div class="invalid-feedback">Please select year level.</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="semester" class="font-weight-medium">Semester <span class="text-danger">*</span></label>
                                    <select class="form-control" id="semester" name="semester" required>
                                        <option value="">Semester</option>
                                        <option value="1">1</option>
                                        <option value="2">2</option>
                                        <option value="3">3</option>
                                    </select>
                                    <div class="invalid-feedback">Please select semester.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button class="btn btn closeBtn" type="button" data-dismiss="modal">
                            <i class="fas fa-times mr-1"></i> Cancel
                        </button>
                        <button class="btn btn-primary" type="submit" id="saveBtn">
                            <i class="fas fa-save mr-1"></i> Add Program
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>



<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel">
    <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title font-weight-semibold">Confirm Deletion</h5>
                <button class="close text-white" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <i class="fas fa-exclamation-triangle fa-3x text-danger"></i>
                </div>
                <p class="text-center mb-2">Are you sure you want to delete</p>
                <p class="text-center font-weight-bold mb-3"><span id="ToDeleteName"></span>?</p>
                <p class="text-danger small text-center mb-0">
                    <i class="fas fa-info-circle mr-1"></i>This action cannot be undone.
                </p>
            </div>
            <div class="modal-footer bg-light">
                <button class="btn btn-secondary btn-sm" type="button" data-dismiss="modal">
                    <i class="fas fa-times mr-1"></i> Cancel
                </button>
                <form id="deleteForm" method="post" asp-controller="Admin" asp-action="DeleteGroup" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteId" name="Id" />
                    <button class="btn btn-danger btn-sm" type="submit">
                        <i class="fas fa-trash mr-1"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>


        function prepareDeleteModal(element) {
            var id = $(element).data("id");
            var name = $(element).data("groupname");

            // Set hidden input value for form submission
            $("#deleteId").val(id);

            // Display name in modal
            $("#ToDeleteName").text(name);
        }

        function initSelect2() {
            // Page dropdowns (outside modal)
            $('#filterForm .select2').select2({
                theme: 'bootstrap-5',
                width: '100%',
                minimumResultsForSearch: 0
            });

            // Modal dropdowns
            $('#addEditModal .select2').select2({
                theme: 'bootstrap-5',
                width: '100%',
                minimumResultsForSearch: 0,
                dropdownParent: $('#addEditModal')
            });
        }



        $(document).ready(function () {
            initSelect2();

            $("#exportCsvBtn").on("click", function () {

                const form = $("#filterForm")[0];
                const params = new URLSearchParams(new FormData(form));

                // Redirect to export action with filters
                window.location.href = '/Admin/ExportGroupsCsv?' + params.toString();
            });
        });

        $('#addEditModal').on('shown.bs.modal', function () {
            initSelect2();
        });



    </script>

}