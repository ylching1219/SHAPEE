@model FacultyManageVM
@{
    ViewData["Title"] = "Faculty Management";
}

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle mr-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<!-- Header -->
<div class="bg-white border-bottom px-4 py-3 mb-4">
    <h1 class="h3 mb-0 text-gray-800">Faculty Management</h1>
</div>



<div class="tab-content" id="FacultyManagementTabContent">
    <!-- Faculties Tab -->
    <div class="tab-pane fade show active" id="faculties" role="tabpanel">
        <div class="card shadow-sm">
            <!-- Card Header -->
            <div class="card-header bg-white border-bottom py-3">
                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between">
                    <h5 class="mb-3 mb-md-0 font-weight-semibold text-gray-800">
                        Faculties (<span id="facultyCount">@Model.Faculties.Count()</span>)
                    </h5>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary btn-sm" data-toggle="modal" data-target="#addEditModal" id="addData">
                            <i class="fas fa-user-plus mr-1"></i> Add Faculty
                        </button>
                        <button class="btn btn-outline-primary btn-sm" id="exportCsvBtn">
                            <i class="fas fa-download mr-1"></i> Export CSV
                        </button>
                    </div>
                </div>
            </div>

            <!-- Filters Section -->
            <div class="card-body bg-light border-bottom">
                <form id="filterForm"
                      data-ajax="true"
                      data-ajax-method="GET"
                      data-ajax-url="/Admin/FacultyManagement"
                      data-ajax-update="#facultyData">
                    <div class="row g-3">
                        <div class="col-12 col-md-5">
                            <div class="input-group">
                                <span class="input-group-text bg-white">
                                    <i class="fas fa-search text-muted"></i>
                                </span>
                                <input type="text"
                                       class="form-control"
                                       name="name"
                                       id="searchInput"
                                       placeholder="Search faculties..." />
                            </div>
                        </div>
                        <div class="col-12 col-md-2"></div>
                        <div class="col-12 col-md-4">
                            <div class="d-flex align-items-center">
                                <span class="me-2 text-nowrap">Sort By:</span>
                                <select class="form-control" name="sort" id="filter">
                                    <option value="">Program Code by Ascending</option>
                                    <option value="1">Program Code by Descending</option>
                                    <option value="2">Program Name by Ascending</option>
                                    <option value="3">Program Name by Descending</option>
                                    <option value="4">Cost Low to High</option>
                                    <option value="5">Cost High to Low</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-12 col-md-1">
                            <button type="reset" class="btn btn-secondary w-100" title="Reset filters">
                                <i class="fas fa-undo"></i>
                            </button>
                        </div>

                    </div>
                </form>
            </div>

            <!-- Faculty Table -->
            <div class="card-body p-0">
                <div class="table-responsive">
                    <div id="facultyData">
                        <partial name="_Faculty" />
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>



<div class="modal fade" id="addEditModal" tabindex="-1" role="dialog" aria-labelledby="addEditModalLabel">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title font-weight-semibold" id="addEditModalLabel">Add New Faculty</h5>
                <button class="close text-white closeBtn" type="button" data-dismiss="modal" aria-label="Close" >
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div id="AddEditData">
                <form id="addEditForm" method="post" asp-controller="Admin" asp-action="AddFaculty">
                    <div class="modal-body">

                        <div class="form-group">
                            <label for="FacultyId" class="font-weight-medium">Faculty ID <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="FacultyId" name="facultyId"
                                   value="@(Model.EditFaculty?.Id != null ? Model.EditFaculty.Id : "")"
                                   required>
                        </div>

                        <div class="form-group">
                            <div class="form-group">
                                <label for="FacultyName" class="font-weight-medium">Faculty Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="FacultyName" name="facultyName"
                                       value="@(Model.EditFaculty?.Name != null ? Model.EditFaculty.Name : "")"
                                       required>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="CostPerCreditHour" class="font-weight-medium">Cost Per Credit Hour<span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="CostPerCreditHour" name="costPerCreditHour" step="0.01"
                                   value="@Model.EditFaculty?.CostPerCreditHour"
                                   required>
                        </div>

                    </div>
                    <div class="modal-footer bg-light">
                        <button class="btn btn closeBtn" type="button" data-dismiss="modal" closeBtn>
                            <i class="fas fa-times mr-1"></i> Cancel
                        </button>
                        <button class="btn btn-primary" type="submit" id="saveBtn">
                            <i class="fas fa-save mr-1"></i> Add Faculty
                        </button>
                    </div>
                </form>
            </div>
           
        </div>
    </div>
</div>





<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteFacultyModal" tabindex="-1" role="dialog" aria-labelledby="deleteFacultyModalLabel">
    <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title font-weight-semibold">Confirm Deletion</h5>
                <button class="close text-white" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <i class="fas fa-exclamation-triangle fa-3x text-danger"></i>
                </div>
                <p class="text-center mb-2">Are you sure you want to delete</p>
                <p class="text-center font-weight-bold mb-3"><span id="facultyToDeleteName"></span>?</p>
                <p class="text-danger small text-center mb-0">
                    <i class="fas fa-info-circle mr-1"></i>This action cannot be undone.
                </p>
            </div>
            <div class="modal-footer bg-light">
                <button class="btn btn-secondary btn-sm" type="button" data-dismiss="modal">
                    <i class="fas fa-times mr-1"></i> Cancel
                </button>
                <form id="deleteForm" method="post" asp-controller="Admin" asp-action="DeleteFaculty" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteFacultyId" name="Id" />
                    <button class="btn btn-danger btn-sm" type="submit">
                        <i class="fas fa-trash mr-1"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#addData').on('click', function () {
                $('#addEditModalLabel').text('Add New Faculty');
                $('#saveBtn').html('<i class="fas fa-save mr-1"></i> Add Faculty');
                $('#addEditForm')[0].reset();
                $('#addEditForm').attr('action', '/Admin/AddFaculty');
                $('#FacultyId').prop('readonly', false);

                $('#addEditForm').removeClass('was-validated');
                $('.form-control').removeClass('is-invalid is-valid');
            });

            $(".closeBtn").on("click", function () {
                $('#addEditModal').modal('hide');
            });

            setTimeout(function () {
                const alerts = document.querySelectorAll('.alert');
                alerts.forEach(alert => {
                    const closeBtn = alert.querySelector('.close');
                    if (closeBtn) {
                        closeBtn.click();
                    }
                });
            }, 5000);
        });

        window.prepareEditModal = function(element) {
            const row = element.closest('tr');

            const facultyId = row.getAttribute('data-faculty-id');
            const facultyName = row.getAttribute('data-faculty-name');
            const costPerCreditHour = row.getAttribute('data-cost-per-credit-hour');

            $('#addEditModalLabel').text('Edit Faculty');
            $('#saveBtn').html('<i class="fas fa-save mr-1"></i> Update Faculty');
            $('#addEditForm').attr('action', '/Admin/EditFaculty');

            $('#FacultyId').val(facultyId).prop('readonly', true);
            $('#FacultyName').val(facultyName);
            $('#CostPerCreditHour').val(costPerCreditHour);

            $('#addEditForm').removeClass('was-validated');
            $('.form-control').removeClass('is-invalid is-valid');

            $('#addEditModal').modal('show');
        };

        window.prepareDeleteModal = function(element) {
            const row = element.closest('tr');
            const facultyName = row.getAttribute('data-faculty-name');
            const facultyId = row.getAttribute('data-faculty-id');

            document.getElementById('facultyToDeleteName').innerText = facultyName;
            document.getElementById('deleteFacultyId').value = facultyId;
        };

        $("#exportCsvBtn").on("click", function () {

        const form = $("#filterForm")[0];
        const params = new URLSearchParams(new FormData(form));

        window.location.href = '/Admin/ExportFacultiesCsv?' + params.toString();
        });
    </script>

}