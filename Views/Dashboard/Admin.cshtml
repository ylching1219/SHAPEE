@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Admin Dashboard</h1>
</div>

<div class="row">
    <!--total students-->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Students</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">1,245</div>
                        <div class="text-xs text-success mt-1">
                            <i class="fas fa-arrow-up"></i> 5% increase this month
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-users fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--total teachers-->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Total Teachers</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">45</div>
                        <div class="text-xs text-success mt-1">
                            <i class="fas fa-arrow-up"></i> 3% increase this month
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-chalkboard-teacher fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--total classes-->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Total Classes</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">128</div>
                        <div class="text-xs text-success mt-1">
                            <i class="fas fa-arrow-up"></i> 8% increase this month
                        </div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-book fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--system status-->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-warning shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">System Status</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">Active</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-server fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- analytics chart-->
<div class="row mb-4">
    <div class="col-12">
        <div class="card shadow">
            <div class="card-header py-3">
                <div class="d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">Analytics Overview</h6>
                    <div class="d-flex align-items-center">
                        <div class="mr-3">
                            <label class="text-xs text-gray-600 mb-0" for="dataTypeSelect">
                                <i class="fas fa-filter"></i> Data Type
                            </label>
                            <select id="dataTypeSelect" class="form-control form-control-sm border-0 shadow-sm" style="min-width: 140px; font-size: 0.875rem;">
                                <option value="students">Students</option>
                                <option value="staff">Staff</option>
                                <option value="classes">Classes</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-xs text-gray-600 mb-0" for="timelineSelect">
                                <i class="fas fa-calendar-alt"></i> Timeline
                            </label>
                            <select id="timelineSelect" class="form-control form-control-sm border-0 shadow-sm" style="min-width: 140px; font-size: 0.875rem;">
                                <option value="7days">7 Days</option>
                                <option value="30days" selected>30 Days</option>
                                <option value="3months">3 Months</option>
                                <option value="6months">6 Months</option>
                                <option value="1year">1 Year</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <canvas id="analyticsChart" height="80"></canvas>
            </div>
        </div>
    </div>
</div>


<div class="row">
    <!--recent activity-->
    <div class="col-lg-8 mb-4">
        <div class="card shadow h-100">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Recent Activities</h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Activity</th>
                                <th>User</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>24 Nov 2025</td>
                                <td>New student registered</td>
                                <td>John Doe</td>
                                <td><span class="badge badge-success">Completed</span></td>
                            </tr>
                            <tr>
                                <td>24 Nov 2025</td>
                                <td>Class schedule updated</td>
                                <td>Admin</td>
                                <td><span class="badge badge-success">Completed</span></td>
                            </tr>
                            <tr>
                                <td>23 Nov 2025</td>
                                <td>Teacher assigned to class</td>
                                <td>Admin</td>
                                <td><span class="badge badge-success">Completed</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    
    <!--quick actions-->
    <div class="col-lg-4 mb-4">
        <div class="card shadow h-100">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Quick Actions</h6>
            </div>
            <div class="card-body d-flex flex-column">
                <a href="#" class="btn btn-primary btn-block mb-2">
                    <i class="fas fa-user-plus"></i> Add Student
                </a>
                <a href="#" class="btn btn-success btn-block mb-2">
                    <i class="fas fa-chalkboard-teacher"></i> Add Teacher
                </a>
                <a href="#" class="btn btn-info btn-block mb-2">
                    <i class="fas fa-book"></i> Create Class
                </a>
                <a href="#" class="btn btn-warning btn-block mb-2">
                    <i class="fas fa-cog"></i> System Settings
                </a>
                <div class="mt-auto">
                    
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        // dummydata (temporary data) will change when database is implemented
        const dummyData = {
            students: {
                '7days': {
                    labels: ['Day 1', 'Day 2', 'Day 3', 'Day 4', 'Day 5', 'Day 6', 'Day 7'],
                    data: [1200, 1210, 1215, 1220, 1230, 1235, 1245]
                },
                '30days': {
                    labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4'],
                    data: [1180, 1200, 1215, 1245]
                },
                '3months': {
                    labels: ['Month 1', 'Month 2', 'Month 3'],
                    data: [1150, 1200, 1245]
                },
                '6months': {
                    labels: ['Month 1', 'Month 2', 'Month 3', 'Month 4', 'Month 5', 'Month 6'],
                    data: [1100, 1130, 1160, 1190, 1215, 1245]
                },
                '1year': {
                    labels: ['Q1', 'Q2', 'Q3', 'Q4'],
                    data: [1050, 1120, 1180, 1245]
                }
            },
            staff: {
                '7days': {
                    labels: ['Day 1', 'Day 2', 'Day 3', 'Day 4', 'Day 5', 'Day 6', 'Day 7'],
                    data: [42, 43, 43, 44, 44, 45, 45]
                },
                '30days': {
                    labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4'],
                    data: [40, 42, 43, 45]
                },
                '3months': {
                    labels: ['Month 1', 'Month 2', 'Month 3'],
                    data: [38, 41, 45]
                },
                '6months': {
                    labels: ['Month 1', 'Month 2', 'Month 3', 'Month 4', 'Month 5', 'Month 6'],
                    data: [35, 38, 40, 42, 43, 45]
                },
                '1year': {
                    labels: ['Q1', 'Q2', 'Q3', 'Q4'],
                    data: [32, 38, 42, 45]
                }
            },
            classes: {
                '7days': {
                    labels: ['Day 1', 'Day 2', 'Day 3', 'Day 4', 'Day 5', 'Day 6', 'Day 7'],
                    data: [120, 122, 123, 124, 125, 126, 128]
                },
                '30days': {
                    labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4'],
                    data: [115, 120, 124, 128]
                },
                '3months': {
                    labels: ['Month 1', 'Month 2', 'Month 3'],
                    data: [110, 119, 128]
                },
                '6months': {
                    labels: ['Month 1', 'Month 2', 'Month 3', 'Month 4', 'Month 5', 'Month 6'],
                    data: [105, 110, 115, 120, 124, 128]
                },
                '1year': {
                    labels: ['Q1', 'Q2', 'Q3', 'Q4'],
                    data: [100, 110, 119, 128]
                }
            }
        };

        //color mapping for different data
        const colorMap = {
            students: {
                border: 'rgba(78, 115, 223, 1)',
                background: 'rgba(78, 115, 223, 0.1)'
            },
            staff: {
                border: 'rgba(28, 200, 138, 1)',
                background: 'rgba(28, 200, 138, 0.1)'
            },
            classes: {
                border: 'rgba(54, 185, 204, 1)',
                background: 'rgba(54, 185, 204, 0.1)'
            }
        };

        //initialize chart
        let analyticsChart;
        const ctx = document.getElementById('analyticsChart').getContext('2d');

        function updateChart() {
            const dataType = document.getElementById('dataTypeSelect').value;
            const timeline = document.getElementById('timelineSelect').value;
            const chartData = dummyData[dataType][timeline];
            const colors = colorMap[dataType];

            if (analyticsChart) {
                analyticsChart.destroy();
            }

            analyticsChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: chartData.labels,
                    datasets: [{
                        label: dataType.charAt(0).toUpperCase() + dataType.slice(1),
                        data: chartData.data,
                        borderColor: colors.border,
                        backgroundColor: colors.background,
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4, //smooth curve for 
                        pointRadius: 5,
                        pointHoverRadius: 7,
                        pointBackgroundColor: colors.border,
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointHoverBackgroundColor: colors.border,
                        pointHoverBorderColor: '#fff',
                        pointHoverBorderWidth: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top',
                            labels: {
                                usePointStyle: true,
                                padding: 15,
                                font: {
                                    size: 12,
                                    weight: 'bold'
                                }
                            }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(0, 0, 0, 0.8)',
                            padding: 12,
                            titleFont: {
                                size: 14,
                                weight: 'bold'
                            },
                            bodyFont: {
                                size: 13
                            },
                            displayColors: true,
                            callbacks: {
                                label: function(context) {
                                    return context.dataset.label + ': ' + context.parsed.y.toLocaleString();
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: false,
                            grid: {
                                color: 'rgba(0, 0, 0, 0.05)',
                                drawBorder: false
                            },
                            ticks: {
                                font: {
                                    size: 11
                                },
                                callback: function(value) {
                                    return value.toLocaleString();
                                }
                            }
                        },
                        x: {
                            grid: {
                                display: false,
                                drawBorder: false
                            },
                            ticks: {
                                font: {
                                    size: 11
                                }
                            }
                        }
                    },
                    interaction: {
                        intersect: false,
                        mode: 'index'
                    },
                    animation: {
                        duration: 1000,
                        easing: 'easeInOutQuart'
                    }
                }
            });
        }

        
        document.getElementById('dataTypeSelect').addEventListener('change', updateChart);
        document.getElementById('timelineSelect').addEventListener('change', updateChart);

        document.addEventListener('DOMContentLoaded', function() {
            updateChart();
        });
    </script>
}
