@{
    ViewData["Title"] = "Teacher Dashboard";
}

@section Styles {
    <link href="~/css/teacher-dashboard.css" rel="stylesheet" />
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Teacher Dashboard</h1>
</div>

<div class="row">
    <div class="col-lg-8 mb-4">
        <div class="card shadow dashboard-card">
            <div class="card-body">
                <h4 class="font-weight-bold mb-4">My Classes</h4>
                
                <div class="class-item">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div>
                            <h6 class="font-weight-bold mb-1">BMCS2084 - Data Structure and Algorithms</h6>
                            <p class="text-muted small mb-0">Block K – K103 | Mon, Wed, Fri | 8:00 AM - 10:00 AM</p>
                        </div>
                        <span class="badge badge-primary">45 Students</span>
                    </div>
                    <div class="class-stats">
                        <span class="text-muted small">Attendance Rate: <strong class="text-success">88%</strong></span>
                        <span class="text-muted small ml-3">Upcoming: <strong>2 classes this week</strong></span>
                    </div>
                </div>
                
                <hr>
                
                <div class="class-item">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div>
                            <h6 class="font-weight-bold mb-1">BMCS2068 - Web Design and Development</h6>
                            <p class="text-muted small mb-0">DK Buildings – DKABA | Tue, Thu | 11:00 AM - 1:00 PM</p>
                        </div>
                        <span class="badge badge-primary">38 Students</span>
                    </div>
                    <div class="class-stats">
                        <span class="text-muted small">Attendance Rate: <strong class="text-success">92%</strong></span>
                        <span class="text-muted small ml-3">Upcoming: <strong>1 class this week</strong></span>
                    </div>
                </div>
                
                <div class="text-right mt-3">
                    <a href="#" class="small text-primary">View All Classes</a>
                </div>
            </div>
        </div>
    </div>
    
    <!--today schedule -->
    <div class="col-lg-4 mb-4">
        <div class="card shadow dashboard-card">
            <div class="card-body">
                <h4 class="font-weight-bold mb-3">Today's Schedule</h4>
                <p class="text-muted small mb-4">24 Nov 2025</p>
                
                <div class="schedule-item-teacher">
                    <div class="schedule-time">8:00 AM - 10:00 AM</div>
                    <h6 class="font-weight-bold mb-1">Data Structure and Algorithms</h6>
                    <p class="text-muted small mb-0">Block K – K103</p>
                </div>
                
                <div class="schedule-item-teacher">
                    <div class="schedule-time">11:00 AM - 1:00 PM</div>
                    <h6 class="font-weight-bold mb-1">Web Design and Development</h6>
                    <p class="text-muted small mb-0">DK Buildings – DKABA</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!--pending attendance-->
    <div class="col-lg-6 mb-4">
        <div class="card shadow dashboard-card">
            <div class="card-body">
                <h4 class="font-weight-bold mb-4">Pending Attendance</h4>
                
                <div class="pending-item">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="font-weight-bold mb-1">BMCS2084 - Data Structure</h6>
                            <p class="text-muted small mb-0">24 Nov 2025, 8:00 AM</p>
                        </div>
                        <button class="btn btn-sm btn-primary">Mark</button>
                    </div>
                </div>
                
                <div class="pending-item">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="font-weight-bold mb-1">BMCS2068 - Web Design</h6>
                            <p class="text-muted small mb-0">24 Nov 2025, 11:00 AM</p>
                        </div>
                        <button class="btn btn-sm btn-primary">Mark</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!--quick stats-->
    <div class="col-lg-6 mb-4">
        <div class="card shadow dashboard-card">
            <div class="card-body">
                <h4 class="font-weight-bold mb-4">Quick Stats</h4>
                
                <div class="stat-item">
                    <div class="d-flex justify-content-between">
                        <span>Total Classes</span>
                        <strong>8</strong>
                    </div>
                </div>
                <div class="stat-item">
                    <div class="d-flex justify-content-between">
                        <span>Total Students</span>
                        <strong>156</strong>
                    </div>
                </div>
                <div class="stat-item">
                    <div class="d-flex justify-content-between">
                        <span>Average Attendance</span>
                        <strong class="text-success">90%</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
